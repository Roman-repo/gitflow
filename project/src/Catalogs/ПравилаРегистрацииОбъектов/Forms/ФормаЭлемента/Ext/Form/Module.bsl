
#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗначениеКопирования = Параметры.ЗначениеКопирования;
	ДанныеФильтра = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Владелец, "ИмяПланаОбмена, Конфигурация");
	ИмяПланаОбмена = ДанныеФильтра.ИмяПланаОбмена;
	Конфигурация = ДанныеФильтра.Конфигурация;
	ПеречитатьТипОбъектаКонфигурации();
	
	ЗаполнитьСписокВыбораРеквизитаРежимаВыгрузки();
	ЗаполнитьТабличныеПоляОтбора(); 
	
	// Работа с тегами.
	ЕстьТеги = Ложь;
	ВыборкаТеги = Справочники.Теги.Выбрать(,Объект.Владелец);
	Если ВыборкаТеги.Следующий() Тогда
		ЕстьТеги = Истина;
		МассивПараметров = Новый Массив;
		ПараметрВыбора = Новый ПараметрВыбора("Отбор.Владелец", Объект.Владелец); 
		МассивПараметров.Добавить(ПараметрВыбора);
		Элементы.ТегиТег.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	КонецЕсли;
    Элементы.ГруппаТеги.Видимость = ЕстьТеги;
	
	СовместнаяРабота = Константы.СовместнаяРабота.Получить();
	Если СовместнаяРабота Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			// Для нового объекта ставим захват по умолчанию.
			Объект.Захвачен = Истина;
		ИначеЕсли Объект.Захвачен Тогда
			КонвертацияДанныхXDTOСервер.ПрочитатьСведенияОЗахватеОбъекта(Объект, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьДоступностьЭлементовФормы();
	КонвертацияДанныхXDTOКлиент.ИзменитьВидимостьЭлементовФормыПоСтатусуЗахвата(ЭтаФорма, Объект.Захвачен, СовместнаяРабота);
	КонвертацияДанныхXDTOКлиент.ОбновитьИндикациюСтраницОбработчиков(Элементы.СтраницыТекстОбработчиков, Объект);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ОтборПоСвойствамПланаОбмена = РеквизитФормыВЗначение("ДеревоОтборПоСвойствамПланаОбмена",Тип("ДеревоЗначений")); 
	ОтборПоСвойствамОбъекта = РеквизитФормыВЗначение("ДеревоОтборПоСвойствамОбъекта",Тип("ДеревоЗначений"));
	ПроверитьЗаполнениеДерева(ОтборПоСвойствамПланаОбмена, "ДеревоОтборПоСвойствамПланаОбмена", 0, Отказ);   
	ПроверитьЗаполнениеДерева(ОтборПоСвойствамОбъекта, "ДеревоОтборПоСвойствамОбъекта", 0, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ТекущийОбъект.ОтборПоСвойствамПланаОбмена = Новый ХранилищеЗначения(ОтборПоСвойствамПланаОбмена);
	ТекущийОбъект.ОтборПоСвойствамОбъекта = Новый ХранилищеЗначения(ОтборПоСвойствамОбъекта);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если СовместнаяРабота И ИмяСобытия = "ИзмененСтатусЗахвата" И Источник = Объект.Ссылка Тогда
		Прочитать();
		ОбработкаОповещенияНаСервере();
		КонвертацияДанныхXDTOКлиент.ИзменитьВидимостьЭлементовФормыПоСтатусуЗахвата(ЭтаФорма, Параметр);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ОбъектНастройкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормыВыбора = Новый Структура("ТекущаяСтрока, РежимРаботы", 
					Объект.ОбъектНастройки, "ОбъектКонфигурации");
	ПараметрыФормыВыбора.Вставить("ДляПРО", Истина);
	ПараметрыФормыВыбора.Вставить("ПланОбмена", НСтр("ru='ПланОбменаСсылка.'") + ИмяПланаОбмена);
	ПараметрыФормыВыбора.Вставить("Конфигурация", Конфигурация);


	ОткрытьФорму("ОбщаяФорма.ВыборОбъектаИлиСвойства",ПараметрыФормыВыбора,Элемент,,,,
			Новый ОписаниеОповещения("ВыбранОбъектКонфигурации", ЭтотОбъект),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура АлгоритмПриИзменении(Элемент)
	КонвертацияДанныхXDTOКлиент.ОбновитьИндикациюСтраницОбработчиков(Элементы.СтраницыТекстОбработчиков, Объект);
КонецПроцедуры

&НаКлиенте
Процедура АлгоритмПакетнаяОбработкаРегистрацииПриИзменении(Элемент)
	ОбновитьИндикациюСтраницыПакетныйОбработчик();
КонецПроцедуры
#КонецОбласти
