&НаКлиенте
Процедура СвойстваКонфигурацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОбработатьВыборИзСписка("СвойстваКонфигурации",,Истина);
КонецПроцедуры

&НаКлиенте
Процедура СвойстваКонфигурацииВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ОбработатьВыборИзСписка("СвойстваКонфигурации",,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВложенныеРеквизиты(Команда)
	ВложенныйРеквизитРодитель = ?(ЗначениеЗаполнено(ВложенныйРеквизитРодитель), СокрЛП(ВложенныйРеквизитРодитель) + ".", "") + СокрЛП(Элементы.СвойстваКонфигурации.ТекущиеДанные.Имя);
	ПоказатьВложенныеРеквизитыНаСервере(Элементы.СвойстваКонфигурации.ТекущиеДанные.Тип);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура ЗаполнитьОбъектыФормата(МассивКонвертаций)
	Если ПереданаВерсияФормата Тогда
		КонвертацияДанныхXDTOВызовСервера.ЗаполнитьСписокОбъектовФормата(ОбъектыФормата, Неопределено, Ложь, Ложь, ВерсияФормата);
	Иначе
		КонвертацияДанныхXDTOВызовСервера.ЗаполнитьСписокОбъектовФормата(ОбъектыФормата, МассивКонвертаций, ДляПКО, ДляПКПД);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущаяСтрока) Тогда
		СтрокиТаб = ОбъектыФормата.НайтиСтроки(Новый Структура("Наименование", ТекущаяСтрока));
		Если СтрокиТаб.Количество() > 0 Тогда
			ИдСтроки = СтрокиТаб[0].ПолучитьИдентификатор();
			Элементы.ОбъектыФормата.ТекущаяСтрока = ИдСтроки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваФормата(ТаблицаСвойствФормата)
	Если ТаблицаСвойствФормата <> Неопределено Тогда
		// Уже готова таблица свойств (вызов из формы редактирования ПКС).
		Для Каждого СтрТаб Из ТаблицаСвойствФормата Цикл
			СтрНов = СвойстваФормата.Добавить();
			ЗаполнитьЗначенияСвойств(СтрНов, СтрТаб);
		КонецЦикла;
	Иначе
		ФильтрСвойств = Новый Структура("ОбъектФормата, ЭтоГруппа", ОбъектФормата, Ложь);
		Если ПереданаВерсияФормата Тогда
			ФильтрСвойств.Вставить("ВерсияФормата", ВерсияФормата);
			КонвертацияДанныхXDTOВызовСервера.ЗаполнитьСписокСвойствФормата(СвойстваФормата, Неопределено, ФильтрСвойств);
		Иначе
			КонвертацияДанныхXDTOВызовСервера.ЗаполнитьСписокСвойствФормата(СвойстваФормата, МассивКонвертаций, ФильтрСвойств);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущаяСтрока) Тогда
		СтрокиТаб = СвойстваФормата.НайтиСтроки(Новый Структура("Имя", ТекущаяСтрока));
		Если СтрокиТаб.Количество() > 0 Тогда
			ИдСтроки = СтрокиТаб[0].ПолучитьИдентификатор();
			Элементы.СвойстваФормата.ТекущаяСтрока = ИдСтроки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваКонфигурации(ТаблицаСвойствКонфигурации, ОтборПоТипу)
	СоставнойТип = Ложь;
	ОтборПоТипам = Неопределено;
	Если СтрНайти(ОтборПоТипу, ",") > 0 Тогда
		СоставнойТип = Истина;
		ОтборПоТипам = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОтборПоТипу,",", Истина);
	КонецЕсли;
	Для Каждого СтрТаб Из ТаблицаСвойствКонфигурации Цикл
		Если ОтборПоТипу <> Неопределено Тогда
			ПропуститьСтроку = Ложь;
			Если ОтборПоТипу = "ПростойТип" Тогда
				ПропуститьСтроку = (СтрНайти(СтрТаб.Тип, "Дата") + СтрНайти(СтрТаб.Тип, "Булево")
					+ СтрНайти(СтрТаб.Тип, "Строка") + СтрНайти(СтрТаб.Тип, "Число") = 0);
			ИначеЕсли СтрНайти(ОтборПоТипу, "Дата") Тогда
				// для отбора Дата и время тип Дата тоже должен попадать.
				ПропуститьСтроку = (СтрНайти(СтрТаб.Тип, "Дата") = 0); 
			Иначе
				Если СоставнойТип Тогда
					ПропуститьСтроку = Истина;
					Для Каждого локОтбор Из ОтборПоТипам Цикл
						Если СтрНайти(СтрТаб.Тип, локОтбор) > 0 Тогда
							ПропуститьСтроку = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				Иначе
					ПропуститьСтроку = (СтрНайти(СтрТаб.Тип, ОтборПоТипу) = 0);
				КонецЕсли;
			КонецЕсли;
			Если ПропуститьСтроку Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		СтрНов = СвойстваКонфигурации.Добавить();
		ЗаполнитьЗначенияСвойств(СтрНов, СтрТаб);
	КонецЦикла;
	Если ЗначениеЗаполнено(ТекущаяСтрока) Тогда
		СтрокиТаб = СвойстваКонфигурации.НайтиСтроки(Новый Структура("Имя", ТекущаяСтрока));
		Если СтрокиТаб.Количество() > 0 Тогда
			ИдСтроки = СтрокиТаб[0].ПолучитьИдентификатор();
			Элементы.СвойстваКонфигурации.ТекущаяСтрока = ИдСтроки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыКонфигурации(Конфигурации, Конвертации, КонфигурацияИПланОбмена = Неопределено, ВедущаяКонфигурация = Неопределено)
	ОбластьПрименения = Новый Структура("ДляПКО, ДляПКПД, ДляПРО", ДляПКО, ДляПКПД, ДляПРО);
	ДанныеФильтра = Неопределено;
	Если Конфигурации = Неопределено И Конвертации <> Неопределено Тогда
		ДанныеФильтра = КонвертацияДанныхXDTOВызовСервера.ПолучитьКонфигурацииДляКонвертаций(Конвертации);
	ИначеЕсли ВедущаяКонфигурация <> Неопределено И ВедущаяКонфигурация <> Справочники.Релизы.ПустаяСсылка() Тогда
		ДанныеФильтра = ВедущаяКонфигурация;
	ИначеЕсли Конфигурации <> Неопределено Тогда
		ДанныеФильтра = Конфигурации;
	Иначе
		ДанныеФильтра = КонфигурацияИПланОбмена;
	КонецЕсли;
	КонвертацияДанныхXDTOВызовСервера.ЗаполнитьСписокОбъектовКонфигурации(ОбъектыКонфигурации, ДанныеФильтра, ОбластьПрименения);
	Если ЗначениеЗаполнено(ТекущаяСтрока) Тогда
		Если ТипЗнч(ТекущаяСтрока) = Тип("Строка") Тогда
			СтрокиТаб = ОбъектыКонфигурации.НайтиСтроки(Новый Структура("Наименование", ТекущаяСтрока));
		Иначе
			СтрокиТаб = ОбъектыКонфигурации.НайтиСтроки(Новый Структура("Ссылка", ТекущаяСтрока));
		КонецЕсли;	
		Если СтрокиТаб.Количество() > 0 Тогда
			ИдСтроки = СтрокиТаб[0].ПолучитьИдентификатор();
			Элементы.ОбъектыКонфигурации.ТекущаяСтрока = ИдСтроки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборИзСписка(ИмяТабПоля, ИмяКолонкиТабПоля = "Имя", ЕстьСсылка = Ложь)
	Если ДляПРО И РежимРаботы = "СвойствоКонфигурации" Тогда
		ТекущиеДанные = Элементы[ИмяТабПоля].ТекущиеДанные;
		ТекущееЗначение = Новый Структура("Имя, Тип, Ссылка", ТекущиеДанные.Имя, ТекущиеДанные.Тип, ТекущиеДанные.Ссылка);
	ИначеЕсли ЕстьСсылка Тогда
		ТекущееЗначение = Новый Структура();
		ТекущееЗначение.Вставить(ИмяКолонкиТабПоля, Элементы[ИмяТабПоля].ТекущиеДанные[ИмяКолонкиТабПоля]);
		ТекущееЗначение.Вставить("Ссылка", Элементы[ИмяТабПоля].ТекущиеДанные.Ссылка);
	Иначе
		ТекущееЗначение = Элементы[ИмяТабПоля].ТекущиеДанные[ИмяКолонкиТабПоля];
	КонецЕсли;
	Закрыть(ТекущееЗначение);
КонецПроцедуры

&НаСервере
Процедура ПоказатьВложенныеРеквизитыНаСервере(Знач ТипСтрокой)
	Если СтрНайти(ТипСтрокой, "Ссылка.") = 0 Тогда
		Возврат;
	КонецЕсли;
	ПозицияРазделителя = СтрНайти(ТипСтрокой, ",");
	Если ПозицияРазделителя > 0 Тогда
		ТипСтрокой = Лев(ТипСтрокой, ПозицияРазделителя-1);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Свойства.Наименование КАК Имя,
	|	ВЫРАЗИТЬ(Свойства.ТипыСтрокой КАК СТРОКА(1000)) КАК Тип,
	|	Свойства.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Свойства КАК Свойства
	|ГДЕ
	|	Свойства.Владелец.Наименование = &ОбъектКонфигурацииИмя
	|	И Свойства.Владелец.Владелец = &Конфигурация
	|	И Свойства.ПометкаУдаления = ЛОЖЬ
	|	И Свойства.Родитель = ЗНАЧЕНИЕ(Справочник.Свойства.ПустаяСсылка)
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
    Запрос.УстановитьПараметр("Конфигурация", ВедущаяКонфигурация);
	Запрос.УстановитьПараметр("ОбъектКонфигурацииИмя", ТипСтрокой);
	СвойстваКонфигурации.Очистить();
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		НовСтр = СвойстваКонфигурации.Добавить();
		НовСтр.Имя = ВложенныйРеквизитРодитель + "." + Выборка.Имя;
		ЗаполнитьЗначенияСвойств(НовСтр, Выборка,,"Имя");
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

