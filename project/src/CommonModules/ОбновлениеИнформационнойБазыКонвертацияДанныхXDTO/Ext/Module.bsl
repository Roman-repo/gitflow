КонецПроцедуры

// Заполнение нового реквизита ГруппаСтрокой в справочниках Алгоритмы,
//  Правила конвертации объектов, Правила конвертации предопределенных данных, Правила обработки данных
Процедура ЗаполнитьГруппуПравилСтрокой() Экспорт
	
	ТаблицаГруппыПравил = Новый ТаблицаЗначений;
	ТаблицаГруппыПравил.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.УдалитьГруппыПравил"));
	ТаблицаГруппыПравил.Колонки.Добавить("ПолноеНаименование", Новый ОписаниеТипов("Строка"));
	
	ЗаполнитьТаблицуГруппПравил(ТаблицаГруппыПравил, Справочники.УдалитьГруппыПравил.ПустаяСсылка());
	ПреобразованныеГруппы = Новый Соответствие;
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Алгоритмы.Ссылка КАК Ссылка,
	|	Алгоритмы.УдалитьГруппа КАК Группа
	|ИЗ
	|	Справочник.Алгоритмы КАК Алгоритмы
	|ГДЕ
	|	(ВЫРАЗИТЬ(Алгоритмы.ГруппаПравил КАК СТРОКА(100))) = """"
	|	И Алгоритмы.УдалитьГруппа <> ЗНАЧЕНИЕ(Справочник.УдалитьГруппыПравил.ПустаяСсылка)";
	ЗаполнитьГруппуПравилСтрокойИзЗапроса(ТаблицаГруппыПравил, Запрос, ПреобразованныеГруппы);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравилаКонвертацииОбъектов.Ссылка КАК Ссылка,
	|	ПравилаКонвертацииОбъектов.УдалитьГруппа КАК Группа
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов КАК ПравилаКонвертацииОбъектов
	|ГДЕ
	|	(ВЫРАЗИТЬ(ПравилаКонвертацииОбъектов.ГруппаПравил КАК СТРОКА(100))) = """"
	|	И ПравилаКонвертацииОбъектов.УдалитьГруппа <> ЗНАЧЕНИЕ(Справочник.УдалитьГруппыПравил.ПустаяСсылка)";
	ЗаполнитьГруппуПравилСтрокойИзЗапроса(ТаблицаГруппыПравил, Запрос, ПреобразованныеГруппы);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравилаКонвертацииПредопределенныхДанных.Ссылка КАК Ссылка,
	|	ПравилаКонвертацииПредопределенныхДанных.УдалитьГруппа КАК Группа
	|ИЗ
	|	Справочник.ПравилаКонвертацииПредопределенныхДанных КАК ПравилаКонвертацииПредопределенныхДанных
	|ГДЕ
	|	(ВЫРАЗИТЬ(ПравилаКонвертацииПредопределенныхДанных.ГруппаПравил КАК СТРОКА(100))) = """"
	|	И ПравилаКонвертацииПредопределенныхДанных.УдалитьГруппа <> ЗНАЧЕНИЕ(Справочник.УдалитьГруппыПравил.ПустаяСсылка)";
	ЗаполнитьГруппуПравилСтрокойИзЗапроса(ТаблицаГруппыПравил, Запрос, ПреобразованныеГруппы);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравилаОбработкиДанных.Ссылка КАК Ссылка,
	|	ПравилаОбработкиДанных.УдалитьГруппа КАК Группа
	|ИЗ
	|	Справочник.ПравилаОбработкиДанных КАК ПравилаОбработкиДанных
	|ГДЕ
	|	(ВЫРАЗИТЬ(ПравилаОбработкиДанных.ГруппаПравил КАК СТРОКА(100))) = """"
	|	И ПравилаОбработкиДанных.УдалитьГруппа <> ЗНАЧЕНИЕ(Справочник.УдалитьГруппыПравил.ПустаяСсылка)";
	ЗаполнитьГруппуПравилСтрокойИзЗапроса(ТаблицаГруппыПравил, Запрос, ПреобразованныеГруппы);
	
КонецПроцедуры

// Заполнение новых реквизитов ТипКонвертации и Статус в справочнике Конвертации.
Процедура ЗаполнитьТипИСтатусКонвертаций() Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Конвертации.Ссылка КАК Ссылка,
	|	ИСТИНА КАК ЭтоКонвертация,
	|	Конвертации.Статус КАК Статус
	|ИЗ
	|	Справочник.Конвертации КАК Конвертации
	|ГДЕ
	|	Конвертации.ТипКонвертации = ЗНАЧЕНИЕ(Перечисление.ТипыКонвертаций.ПустаяСсылка)
	|	ИЛИ Конвертации.Статус = ЗНАЧЕНИЕ(Перечисление.СостоянияПравил.ПустаяСсылка)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правило.Ссылка КАК Ссылка,
	|	ЛОЖЬ,
	|	NULL
	|ИЗ
	|	Справочник.ПравилаОбработкиДанных КАК Правило
	|ГДЕ Правило.ТипКонвертации = ЗНАЧЕНИЕ(Перечисление.ТипыКонвертаций.ПустаяСсылка)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правило.Ссылка КАК Ссылка,
	|	ЛОЖЬ,
	|	NULL
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов КАК Правило
	|ГДЕ Правило.ТипКонвертации = ЗНАЧЕНИЕ(Перечисление.ТипыКонвертаций.ПустаяСсылка)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правило.Ссылка КАК Ссылка,
	|	ЛОЖЬ,
	|	NULL
	|ИЗ
	|	Справочник.ПравилаКонвертацииПредопределенныхДанных КАК Правило
	|ГДЕ Правило.ТипКонвертации = ЗНАЧЕНИЕ(Перечисление.ТипыКонвертаций.ПустаяСсылка)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правило.Ссылка КАК Ссылка,
	|	ЛОЖЬ,
	|	NULL
	|ИЗ
	|	Справочник.Алгоритмы КАК Правило
	|ГДЕ Правило.ТипКонвертации = ЗНАЧЕНИЕ(Перечисление.ТипыКонвертаций.ПустаяСсылка)
	|";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		КонвертацияОбъект = Выборка.Ссылка.ПолучитьОбъект();
		КонвертацияОбъект.ТипКонвертации = Перечисления.ТипыКонвертаций.XDTO;
		Если Выборка.ЭтоКонвертация И НЕ ЗначениеЗаполнено(Выборка.Статус) Тогда
			КонвертацияОбъект.Статус = Перечисления.СостоянияПравил.ВРаботе;
			
			РегистрСтатусы = РегистрыСведений.СтатусыПравил.СоздатьМенеджерЗаписи();
			РегистрСтатусы.Период = ТекущаяДатаСеанса();
			РегистрСтатусы.Объект = Выборка.Ссылка;
			РегистрСтатусы.Статус = Перечисления.СостоянияПравил.ВРаботе;
			РегистрСтатусы.Записать();
		КонецЕсли;
		КонвертацияОбъект.Записать();
	КонецЦикла;
	
	Константы.ИспользоватьФорматXDTO.Установить(Истина);
	Константы.ИспользоватьФорматXML.Установить(Истина);

КонецПроцедуры

// Заполнение нового справочника Правила конвертации свойств.
Процедура ЗаполнитьСправочникПКС() Экспорт
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПКС.Ссылка КАК Владелец,
	|	ПКС.ГруппаСвойствКонфигурации,
	|	ПКС.ГруппаСвойствФормата,
	|	ПКС.ИспользуетсяАлгоритмКонвертации,
	|	ПКС.Комментарий,
	|	ПКС.ПолноеИмяСвойстваКонфигурации,
	|	ПКС.ПолноеИмяСвойстваФормата,
	|	ПКС.ПравилоКонвертацииСвойства,
	|	ПКС.СвойствоКонфигурации КАК СвойствоКонфигурации,
	|	ПКС.СвойствоФормата,
	|	ПКС.ТипСвойстваКонфигурации,
	|	ПКС.ТипСвойстваФормата,
	|	ПКС.Ссылка.ИспользоватьДляОтправки КАК ИспользоватьДляОтправки,
	|	ПКС.Ссылка.ИспользоватьДляПолучения КАК ИспользоватьДляПолучения
	|ИЗ
	|	Справочник.ПравилаКонвертацииОбъектов.УдалитьПравилаКонвертацииСвойств КАК ПКС
	|ГДЕ ПКС.Отключить = ЛОЖЬ
	|ИТОГИ ПО ПКС.Ссылка, ПКС.ГруппаСвойствКонфигурации, ПКС.ГруппаСвойствФормата";
	ВыборкаПКО = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПКО.Следующий() Цикл
		ВыборкаГСК = ВыборкаПКО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаГСК.Следующий() Цикл
			ВыборкаГСФ = ВыборкаГСК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаГСФ.Следующий() Цикл
				ТекущийРодитель = НайтиСоздатьГруппуСвойств(ВыборкаГСФ);
				Выборка = ВыборкаГСФ.Выбрать();
				ПКГСАлгоритм = Ложь;
				Пока Выборка.Следующий() Цикл
					СтруктураПоиска = Новый Структура("Владелец, СвойствоКонфигурации, СвойствоФормата",
						Выборка.Владелец, Выборка.СвойствоКонфигурации, 
						Выборка.СвойствоФормата);
					СтруктураПоиска.Вставить("ЭтоГруппа", Ложь);
					СтруктураПоиска.Вставить("Родитель", ТекущийРодитель);
					РезультатПоиска = НайтиПКС(СтруктураПоиска);
					Если РезультатПоиска <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					НовоеСвойство = Справочники.ПравилаКонвертацииСвойств.СоздатьЭлемент();
					НовоеСвойство.Владелец = Выборка.Владелец;
					НовоеСвойство.Родитель = ТекущийРодитель;
					ЗаполнитьЗначенияСвойств(НовоеСвойство, Выборка,,"СвойствоКонфигурации");  
					НовоеСвойство.СвойствоКонфигурацииСтрокой = Выборка.СвойствоКонфигурации;
					НовоеСвойство.Наименование = СформироватьНаименование(Выборка.СвойствоКонфигурации, 
							Выборка.СвойствоФормата, Выборка.ИспользоватьДляОтправки, 
							Выборка.ИспользоватьДляПолучения);

					НовоеСвойство.Записать();
					Если НЕ ПКГСАлгоритм И Выборка.ИспользуетсяАлгоритмКонвертации Тогда
						ПКГСАлгоритм = Истина;
					КонецЕсли;
				КонецЦикла;
				Если ЗначениеЗаполнено(ТекущийРодитель) И ПКГСАлгоритм Тогда
					ТекущийПКГСАлгоритм = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущийРодитель, "ИспользуетсяАлгоритмКонвертации");
					Если НЕ ТекущийПКГСАлгоритм Тогда
						РодительОбъект = ТекущийРодитель.ПолучитьОбъект();
						РодительОбъект.ИспользуетсяАлгоритмКонвертации = Истина;
						РодительОбъект.Записать();
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		// Обработаны все ПКС для ПКО. Очистка ТЧ ПКС в ПКО.
		ПКООбъект = ВыборкаПКО.Владелец.ПолучитьОбъект();
		ПКООбъект.УдалитьПравилаКонвертацииСвойств.Очистить();
		ПКООбъект.Записать();
	КонецЦикла;
КонецПроцедуры

// Заполнение родителя для существующих элементов справочника ВерсииФормата.
Процедура ЗаполнитьРодителяВВерсияхФормата() Экспорт
	// Заполнение пространства имен в предопределенной группе.
	ПространствоИмен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Справочники.ВерсииФормата.EnterpriseData, "ПространствоИмен");
	Если НЕ ЗначениеЗаполнено(ПространствоИмен) Тогда
		ВерсияОбъект = Справочники.ВерсииФормата.EnterpriseData.ПолучитьОбъект();
		ВерсияОбъект.ПространствоИмен = "http://v8.1c.ru/edi/edi_stnd/EnterpriseData";
		ВерсияОбъект.Записать();
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Ссылка
	|ИЗ Справочник.ВерсииФормата
	|ГДЕ Родитель = &Родитель И ЭтоГруппа = ЛОЖЬ";
	Запрос.УстановитьПараметр("Родитель", Справочники.ВерсииФормата.ПустаяСсылка());
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ВерсияОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ВерсияОбъект.Родитель = Справочники.ВерсииФормата.EnterpriseData;
		ВерсияОбъект.Записать();
	КонецЦикла; 
КонецПроцедуры

// Заполнение конфигурации-владельца для существующих элементов справочника Релизы.
Процедура ЗаполнитьКонфигурациюВРелизах() Экспорт
