КонецПроцедуры

// Заполнение значений новых ссылочных реквизитов ОбъектКонфигурации, ОбъектКонфигурацииКорреспондент... 
//   на основании подлежащих удалению строковых реквизитов УдалитьОбъектКонфигурации, УдалитьОбъектКонфигурацииКорреспондент...
Процедура ЗаполнитьОбъектыВПравилах() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "
	// Правила конвертации объектов.
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Правила.УдалитьОбъектКонфигурации КАК Строка(150)) КАК ОбъектКонфигурацииСтрокой,
	|	""ОбъектКонфигурации"" КАК ИмяРеквизита
	|ПОМЕСТИТЬ КОбработке
	|ИЗ Справочник.ПравилаКонвертацииОбъектов КАК Правила
	|ГДЕ Правила.ОбъектКонфигурации = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка) 
	|	И Правила.УдалитьОбъектКонфигурации <> """"
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Правила.УдалитьОбъектКонфигурацииКорреспондент КАК Строка(150)) КАК ОбъектКонфигурацииСтрокой,
	|	""ОбъектКонфигурацииКорреспондент"" КАК ИмяРеквизита
	|ИЗ Справочник.ПравилаКонвертацииОбъектов КАК Правила
	|ГДЕ Правила.ОбъектКонфигурацииКорреспондент = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка) 
	|	И Правила.УдалитьОбъектКонфигурацииКорреспондент <> """"
	|ОБЪЕДИНИТЬ ВСЕ
	// Правила конвертации предопределенных данных.
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Правила.УдалитьОбъектКонфигурации КАК Строка(150)) КАК ОбъектКонфигурацииСтрокой,
	|	""ОбъектКонфигурации"" КАК ИмяРеквизита
	|ИЗ Справочник.ПравилаКонвертацииПредопределенныхДанных КАК Правила
	|ГДЕ Правила.ОбъектКонфигурации = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка) 
	|	И Правила.УдалитьОбъектКонфигурации <> """"
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Правила.УдалитьОбъектКонфигурацииКорреспондент КАК Строка(150)) КАК ОбъектКонфигурацииСтрокой,
	|	""ОбъектКонфигурацииКорреспондент"" КАК ИмяРеквизита
	|ИЗ Справочник.ПравилаКонвертацииПредопределенныхДанных КАК Правила
	|ГДЕ Правила.ОбъектКонфигурацииКорреспондент = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка) 
	|	И Правила.УдалитьОбъектКонфигурацииКорреспондент <> """"
	|ОБЪЕДИНИТЬ ВСЕ
	// Правила обработки данных
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Правила.ОбъектВыборки КАК Строка(150)) КАК ОбъектКонфигурацииСтрокой,
	|	""ОбъектВыборки"" КАК ИмяРеквизита
	|ИЗ Справочник.ПравилаОбработкиДанных КАК Правила
	|ГДЕ Правила.ИспользоватьДляОтправки 
	|	И НЕ Правила.ОбъектВыборки ССЫЛКА Справочник.Объекты
	|;
	|ВЫБРАТЬ
	|	КОбработке.Ссылка,
	|	КОбработке.ОбъектКонфигурацииСтрокой,
	|	КОбработке.ИмяРеквизита,
	|	Состав.Владелец.Конфигурация КАК Конфигурация 
	|ПОМЕСТИТЬ КЗаполнению
	|ИЗ КОбработке КАК КОбработке
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.СоставыКонвертаций КАК Состав
	|ПО КОбработке.Ссылка = Состав.ЭлементКонвертации
	|	И Состав.Отключить = ЛОЖЬ
	|ОБЪЕДИНИТЬ ВСЕ
	// Правила регистрации объектов
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	ВЫРАЗИТЬ(Правила.УдалитьОбъектНастройки КАК Строка(150)) КАК ОбъектКонфигурацииСтрокой,
	|	""ОбъектНастройки"" КАК ИмяРеквизита,
	|	Правила.Владелец.Конфигурация КАК Конфигурация
	|ИЗ Справочник.ПравилаРегистрацииОбъектов КАК Правила
	|ГДЕ Правила.ОбъектНастройки = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
	|;  
	|ВЫБРАТЬ
	|	КЗаполнению.Ссылка,
	|	КЗаполнению.ОбъектКонфигурацииСтрокой,
	|	КЗаполнению.ИмяРеквизита,
	|	КЗаполнению.Конфигурация,
	|	Максимум(Объекты.Ссылка) КАК ОбъектКонфигурации
	|ИЗ КЗаполнению КАК КЗаполнению
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.Объекты КАК Объекты
	|ПО Объекты.Владелец = КЗаполнению.Конфигурация
	|	И Объекты.Наименование = КЗаполнению.ОбъектКонфигурацииСтрокой
	|	И Объекты.ПометкаУдаления = ЛОЖЬ
	|СГРУППИРОВАТЬ ПО
	|	КЗаполнению.Ссылка,
	|	КЗаполнению.ОбъектКонфигурацииСтрокой,
	|	КЗаполнению.ИмяРеквизита,
	|	КЗаполнению.Конфигурация";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПравилоОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПравилоОбъект[Выборка.ИмяРеквизита] = Выборка.ОбъектКонфигурации;
		ПравилоОбъект.ОбменДанными.Загрузка = Истина;
		ПравилоОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

// Заполнение значений новых ссылочных реквизитов СвойствоКонфигурации, СвойствоКонфигурацииКорреспондента в правилах конвертации свойств.
Процедура ЗаполнитьСвойстваВПравилах() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	Правила.Ссылка.ЭтоГруппа КАК ЭтоГруппа,
	|	Правила.Родитель КАК Родитель,
	|	ВЫРАЗИТЬ(Правила.СвойствоКонфигурацииСтрокой КАК Строка(150)) КАК СвойствоКонфигурацииСтрокой,
	|	ВЫРАЗИТЬ(Правила.Родитель.СвойствоКонфигурацииСтрокой КАК Строка(150)) КАК СвойствоРодительСтрокой,
	|	Правила.Владелец.ОбъектКонфигурации КАК Объект,
	|	""СвойствоКонфигурации"" КАК ИмяРеквизита
	|ПОМЕСТИТЬ КОбработке
	|ИЗ Справочник.ПравилаКонвертацииСвойств КАК Правила
	|ГДЕ Правила.СвойствоКонфигурации = ЗНАЧЕНИЕ(Справочник.Свойства.ПустаяСсылка) 
	|	И Правила.СвойствоКонфигурацииСтрокой <> """"
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правила.Ссылка,
	|	Правила.Ссылка.ЭтоГруппа,
	|	Правила.Родитель,
	|	ВЫРАЗИТЬ(Правила.УдалитьСвойствоКонфигурацииКорреспондента КАК Строка(150)),
	|	ВЫРАЗИТЬ(Правила.Родитель.УдалитьСвойствоКонфигурацииКорреспондента КАК Строка(150)),
	|	Правила.Владелец.ОбъектКонфигурацииКорреспондент,
	|	""СвойствоКонфигурацииКорреспондента""
	|ИЗ Справочник.ПравилаКонвертацииСвойств КАК Правила
	|ГДЕ Правила.СвойствоКонфигурацииКорреспондента = ЗНАЧЕНИЕ(Справочник.Свойства.ПустаяСсылка) 
	|	И Правила.УдалитьСвойствоКонфигурацииКорреспондента <> """"
	|;  
	|ВЫБРАТЬ
	|	КОбработке.Ссылка,
	|	КОбработке.СвойствоКонфигурацииСтрокой,
	|	КОбработке.ИмяРеквизита,
	|	КОбработке.Объект,
	|	Максимум(Свойства.Ссылка) КАК СвойствоКонфигурации
	|ИЗ КОбработке КАК КОбработке
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	Справочник.Свойства КАК Свойства
	|ПО Свойства.Владелец = КОбработке.Объект
	|	И Свойства.Наименование = КОбработке.СвойствоКонфигурацииСтрокой
	|	И Свойства.ПометкаУдаления = ЛОЖЬ
	|	И Свойства.ЭтоГруппа = КОбработке.ЭтоГруппа
	|	И (КОбработке.Родитель = ЗНАЧЕНИЕ(Справочник.ПравилаКонвертацииСвойств.ПустаяСсылка)
	|		ИЛИ КОбработке.СвойствоРодительСтрокой = Свойства.Родитель.Наименование)
	|СГРУППИРОВАТЬ ПО
	|	КОбработке.Ссылка,
	|	КОбработке.СвойствоКонфигурацииСтрокой,
	|	КОбработке.ИмяРеквизита,
	|	КОбработке.Объект";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПравилоОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПравилоОбъект[Выборка.ИмяРеквизита] = Выборка.СвойствоКонфигурации;
		ПравилоОбъект.ОбменДанными.Загрузка = Истина;
		ПравилоОбъект.Записать();
	КонецЦикла;

КонецПроцедуры

// Распределение конвертаций с пустым родителем по предопределенным папкам
Процедура РаспределитьКонвертацииПоПапкам() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Ссылка,
	|	ТипКонвертации
	|ИЗ Справочник.Конвертации
	|ГДЕ Родитель = ЗНАЧЕНИЕ(Справочник.Конвертации.ПустаяСсылка) И ЭтоГруппа = ЛОЖЬ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Конвертация = Выборка.Ссылка.ПолучитьОбъект();
		Конвертация.Родитель = ?(Выборка.ТипКонвертации = Перечисления.ТипыКонвертаций.XDTO, Справочники.Конвертации.ФорматXDTO, Справочники.Конвертации.ФорматXML);
		Конвертация.Записать();
	КонецЦикла;
КонецПроцедуры

// Отложенный обработчик обновления. Заполняет  признак Проверено у существующих ПКС в значение Истина. 
// Параметры:
//  ПараметрыОбработчика - Структура - управляющая коллекция, см. документацию к подсистеме ОбновлениеИнформационнойБазы БСП.
//         Ключи:
//         * ОбработкаЗавершена - Булево - для того чтобы обработчик был вызван повторно для обработки следующей порции данных,
//                                         следует записать в него значение Ложь;
//         В структуру можно добавить произвольное количество свойств произвольных типов,
//         значения которых будут автоматически запоминаться между вызовами процедуры - обработчика отложенного обновления.
//
Процедура ЗаполнитьПризнакПровереноУПКС(ПараметрыОбработчика) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1000
	|	ПравилаКонвертацииСвойств.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаКонвертацииСвойств КАК ПравилаКонвертацииСвойств
	|ГДЕ
	|	ПравилаКонвертацииСвойств.Проверено = ЛОЖЬ
	|	И ПравилаКонвертацииСвойств.ЭтоГруппа = ЛОЖЬ"; 
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПравилоКС = Выборка.Ссылка.ПолучитьОбъект();
		ПравилоКС.Проверено = Истина;
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПравилоКС, Ложь, Ложь);
	КонецЦикла;
КонецПроцедуры

// Проверяет, все ли ПКС были обработаны процедурой ЗаполнитьПризнакПровереноУПКС()
//
// Параметры:
//   Параметры - Структура - см. документацию к БСП.
//
// Возвращаемое значение:
//   Булево - Истина, то можно редактировать и записывать данные,
//            Ложь - данные недоступны, пока не будут обработаны процедурой обновления.
//
Функция ПризнакПровереноВПКСЗаполнен(Параметры) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПравилаКонвертацииСвойств.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаКонвертацииСвойств КАК ПравилаКонвертацииСвойств
	|ГДЕ
	|	ПравилаКонвертацииСвойств.Проверено = ЛОЖЬ
	|	И ПравилаКонвертацииСвойств.ЭтоГруппа = ЛОЖЬ";
	Возврат Запрос.Выполнить().Пустой();
КонецФункции

// Отложенный обработчик обновления. Переносит теги правил регистрации из строкового реквизита в табличную часть. 
// Параметры:
//  ПараметрыОбработчика - Структура - управляющая коллекция, см. документацию к подсистеме ОбновлениеИнформационнойБазы БСП.
//         Ключи:
//         * ОбработкаЗавершена - Булево - для того чтобы обработчик был вызван повторно для обработки следующей порции данных,
//                                         следует записать в него значение Ложь;
//         В структуру можно добавить произвольное количество свойств произвольных типов,
//         значения которых будут автоматически запоминаться между вызовами процедуры - обработчика отложенного обновления.
//
Процедура ЗаполнитьТегиПравилРегистрации(ПараметрыОбработчика) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1000
	|	ПравилаРегистрацииОбъектов.Ссылка КАК Ссылка, 
	|	ПравилаРегистрацииОбъектов.УдалитьТегВырезки КАК ТегСтрокой,
	|	ПравилаРегистрацииОбъектов.Владелец КАК Регистрация
	|ИЗ
	|	Справочник.ПравилаРегистрацииОбъектов КАК ПравилаРегистрацииОбъектов
	|ГДЕ
	|	ВЫРАЗИТЬ(ПравилаРегистрацииОбъектов.УдалитьТегВырезки КАК Строка(50)) <> """"
	|	И ПравилаРегистрацииОбъектов.ЭтоГруппа = ЛОЖЬ";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;  
	ПараметрыОбработчика.ОбработкаЗавершена = Ложь;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПРООбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПРООбъект.Теги.Очистить();
		ТекущийТегМассив = СтрРазделить(СокрЛП(Выборка.ТегСтрокой), Символы.ПС);
		Для Каждого ТекТег Из ТекущийТегМассив Цикл
			ТекТегСсылка = НайтиСоздатьТег(Выборка.Регистрация, СокрЛП(ТекТег));
			Если ТекТегСсылка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			СтрТег = ПРООбъект.Теги.Добавить();
			СтрТег.Тег = ТекТегСсылка;
		КонецЦикла;
		ПРООбъект.УдалитьТегВырезки = "";
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПРООбъект, Ложь, Ложь);
	КонецЦикла;
КонецПроцедуры

// Проверяет, все ли ПравилаРегистрации были обработаны процедурой ЗаполнитьТегиПравилРегистрации()
//
// Параметры:
//   Параметры - Структура - см. документацию к БСП.
//
// Возвращаемое значение:
//   Булево - Истина, то можно редактировать и записывать данные,
//            Ложь - данные недоступны, пока не будут обработаны процедурой обновления.
//
Функция ТегиПравилРегистрацииЗаполнены(Параметры) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПравилаРегистрацииОбъектов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаРегистрацииОбъектов КАК ПравилаРегистрацииОбъектов
	|ГДЕ
	|	ВЫРАЗИТЬ(ПравилаРегистрацииОбъектов.УдалитьТегВырезки КАК Строка(50)) <> """"
	|	И ПравилаРегистрацииОбъектов.ЭтоГруппа = ЛОЖЬ";
	Возврат Запрос.Выполнить().Пустой();
КонецФункции 

// Отложенный обработчик обновления. Переносит описания из справочников ОбъектыФормата и СвойстваФормата в соответствующие элементы справочника ЭлементыОписания. 
// Параметры:
//  ПараметрыОбработчика - Структура - управляющая коллекция, см. документацию к подсистеме ОбновлениеИнформационнойБазы БСП.
//         Ключи:
//         * ОбработкаЗавершена - Булево - для того чтобы обработчик был вызван повторно для обработки следующей порции данных,
//                                         следует записать в него значение Ложь;
//         В структуру можно добавить произвольное количество свойств произвольных типов,
//         значения которых будут автоматически запоминаться между вызовами процедуры - обработчика отложенного обновления.
//
Процедура ПеренестиОписанияОбъектовИСвойствФормата(ПараметрыОбработчика) Экспорт
	Если Константы.ИспользоватьПроектированиеФормата.Получить() = Ложь Тогда
		Возврат;
	КонецЕсли;
	ЗапросОписания = Новый Запрос;
	ЗапросОписания.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка КАК Описание,
	|	НомерВерсииФормата КАК Номер
	|ИЗ Справочник.Описания
	|ГДЕ ПометкаУдаления = Ложь";
	ВыборкаНомераВерсий = ЗапросОписания.Выполнить().Выбрать();
	Пока ВыборкаНомераВерсий.Следующий() Цикл
		ВерсияФормата = Справочники.ВерсииФормата.НайтиПоНаименованию(ВыборкаНомераВерсий.Номер);
		Если НЕ ЗначениеЗаполнено(ВерсияФормата) Тогда
			Продолжить;
		КонецЕсли;
		// Уровень заголовка должен быть 1 для элементов которые не заголовки.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Ссылка
		|ИЗ Справочник.ЭлементыОписания КАК ЭлементОписания
		|ГДЕ ЭлементОписания.ТипЭлемента <> ЗНАЧЕНИЕ(Перечисление.ТипыЭлементовОписания.Заголовок)
		|	И ЭлементОписания.УровеньЗаголовка <> 1";
		Запрос.УстановитьПараметр("Описание", ВыборкаНомераВерсий.Описание);
		ВыборкаЭлементОписания = Запрос.Выполнить().Выбрать();
		Пока ВыборкаЭлементОписания.Следующий() Цикл
			ТекЭлементОписания = ВыборкаЭлементОписания.Ссылка.ПолучитьОбъект();
			ТекЭлементОписания.УровеньЗаголовка = 1;
			ТекЭлементОписания.ОбменДанными.Загрузка = Истина;
			ТекЭлементОписания.Записать();
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1000
		|	ЭлементОписания.Ссылка КАК ЭлементОписания,
		|	ОбъектыФормата.УдалитьОписание КАК Описание,
		|	ОбъектыФормата.Ссылка КАК ОбъектФормата
		|ИЗ Справочник.ЭлементыОписания КАК ЭлементОписания
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыФормата КАК ОбъектыФормата
		|	ПО ЭлементОписания.ТипЭлемента = ЗНАЧЕНИЕ(Перечисление.ТипыЭлементовОписания.ОписаниеОбъектаФормата)
		|	И ОбъектыФормата.Владелец = &ВерсияФормата
		|	И ОбъектыФормата.Наименование = ЭлементОписания.ОбъектФормата
		|	И ОбъектыФормата.ПереносОписанийВыполнен = ЛОЖЬ
		|ГДЕ ЭлементОписания.Владелец = &Описание";
		Запрос.УстановитьПараметр("Описание", ВыборкаНомераВерсий.Описание);
		Запрос.УстановитьПараметр("ВерсияФормата", ВерсияФормата);
		ВыборкаЭлементОписания = Запрос.Выполнить().Выбрать();
		Пока ВыборкаЭлементОписания.Следующий() Цикл
			ТекЭлементОписания = ВыборкаЭлементОписания.ЭлементОписания.ПолучитьОбъект();
			ТекЭлементОписания.ТекстПростогоОписания = Новый ХранилищеЗначения(ВыборкаЭлементОписания.Описание.Получить());
			// Описания для свойств.
			ЗапросСвойства = Новый Запрос;
			ЗапросСвойства.Текст = "ВЫБРАТЬ
			|	Ссылка КАК Свойство,
			|	Наименование,
			|	Родитель.Наименование КАК НаименованиеТЧ,
			|	Родитель.ОбъектХранительСвойств КАК РодительОбъектХранительСвойств,
			|	ЭтоГруппа,
			|	УдалитьОписание КАК Описание
			|ИЗ Справочник.СвойстваФормата
			|ГДЕ Владелец = &ОбъектФормата И ОбъектХранительСвойств = """"";
			ЗапросСвойства.УстановитьПараметр("ОбъектФормата", ВыборкаЭлементОписания.ОбъектФормата);
			ВыборкаСвойства = ЗапросСвойства.Выполнить().Выбрать();
			ТекЭлементОписания.ОписанияРеквизитовШапки.Очистить();
			ТекЭлементОписания.ОписанияРеквизитовТабличнойЧасти.Очистить();
			Пока ВыборкаСвойства.Следующий() Цикл
				Если ЗначениеЗаполнено(ВыборкаСвойства.РодительОбъектХранительСвойств) Тогда
					Продолжить;
				КонецЕсли;
				ДанныеОписания = ВыборкаСвойства.Описание.Получить();
				Если ДанныеОписания = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ТекстОписания = ДанныеОписания.ПолучитьТекст();
				Если ТекстОписания = "" Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(ВыборкаСвойства.НаименованиеТЧ) Тогда
					НовОписаниеСвойства = ТекЭлементОписания.ОписанияРеквизитовТабличнойЧасти.Добавить();
				Иначе
					НовОписаниеСвойства = ТекЭлементОписания.ОписанияРеквизитовШапки.Добавить();
				КонецЕсли; 
				ЗаполнитьЗначенияСвойств(НовОписаниеСвойства, ВыборкаСвойства); 
				НовОписаниеСвойства.ТекстОписания = ТекстОписания;
				НовОписаниеСвойства.СобственноеОписание = Истина;
			КонецЦикла;
			ТекЭлементОписания.ОбменДанными.Загрузка = Истина;
			ТекЭлементОписания.Записать();
			
			// Фиксируем факт обработки объекта формата.
			ТекОбъектФормата = ВыборкаЭлементОписания.ОбъектФормата.ПолучитьОбъект();
			ТекОбъектФормата.ПереносОписанийВыполнен = Истина;
			ТекОбъектФормата.ОбменДанными.Загрузка = Истина;
			ТекОбъектФормата.Записать();
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Проверяет, все ли ОбъектыФормата были обработаны процедурой ПеренестиОписанияОбъектовИСвойствФормата()
//
// Параметры:
//   Параметры - Структура - см. документацию к БСП.
//
// Возвращаемое значение:
//   Булево - Истина, то можно редактировать и записывать данные,
//            Ложь - данные недоступны, пока не будут обработаны процедурой обновления.
//
Функция ПереносОписанийЗакончен(Параметры) Экспорт
	Если Константы.ИспользоватьПроектированиеФормата.Получить() = Ложь Тогда
		Возврат Истина;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НомерВерсииФормата КАК Номер
	|ИЗ Справочник.Описания
	|ГДЕ ПометкаУдаления = Ложь";
	МасНомераВерсий = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номер");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЭлементОписания.Ссылка КАК ЭлементОписания,
	|	ОбъектыФормата.Ссылка КАК ОбъектФормата
	|ИЗ Справочник.ЭлементыОписания КАК ЭлементОписания
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОбъектыФормата КАК ОбъектыФормата
	|	ПО ЭлементОписания.ТипЭлемента = ЗНАЧЕНИЕ(Перечисление.ТипыЭлементовОписания.ОписаниеОбъектаФормата)
	|	И ОбъектыФормата.Владелец.Наименование = ЭлементОписания.Владелец.НомерВерсииФормата
	|	И ОбъектыФормата.Наименование = ЭлементОписания.ОбъектФормата
	|ГДЕ ЭлементОписания.Владелец.НомерВерсииФормата В (&НомераВерсийСОписаниями) И ОбъектыФормата.ПереносОписанийВыполнен = ЛОЖЬ
	|";
	Запрос.УстановитьПараметр("НомераВерсийСОписаниями", МасНомераВерсий);
	Возврат Запрос.Выполнить().Пустой();
КонецФункции

#КонецОбласти
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура ЗаполнитьТаблицуГруппПравил(ТаблицаГруппыПравил, Родитель)
	ПреобразованныеГруппы = Новый Соответствие();

	НаименованиеРодителя = "";
	СтрокаРодитель = ТаблицаГруппыПравил.Найти(Родитель, "Ссылка");
	Если Не СтрокаРодитель = Неопределено Тогда		
		НаименованиеРодителя = ЗаменитьНеправильныеСимволыВСтроке(СтрокаРодитель.ПолноеНаименование, ПреобразованныеГруппы);
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ГруппыПравил.Ссылка КАК Ссылка,
	|	ГруппыПравил.Наименование КАК Наименование
	|ИЗ
	|	Справочник.УдалитьГруппыПравил КАК ГруппыПравил
	|ГДЕ
	|	ГруппыПравил.Родитель = &Родитель");
	Запрос.УстановитьПараметр("Родитель", Родитель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаГруппыПравил = ТаблицаГруппыПравил.Добавить();
		СтрокаГруппыПравил.Ссылка = Выборка.Ссылка;
		Если ПустаяСтрока(НаименованиеРодителя) Тогда
			СтрокаГруппыПравил.ПолноеНаименование = Выборка.Наименование;
		Иначе
			СтрокаГруппыПравил.ПолноеНаименование = НаименованиеРодителя + "\" + ЗаменитьНеправильныеСимволыВСтроке(Выборка.Наименование, ПреобразованныеГруппы);
		КонецЕсли;
		
		ЗаполнитьТаблицуГруппПравил(ТаблицаГруппыПравил, СтрокаГруппыПравил.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьГруппуПравилСтрокойИзЗапроса(ТаблицаГруппыПравил, Запрос, ПреобразованныеГруппы)
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаГруппаПравил = ТаблицаГруппыПравил.Найти(Выборка.Группа, "Ссылка");
		Если СтрокаГруппаПравил = Неопределено Тогда
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не найдена группа правил ""%1"" в таблице описаний групп правил.'"),
				Выборка.УдалитьГруппа);
		КонецЕсли;
		
		ЭлементПравилОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ЭлементПравилОбъект.ГруппаПравил = ЗаменитьНеправильныеСимволыВСтроке(СтрокаГруппаПравил.ПолноеНаименование, ПреобразованныеГруппы);
		ЭлементПравилОбъект.ОбменДанными.Загрузка = Истина;
		ЭлементПравилОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Функция ЗаменитьНеправильныеСимволыВСтроке(Знач ИмяГруппы, ПреобразованныеГруппы) 
	ИмяГруппы = СокрЛП(ИмяГруппы);
	НовоеИмяГруппы = ПреобразованныеГруппы.Получить(ИмяГруппы);
	Если НовоеИмяГруппы <> Неопределено Тогда
		Возврат НовоеИмяГруппы;
	КонецЕсли;
	НовоеИмяГруппы = "";
	Для Сч = 1 По СтрДлина(ИмяГруппы) Цикл
		ТекСимвол = Сред(ИмяГруппы, Сч, 1);
		Если ТекСимвол = "_" Или ТекСимвол = "\" Или ТекСимвол = " "
			Или СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ТекСимвол)
			Или СтроковыеФункцииКлиентСервер.ТолькоКириллицаВСтроке(ТекСимвол)
			Или СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(ТекСимвол) Тогда
			НовоеИмяГруппы = НовоеИмяГруппы + ТекСимвол;
		Иначе
			НовоеИмяГруппы = НовоеИмяГруппы + " ";
		КонецЕсли;
	КонецЦикла;
	
	НовоеИмяГруппы = СтрЗаменить(НовоеИмяГруппы, "    ", " ");
	НовоеИмяГруппы = СтрЗаменить(НовоеИмяГруппы, "   ", " ");
	НовоеИмяГруппы = СтрЗаменить(НовоеИмяГруппы, "  ", " ");
	ПреобразованныеГруппы.Вставить(ИмяГруппы, НовоеИмяГруппы);
	Возврат НовоеИмяГруппы;
КонецФункции

Функция НайтиСоздатьГруппуСвойств(ВыборкаГруппа)
	Если ПустаяСтрока(ВыборкаГруппа.ГруппаСвойствКонфигурации)
		И ПустаяСтрока(ВыборкаГруппа.ГруппаСвойствФормата) Тогда
		// Родитель не требуется.
		Возврат Справочники.ПравилаКонвертацииСвойств.ПустаяСсылка();
	КонецЕсли;
	СтруктураПоиска = Новый Структура("Владелец, СвойствоКонфигурации, СвойствоФормата",
		ВыборкаГруппа.Владелец, ВыборкаГруппа.ГруппаСвойствКонфигурации, 
		ВыборкаГруппа.ГруппаСвойствФормата);
	СтруктураПоиска.Вставить("ЭтоГруппа", Истина);
	РезультатПоиска = НайтиПКС(СтруктураПоиска);
	Если РезультатПоиска <> Неопределено Тогда
		Возврат РезультатПоиска;
	КонецЕсли;
	НоваяГруппаСвойств = Справочники.ПравилаКонвертацииСвойств.СоздатьГруппу();
	НоваяГруппаСвойств.Владелец = ВыборкаГруппа.Владелец;
	НоваяГруппаСвойств.СвойствоКонфигурацииСтрокой = ВыборкаГруппа.ГруппаСвойствКонфигурации;
	НоваяГруппаСвойств.СвойствоФормата = ВыборкаГруппа.ГруппаСвойствФормата;
	НоваяГруппаСвойств.Наименование = СформироватьНаименование(ВыборкаГруппа.ГруппаСвойствКонфигурации, 
		ВыборкаГруппа.ГруппаСвойствФормата, ВыборкаГруппа.ИспользоватьДляОтправки, 
		ВыборкаГруппа.ИспользоватьДляПолучения);
	НоваяГруппаСвойств.Записать();
	Возврат НоваяГруппаСвойств.Ссылка;
КонецФункции

Функция НайтиПКС(ПараметрыПоиска)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ Справочник.ПравилаКонвертацииСвойств
	|ГДЕ Владелец = &ПКО И ЭтоГруппа = &ЭтоГруппа 
	|И СвойствоКонфигурацииСтрокой = &СвойствоКонфигурации И СвойствоФормата = &СвойствоФормата";
	Запрос.УстановитьПараметр("ПКО", ПараметрыПоиска.Владелец);
	Запрос.УстановитьПараметр("СвойствоКонфигурации", ПараметрыПоиска.СвойствоКонфигурации);
	Запрос.УстановитьПараметр("СвойствоФормата", ПараметрыПоиска.СвойствоФормата);
	Запрос.УстановитьПараметр("ЭтоГруппа", ПараметрыПоиска.ЭтоГруппа);
	Если ПараметрыПоиска.Свойство("Родитель") Тогда
		Запрос.Текст = Запрос.Текст + " И Родитель = &Родитель";
		Запрос.УстановитьПараметр("Родитель", ПараметрыПоиска.Родитель);
	КонецЕсли;
	ВыборкаПоиск = Запрос.Выполнить().Выбрать();
	Если ВыборкаПоиск.Следующий() Тогда
		Возврат ВыборкаПоиск.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция СформироватьНаименование(СвойствоКонфигурации, СвойствоФормата, ИспользоватьДляОтправки, ИспользоватьДляПолучения)
	Если ИспользоватьДляОтправки И ИспользоватьДляПолучения Тогда
		Разделитель = "<-->";
	ИначеЕсли ИспользоватьДляОтправки Тогда
		Разделитель = "-->";
	Иначе
		Разделитель = "<--";
	КонецЕсли;
	Возврат "" + СвойствоКонфигурации + Разделитель + СвойствоФормата;

КонецФункции

// Служебная процедура, находит или создает тег для правила регистрации
Функция НайтиСоздатьТег(Регистрация, ТегСтрокой)
	Если ТегСтрокой = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекТегСсылка = Справочники.Теги.НайтиПоНаименованию(ТегСтрокой,,,Регистрация);
	Если ЗначениеЗаполнено(ТекТегСсылка) Тогда 
		Возврат ТекТегСсылка;
