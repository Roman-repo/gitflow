Процедура СохранитьЗагруженныеДанные(ОбщиеПеременные)
	Источник = ОбщиеПеременные.Конфигурация;
	ИнициализацияГруппОбъектов(Источник);
	ОбщиеПеременные.Вставить("Обновление", Ложь);
	Если ОбщиеПеременные.КонфигурацииСовпадают Тогда
		
		Приемник = Источник;
		
	Иначе
		Приемник = ОбщиеПеременные.КонфигурацияКорреспондент;
		ИнициализацияГруппОбъектов(Приемник);
	КонецЕсли;
	// Конвертация
	Если ОбщиеПеременные.СпособЗагрузкиКонвертации = 0 Тогда
		
		НоваяКонвертация = Справочники.Конвертации.СоздатьЭлемент();
		НоваяКонвертация.Наименование = ОбщиеПеременные.ИмяКонвертацииДляЗагрузки;
        НоваяКонвертация.Конфигурация = Источник;
		НоваяКонвертация.КонфигурацияКорреспондент = Приемник;
		НоваяКонвертация.ТипКонвертации = Перечисления.ТипыКонвертаций.XML;
		НоваяКонвертация.Записать();
		
	Иначе
        
		НоваяКонвертация = ОбщиеПеременные.КонвертацияСсылка.ПолучитьОбъект();
		НоваяКонвертация.Конфигурация = Источник;
		НоваяКонвертация.КонфигурацияКорреспондент = Приемник;
		// Параметры загружаются поверх всегда.
		НоваяКонвертация.Параметры.Очистить();
		НоваяКонвертация.Записать();
		Если  ОбщиеПеременные.СпособЗагрузкиКонвертации = 1 Тогда
			// Полная замена.
			КонвертацияСсылка = НоваяКонвертация.Ссылка;
			УдалитьЭлементыКонвертации(КонвертацияСсылка, "Запросы");
			УдалитьЭлементыКонвертации(КонвертацияСсылка, "Алгоритмы");
			УдалитьЭлементыКонвертации(КонвертацияСсылка, "ПравилаОбработкиДанных");
			УдалитьЭлементыКонвертации(КонвертацияСсылка, "ПравилаКонвертацииПредопределенныхДанных");
			УдалитьЭлементыКонвертации(КонвертацияСсылка, "ПравилаКонвертацииОбъектов");
		ИначеЕсли ОбщиеПеременные.СпособЗагрузкиКонвертации = 2 Тогда
			
			ОбщиеПеременные.Вставить("Обновление", Истина);
			
			ПолучитьВсеПравилаКонвертации(КонвертацияСсылка, ОбщиеПеременные);
		КонецЕсли;
		
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПослеЗагрузкиПравилОбмена") Тогда
		НоваяКонвертация.АлгоритмПослеЗагрузкиПравилОбмена  = ОбщиеПеременные.Конвертация.ПослеЗагрузкиПравилОбмена;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПередПолучениемИзмененныхОбъектов") Тогда
		НоваяКонвертация.АлгоритмПередПолучениемИзмененныхОбъектов  = ОбщиеПеременные.Конвертация.ПередПолучениемИзмененныхОбъектов;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПослеПолученияИнформацииОбУзлахОбмена") Тогда
		НоваяКонвертация.АлгоритмПослеПолученияИнформацииОбУзлахОбмена  = ОбщиеПеременные.Конвертация.ПослеПолученияИнформацииОбУзлахОбмена;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПередВыгрузкойДанных") Тогда
		НоваяКонвертация.АлгоритмПередВыгрузкойДанных     = ОбщиеПеременные.Конвертация.ПередВыгрузкойДанных;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПослеВыгрузкиДанных") Тогда
		НоваяКонвертация.АлгоритмПослеВыгрузкиДанных      = ОбщиеПеременные.Конвертация.ПослеВыгрузкиДанных;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПередЗагрузкойДанных") Тогда
		НоваяКонвертация.АлгоритмПередЗагрузкойДанных     = ОбщиеПеременные.Конвертация.ПередЗагрузкойДанных;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПослеЗагрузкиДанных") Тогда
		НоваяКонвертация.АлгоритмПослеЗагрузкиДанных      = ОбщиеПеременные.Конвертация.ПослеЗагрузкиДанных;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПередВыгрузкойОбъекта") Тогда
		НоваяКонвертация.АлгоритмПередВыгрузкойОбъекта    = ОбщиеПеременные.Конвертация.ПередВыгрузкойОбъекта;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПередКонвертациейОбъекта") Тогда
		НоваяКонвертация.АлгоритмПередКонвертациейОбъекта = ОбщиеПеременные.Конвертация.ПередКонвертациейОбъекта;
	КонецЕсли;

	Если ОбщиеПеременные.Конвертация.Свойство("ПослеВыгрузкиОбъекта") Тогда
		НоваяКонвертация.АлгоритмПослеВыгрузкиОбъекта = ОбщиеПеременные.Конвертация.ПослеВыгрузкиОбъекта;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПередЗагрузкойОбъекта") Тогда
		НоваяКонвертация.АлгоритмПередЗагрузкойОбъекта = ОбщиеПеременные.Конвертация.ПередЗагрузкойОбъекта;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПослеЗагрузкиОбъекта") Тогда
		НоваяКонвертация.АлгоритмПослеЗагрузкиОбъекта = ОбщиеПеременные.Конвертация.ПослеЗагрузкиОбъекта;
	КонецЕсли;
	
	Если ОбщиеПеременные.Конвертация.Свойство("ПередОтправкойИнформацииОбУдалении") Тогда
		НоваяКонвертация.АлгоритмПередОтправкойИнформацииОбУдалении = ОбщиеПеременные.Конвертация.ПередОтправкойИнформацииОбУдалении;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПриПолученииИнформацииОбУдалении") Тогда
		НоваяКонвертация.АлгоритмПриПолученииИнформацииОбУдалении = ОбщиеПеременные.Конвертация.ПриПолученииИнформацииОбУдалении;
	КонецЕсли;
	Если ОбщиеПеременные.Конвертация.Свойство("ПослеЗагрузкиПараметров") Тогда
		НоваяКонвертация.АлгоритмПослеЗагрузкиПараметров = ОбщиеПеременные.Конвертация.ПослеЗагрузкиПараметров;
	КонецЕсли;
	
	// Параметры.
	Для Каждого СтрокаТаблицы Из ОбщиеПеременные.Параметры Цикл
		НовыйПараметр = НоваяКонвертация.Параметры.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйПараметр, СтрокаТаблицы);
		
		Если НЕ ПустаяСтрока(СтрокаТаблицы.ТипОбъекта) Тогда
			
			СпрОбъект = Справочники.Объекты.НайтиПоНаименованию(СтрокаТаблицы.ТипОбъекта, ИСТИНА, , НоваяКонвертация.Конфигурация);
			Если СпрОбъект <> Справочники.Объекты.ПустаяСсылка() Тогда
				НовыйПараметр.ТипОбъекта = СпрОбъект;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ОбщиеПеременные.Вставить("Конфигурация", НоваяКонвертация.Конфигурация);
	ОбщиеПеременные.Вставить("КонфигурацияКорреспондент", НоваяКонвертация.КонфигурацияКорреспондент);
	НоваяКонвертация.Записать();
	ЗагружаемаяКонвертация = НоваяКонвертация.Ссылка;

	
	ЗаписатьПКО(ОбщиеПеременные.ПравилаКонвертацииОбъектов, ЗагружаемаяКонвертация, ОбщиеПеременные);
	ЗаписатьАлгоритмы(ОбщиеПеременные.Алгоритмы, ЗагружаемаяКонвертация, ОбщиеПеременные);
	ЗаписатьЗапросы(ОбщиеПеременные.Запросы, ЗагружаемаяКонвертация, ОбщиеПеременные);
	ЗаписатьПВД(ОбщиеПеременные.ПравилаВыгрузкиДанных, ЗагружаемаяКонвертация, ОбщиеПеременные);
	Если ОбщиеПеременные.Обновление Тогда
		Для каждого СсылкаДляУдаления Из ОбщиеПеременные.ВсеПравилаКонвертации Цикл
			
			Если СсылкаДляУдаления.Значение.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			
			ОбъектДляУдаления = СсылкаДляУдаления.Значение.ПолучитьОбъект();
			ОбъектДляУдаления.УстановитьПометкуУдаления(Истина, Ложь);
			
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьПКО(СтрокиПКО, Конвертация, ОбщиеПеременные, Родитель = "")
	
	Для каждого Строка Из СтрокиПКО.Строки Цикл
		Если Строка.ЭтоГруппа Тогда
			// Группы правил не создаются, обрабатываются вложенные в них строки.
			Если Родитель = "" Тогда
				ИмяРодителя = Строка.Имя;
			Иначе
				ИмяРодителя = Родитель + "\" +Строка.Имя; 
			КонецЕсли;
			ЗаписатьПКО(Строка, Конвертация, ОбщиеПеременные, ИмяРодителя);
			Продолжить;
		КонецЕсли;
		// Может быть ПравилоКонвертацииОбъекта, ПравилоКонвертацииПредопределенныхДанных или два правила сразу.
		ПКОСоздано = Ложь;
		Если Строка.Свойства.Строки.Количество() > 0 Тогда
			ЗаписатьЭлементПКО(Строка, Конвертация, ОбщиеПеременные, Истина, Родитель);
			ПКОСоздано = Истина;
		КонецЕсли;
		Если Строка.Значения.Строки.Количество() > 0 Тогда
			ЗаписатьЭлементПКО(Строка, Конвертация, ОбщиеПеременные, Ложь, Родитель);
			ПКОСоздано = Истина;
		КонецЕсли;
		Если НЕ ПКОСоздано Тогда
			// Тип правила определяем по виду объекта.
			ОбъектКонфигурации = ОпределитьОбъектКонфигурации(Строка.Источник, ОбщиеПеременные);
			ТипОбъекта = ОбъектКонфигурации.Тип;
			Если ТипОбъекта = Перечисления.ТипыОбъектов.Перечисление Тогда
				ЗаписатьЭлементПКО(Строка, Конвертация, ОбщиеПеременные, Ложь, Родитель);
			Иначе
				ЗаписатьЭлементПКО(Строка, Конвертация, ОбщиеПеременные, Истина, Родитель);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры // ЗаписатьПКО()

Процедура ЗаписатьЭлементПКО(Строка, Конвертация, ОбщиеПеременные, ЭтоПКО, Родитель)
	Если ЭтоПКО Тогда
		ИмяСправочника = "ПравилаКонвертацииОбъектов";
	Иначе
		ИмяСправочника = "ПравилаКонвертацииПредопределенныхДанных";
	КонецЕсли;
	ПКО = НайтиИлиСоздатьЭлементКонвертации(Строка, ИмяСправочника, Конвертация, ОбщиеПеременные);
	
	ПКО.ГруппаПравил = Родитель;
	ПКО.ИспользоватьДляОтправки = Истина;
	
	ПКО.ОбъектКонфигурации = ОпределитьОбъектКонфигурации(Строка.Источник, ОбщиеПеременные);
	ПКО.ОбъектКонфигурацииКорреспондент = ОпределитьОбъектКонфигурации(Строка.Приемник, ОбщиеПеременные, Истина);
	Если НЕ ЭтоПКО Тогда
		ПКО.СопоставлениеЗначений.Очистить();
		ЗаписатьПКЗ(Строка.Значения, ПКО, ПКО.ОбъектКонфигурации, ПКО.ОбъектКонфигурацииКорреспондент);
	КонецЕсли;

	Если Строка.ЕстьОбработчикПередВыгрузкой Тогда
		ПКО.АлгоритмПередВыгрузкойОбъекта = Строка.ПередВыгрузкой;
	КонецЕсли;
	Если Строка.ЕстьОбработчикПриВыгрузке Тогда
		ПКО.АлгоритмПриВыгрузкеОбъекта    = Строка.ПриВыгрузке;
	КонецЕсли;
	Если Строка.ЕстьОбработчикПослеВыгрузки Тогда
		ПКО.АлгоритмПослеВыгрузкиОбъекта  = Строка.ПослеВыгрузки;
	КонецЕсли;
	Если Строка.ЕстьОбработчикПослеВыгрузкиВФайл Тогда
		ПКО.АлгоритмПослеВыгрузкиОбъектаВФайлОбмена  = Строка.ПослеВыгрузкиВФайл;
	КонецЕсли;
	Если Строка.ЕстьОбработчикПередЗагрузкой Тогда
		ПКО.АлгоритмПередЗагрузкойОбъекта = Строка.ПередЗагрузкой;
	КонецЕсли;
	Если Строка.ЕстьОбработчикПриЗагрузке Тогда
		ПКО.АлгоритмПриЗагрузкеОбъекта    = Строка.ПриЗагрузке;
	КонецЕсли;
	Если Строка.ЕстьОбработчикПослеЗагрузки Тогда
		ПКО.АлгоритмПослеЗагрузкиОбъекта  = Строка.ПослеЗагрузки;
	КонецЕсли;

	Если НЕ ЭтоПКО Тогда
		ПКО.Записать();
		Возврат;
	КонецЕсли;
	ПКО.НеЗапоминатьВыгруженные            = Строка.НеЗапоминатьВыгруженные;
	Если НЕ Строка.СинхронизироватьПоИдентификатору Тогда
		ПКО.ВариантИдентификации = Перечисления.ВариантыИдентификацииОбъектов.ПоПолямПоиска;
	ИначеЕсли Строка.ПродолжитьПоискПоПолямПоискаЕслиПоИдентификаторуНеНашли Тогда
		ПКО.ВариантИдентификации = Перечисления.ВариантыИдентификацииОбъектов.СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска;
	Иначе
		ПКО.ВариантИдентификации = Перечисления.ВариантыИдентификацииОбъектов.ПоУникальномуИдентификатору;
	КонецЕсли;
	ПКО.НеВыгружатьОбъектыСвойствПоСсылкам = Строка.НеВыгружатьОбъектыСвойствПоСсылкам;
	ПКО.НеСоздаватьОбъектВПриемникеЕслиНеНайденПоПолямПоиска = Строка.НеСоздаватьОбъектВПриемникеЕслиНеНайденПоПолямПоиска;
	ПКО.ИспользоватьБыстрыйПоискПриЗагрузке = Строка.ИспользоватьБыстрыйПоискПриЗагрузке;
	ПКО.ВыгружатьОбъектТолькоПриНаличииНаНегоСсылки = Строка.ВыгружатьОбъектТолькоПриНаличииНаНегоСсылки;
	ПКО.ПриПереносеОбъектаПоСсылкеУстанавливатьТолькоGIUD = Строка.ПриПереносеОбъектаПоСсылкеУстанавливатьТолькоGIUD;
	ПКО.НеЗамещатьОбъектСозданныйВИнформационнойБазеПриемнике = Строка.НеЗамещатьОбъектСозданныйВИнформационнойБазеПриемнике;
	ПКО.ГенерироватьНовыйНомерИлиКодЕслиНеУказан = Строка.ГенерироватьНовыйНомерИлиКодЕслиНеУказан;
	ПКО.НеЗамещать                         = Строка.НеЗамещать;
	ПКО.Порядок = Строка.Порядок;
	Если Не ПустаяСтрока(Строка.ПриоритетОбъектовОбмена) Тогда
		
		Если Строка.ПриоритетОбъектовОбмена = "Ниже" Тогда
			ПКО.ПриоритетОбъектовОбмена = Перечисления.ПриоритетОбъектовОбмена.ПриоритетПоступившегоПриОбменеОбъектаНиже;
		ИначеЕсли Строка.ПриоритетОбъектовОбмена = "Совпадает" Тогда
			ПКО.ПриоритетОбъектовОбмена = Перечисления.ПриоритетОбъектовОбмена.ПриоритетПоступившегоПриОбменеОбъектаСовпадает;
		КонецЕсли
		
	Иначе
		
		ПКО.ПриоритетОбъектовОбмена = Перечисления.ПриоритетОбъектовОбмена.ПриоритетПоступившегоПриОбменеОбъектаВыше;
		
	КонецЕсли;

	Если Строка.ЕстьОбработчикПоследовательностейПолейПоиска Тогда
		ПКО.АлгоритмПоследовательностьПолейПоиска  = Строка.ПоследовательностьПолейПоиска;
	КонецЕсли;

	ПКО.НастройкаВариантовПоискаОбъектовXML.Очистить();
	Если Строка.НастройкаВариантовПоискаОбъектов <> Неопределено
		И Строка.НастройкаВариантовПоискаОбъектов.Количество() > 0 Тогда
		
		Для Каждого СтрокаТаблицы Из Строка.НастройкаВариантовПоискаОбъектов Цикл
			
			СтрокаТабЧасти = ПКО.НастройкаВариантовПоискаОбъектовXML.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТабЧасти, СтрокаТаблицы);
			
		КонецЦикла;
		
	КонецЕсли;
	ПКО.Записать();
	ЗаписатьПКС(Строка.Свойства, ПКО.Ссылка, ПКО.ОбъектКонфигурации, ПКО.ОбъектКонфигурацииКорреспондент, Конвертация, ОбщиеПеременные);

КонецПроцедуры

Функция НайтиИлиСоздатьПКС(ПКС, СведенияПКС, Строка, ОбщиеПеременные)
	СоздаватьНовый = СведенияПКС.СоздаватьНовый;
	Владелец = СведенияПКС.Владелец;
	ОбъектИсточник = СведенияПКС.ОбъектИсточник;
	ОбъектПриемник = СведенияПКС.ОбъектПриемник;
	Родитель = СведенияПКС.Родитель;
	Если СоздаватьНовый Тогда
		
		Если Строка.ЭтоГруппа Тогда
			ПКС = Справочники.ПравилаКонвертацииСвойств.СоздатьГруппу();
		Иначе
			ПКС = Справочники.ПравилаКонвертацииСвойств.СоздатьЭлемент();
		КонецЕсли;
		
		ПКС.Владелец     = Владелец;
		ПКС.Код          = Строка.Имя;
	КонецЕсли;
	
	СвойствоРодительИсточник = Неопределено;
	СвойствоРодительПриемник = Неопределено;
	Если Родитель <> Неопределено Тогда
		ПКС.Родитель = Родитель;
		ДанныеРодителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Родитель,"СвойствоКонфигурации, СвойствоКонфигурацииКорреспондента");
		Если ЗначениеЗаполнено(ДанныеРодителя.СвойствоКонфигурации) Тогда
			СвойствоРодительИсточник = ДанныеРодителя.СвойствоКонфигурации;
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеРодителя.СвойствоКонфигурацииКорреспондента) Тогда
			СвойствоРодительПриемник = ДанныеРодителя.СвойствоКонфигурацииКорреспондента;
		КонецЕсли;
	КонецЕсли;

	Если ОбщиеПеременные.Обновление Тогда
		ОбщиеПеременные.ВсеПравилаКонвертации.Удалить(ПКС.Ссылка);
	КонецЕсли;
	ПКС.ОбменДанными.Загрузка = Истина;
	ПКС.Наименование             = Строка.Наименование;
	Если ЗначениеЗаполнено(ОбъектИсточник) Тогда
		Если Строка.ЭтоГруппа Тогда
			ДанныеДляЗаполнения = Новый Структура("ЭтоГруппа, Вид", Строка.ЭтоГруппа, Строка.ВидИсточника);
		Иначе
			ДанныеДляЗаполнения = Новый Структура("ЭтоГруппа, Тип, Вид", Строка.ЭтоГруппа, Строка.ТипИсточника, Строка.ВидИсточника);
		КонецЕсли;
		ПКС.СвойствоКонфигурации = ОпределитьСвойствоКонфигурации(Строка.Источник, ОбъектИсточник, ДанныеДляЗаполнения, СвойствоРодительИсточник);
	КонецЕсли;
	Если НЕ Строка.ЭтоГруппа Тогда
		ПКС.ПолноеИмяСвойстваКонфигурации = Строка.Источник;
		Если ЗначениеЗаполнено(ПКС.Родитель) И ЗначениеЗаполнено(ПКС.СвойствоКонфигурации.Родитель) Тогда
			ПКС.ПолноеИмяСвойстваКонфигурации = СокрЛП(ДанныеРодителя.СвойствоКонфигурации) + "." + Строка.Источник;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ОбъектПриемник) Тогда
		Если Строка.ЭтоГруппа Тогда
			ДанныеДляЗаполнения = Новый Структура("ЭтоГруппа, Вид", Строка.ЭтоГруппа, Строка.ВидПриемника);
		Иначе
			ДанныеДляЗаполнения = Новый Структура("ЭтоГруппа, Тип, Вид", Строка.ЭтоГруппа, Строка.ТипПриемника, Строка.ВидПриемника);
		КонецЕсли;
		ПКС.СвойствоКонфигурацииКорреспондента = ОпределитьСвойствоКонфигурации(Строка.Приемник, ОбъектПриемник, ДанныеДляЗаполнения, СвойствоРодительПриемник);
	КонецЕсли;
	Если НЕ Строка.ЭтоГруппа Тогда
		ПКС.ПолноеИмяСвойстваКонфигурацииКорреспондента = Строка.Приемник;
		Если ЗначениеЗаполнено(ПКС.Родитель) И ЗначениеЗаполнено(ПКС.СвойствоКонфигурацииКорреспондента.Родитель) Тогда
			ПКС.ПолноеИмяСвойстваКонфигурацииКорреспондента = СокрЛП(ДанныеРодителя.СвойствоКонфигурацииКорреспондента) + "." + Строка.Приемник;
		КонецЕсли; 
	КонецЕсли;
	ПКС.ПолучитьИзВходящихДанных = Строка.ПолучитьИзВходящихДанных;
	ПКС.НеЗамещать               = Строка.НеЗамещать;
	ПКС.Отключить                = Строка.Отключить;
	ПКС.Порядок                  = Строка.Порядок;

	Если ЗначениеЗаполнено(Строка.ТипИсточника) Или ЗначениеЗаполнено(Строка.ТипПриемника) Тогда
		ПКС.ТипСвойстваКонфигурации = Строка.ТипИсточника;
		ПКС.ТипСвойстваКонфигурацииКорреспондента = Строка.ТипПриемника;
	Иначе
		ПКС.ТипСвойстваКонфигурации = Строка.ВидИсточника;
		ПКС.ТипСвойстваКонфигурацииКорреспондента = Строка.ВидПриемника;
	КонецЕсли;
		
	Если Строка.ЕстьОбработчикПередВыгрузкой Тогда
		ПКС.АлгоритмПередВыгрузкойСвойства  = Строка.ПередВыгрузкой;
	КонецЕсли;
		
	Если Строка.ЕстьОбработчикПриВыгрузке Тогда
		ПКС.АлгоритмПриВыгрузкеСвойства     = Строка.ПриВыгрузке;
	КонецЕсли;

	Если Строка.ЕстьОбработчикПослеВыгрузки Тогда
		ПКС.АлгоритмПослеВыгрузкиСвойства   = Строка.ПослеВыгрузки;
	КонецЕсли;	
		
КонецФункции

Процедура ЗаписатьПКС(СтрокиПКС, Владелец, ОбъектИсточник, ОбъектПриемник, Конвертация, ОбщиеПеременные, Родитель = Неопределено)

	Для каждого Строка Из СтрокиПКС.Строки Цикл
		
		СоздаватьНовый = Истина;
			
		Если ОбщиеПеременные.Обновление Тогда
			СсылкаПКС = Справочники.ПравилаКонвертацииСвойств.НайтиПоКоду(Строка.Имя, , , Владелец);
			Если НЕ СсылкаПКС.Пустая() Тогда
				ПКС = СсылкаПКС.ПолучитьОбъект();
				СоздаватьНовый = Ложь;
			КонецЕсли;
		КонецЕсли;
		СведенияПКС = Новый Структура("Родитель, Владелец, СоздаватьНовый", Родитель, Владелец, СоздаватьНовый);
		СведенияПКС.Вставить("ОбъектИсточник", ОбъектИсточник);
		СведенияПКС.Вставить("ОбъектПриемник", ОбъектПриемник);
		НайтиИлиСоздатьПКС(ПКС, СведенияПКС, Строка, ОбщиеПеременные);

		Если Строка.ЭтоГруппа Тогда

			НоваяГруппаПКС = ПКС;
					
			Если Строка.ЕстьОбработчикПередОбработкойВыгрузки Тогда
				НоваяГруппаПКС.АлгоритмПередОбработкойВыгрузки = Строка.ПередОбработкойВыгрузки;
			КонецЕсли;

			Если Строка.ЕстьОбработчикПослеОбработкиВыгрузки Тогда
				НоваяГруппаПКС.АлгоритмПослеОбработкиВыгрузки  = Строка.ПослеОбработкиВыгрузки;
			КонецЕсли;

			НоваяГруппаПКС.ОбменДанными.Загрузка = Истина;
			
			НоваяГруппаПКС.ВыгружатьГруппуЧерезФайл = Строка.ВыгружатьГруппуЧерезФайл;
			НоваяГруппаПКС.ОбменДанными.Загрузка = Истина;
			НоваяГруппаПКС.ИспользуетсяАлгоритмКонвертации = НЕ ПустаяСтрока(НоваяГруппаПКС.АлгоритмПередВыгрузкойСвойства)
				Или НЕ ПустаяСтрока(НоваяГруппаПКС.АлгоритмПриВыгрузкеСвойства) Или НЕ ПустаяСтрока(НоваяГруппаПКС.АлгоритмПослеВыгрузкиСвойства)
				Или НЕ ПустаяСтрока(НоваяГруппаПКС.АлгоритмПередОбработкойВыгрузки)
				Или НЕ ПустаяСтрока(НоваяГруппаПКС.АлгоритмПослеОбработкиВыгрузки);
						
			НоваяГруппаПКС.Записать();
			
			ЗаписатьПКС(Строка, Владелец, ОбъектИсточник, ОбъектПриемник, Конвертация, ОбщиеПеременные, НоваяГруппаПКС.Ссылка);
			
		Иначе
			
			НовоеПКС = ПКС;
									
			НовоеПКС.Поиск = Строка.Поиск;
			
			НовоеПКС.АвтоматическиПриводитьЗначениеКДлинеПриемника = Строка.ПриводитьКДлине;
			НовоеПКС.ИмяПараметраДляПередачи = Строка.ИмяПараметраДляПередачи;
			НовоеПКС.ПоискПоДатеНаРавенство = Строка.ПоискПоДатеНаРавенство;
						
			НовоеПКС.ОбменДанными.Загрузка = Истина;
			НовоеПКС.ИспользуетсяАлгоритмКонвертации = НЕ ПустаяСтрока(НовоеПКС.АлгоритмПередВыгрузкойСвойства)
				Или НЕ ПустаяСтрока(НовоеПКС.АлгоритмПриВыгрузкеСвойства) Или НЕ ПустаяСтрока(НовоеПКС.АлгоритмПослеВыгрузкиСвойства);
			
			НовоеПКС.ПравилоКонвертацииСвойства = Строка.ПравилоКонвертации;
			НовоеПКС.Записать(); 			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры // ЗаписатьПКС()

Процедура ЗаписатьПКЗ(СтрокиПКЗ, Владелец, Источник, Приемник)
	
	Для каждого Строка Из СтрокиПКЗ.Строки Цикл
		ПКЗ = Владелец.СопоставлениеЗначений.Добавить();
		ПКЗ.ЗначениеКонфигурации = Строка.Источник;
		ПКЗ.ЗначениеКонфигурацииКорреспондент = Строка.Приемник;
		
		// Проверка наличия значений
		Если ЗначениеЗаполнено(Строка.Источник) И ЗначениеЗаполнено(Источник) И ТипЗнч(Источник) = Тип("СправочникСсылка.Объекты") Тогда
			ЗначениеИсточник = Справочники.Значения.НайтиПоНаименованию(Строка.Источник, Истина,, Источник);
			Если НЕ ЗначениеЗаполнено(ЗначениеИсточник) Тогда
				ЗначениеОбъект = Справочники.Значения.СоздатьЭлемент();
				ЗначениеОбъект.ПометкаУдаления = Истина;
				ЗначениеОбъект.Наименование = Строка.Источник;
				ЗначениеОбъект.Владелец = Источник;
				ЗначениеОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.Приемник) И ЗначениеЗаполнено(Приемник) И ТипЗнч(Приемник) = Тип("СправочникСсылка.Объекты") Тогда
			ЗначениеПриемник = Справочники.Значения.НайтиПоНаименованию(Строка.Приемник, Истина,, Приемник);
			Если НЕ ЗначениеЗаполнено(ЗначениеПриемник) Тогда
				ЗначениеОбъект = Справочники.Значения.СоздатьЭлемент();
				ЗначениеОбъект.ПометкаУдаления = Истина;
				ЗначениеОбъект.Наименование = Строка.Приемник;
				ЗначениеОбъект.Владелец = Приемник;
				ЗначениеОбъект.Записать();
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры // ЗаписатьПКЗ()

Процедура ЗаписатьАлгоритмы(СтрокиАлгоритмы, Конвертация, ОбщиеПеременные, Родитель = "")

	Для каждого Строка Из СтрокиАлгоритмы.Строки Цикл
		Если Строка.ЭтоГруппа Тогда
			Если Родитель = "" Тогда
				ИмяРодителя = Строка.Код;
			Иначе
				ИмяРодителя = Родитель + "\" +Строка.Код; 
			КонецЕсли;
			ЗаписатьАлгоритмы(Строка, Конвертация, ОбщиеПеременные, ИмяРодителя);
			Продолжить;
		КонецЕсли;
		Алгоритм = НайтиИлиСоздатьЭлементКонвертации(Строка, "Алгоритмы", Конвертация, ОбщиеПеременные);

		Алгоритм.ГруппаПравил = Родитель;
		Алгоритм.Алгоритм = Строка.Алгоритм;
		Алгоритм.ИспользуетсяПриЗагрузке = Строка.ИспользуетсяПриЗагрузке;
		Алгоритм.Параметры = Строка.Параметры;

		Алгоритм.Записать();

	КонецЦикла;

КонецПроцедуры // ЗаписатьАлгоритмы()

Процедура ЗаписатьЗапросы(СтрокиЗапросы, Конвертация, ОбщиеПеременные, Родитель = "")

	Для каждого Строка Из СтрокиЗапросы.Строки Цикл
		Если Строка.ЭтоГруппа Тогда
			Если Родитель = "" Тогда
				ИмяРодителя = Строка.Код;
			Иначе
				ИмяРодителя = Родитель + "\" +Строка.Код; 
			КонецЕсли;
			ЗаписатьЗапросы(Строка, Конвертация, ОбщиеПеременные, ИмяРодителя);
			Продолжить;
		КонецЕсли;
		Запрос = НайтиИлиСоздатьЭлементКонвертации(Строка, "Запросы", Конвертация, ОбщиеПеременные);
		Запрос.ТекстЗапроса = Строка.ТекстЗапроса;
		Запрос.ГруппаПравил = Родитель;
		Запрос.ИспользуетсяПриЗагрузке = Строка.ИспользуетсяПриЗагрузке;

		Запрос.Записать();
	КонецЦикла;

КонецПроцедуры // ЗаписатьЗапросы()

Процедура ЗаписатьПВД(СтрокиПВД, Конвертация, ОбщиеПеременные, Родитель = "")
	Для каждого Строка Из СтрокиПВД.Строки Цикл
		Если Строка.ЭтоГруппа Тогда
			Если НЕ Строка.Отключить Тогда
				Если Родитель = "" Тогда
					ИмяРодителя = Строка.Имя;
				Иначе
					ИмяРодителя = Родитель + "\" +Строка.Имя; 
				КонецЕсли;
				// Элементы отключенной группы не загружаем.
				ЗаписатьПВД(Строка, Конвертация, ОбщиеПеременные, ИмяРодителя);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		ПВД = НайтиИлиСоздатьЭлементКонвертации(Строка, "ПравилаОбработкиДанных", Конвертация, ОбщиеПеременные);
		ПВД.ИспользоватьДляОтправки = Истина;
		ПВД.ГруппаПравил = Родитель;
		Если НРег(СокрЛП(Строка.СпособОтбораДанных)) = НРег("ПроизвольныйАлгоритм") Тогда
			ПВД.СпособВыборки = 1;
		Иначе
			ПВД.СпособВыборки = 0;
		КонецЕсли;
		ПВД.Отключить = Строка.Отключить;
		
		ПВД.ВыбиратьДанныеДляВыгрузкиОднимЗапросом    = Строка.ВыбиратьДанныеДляВыгрузкиОднимЗапросом;
		ПВД.НеВыгружатьОбъектыСозданныеВБазеПриемнике = Строка.НеВыгружатьОбъектыСозданныеВБазеПриемнике;

		ПВД.ОбъектВыборки = ОпределитьОбъектКонфигурации(Строка.ОбъектВыборки, ОбщиеПеременные);

		ПВД.ПравилоКонвертацииОбъекта = Строка.ПравилоКонвертации;

		ПВД.АлгоритмПередОбработкойПравила = Строка.ПередОбработкой;
		ПВД.АлгоритмПослеОбработкиПравила  = Строка.ПослеОбработки;
		ПВД.АлгоритмПередВыгрузкойОбъекта  = Строка.ПередВыгрузкой;
		ПВД.АлгоритмПослеВыгрузкиОбъекта   = Строка.ПослеВыгрузки;
		ПВД.Комментарий = Строка.Комментарий;
		ПВД.Описание = Строка.Описание;
		ПВД.Записать();
	КонецЦикла;

КонецПроцедуры

Функция НайтиИлиСоздатьЭлементКонвертации(СтрокаДанные, ИмяСправочника, Конвертация, ОбщиеПеременные)
	СоздаватьНовый = Истина;
	Если ИмяСправочника = "ПравилаОбработкиДанных" Тогда
		РеквизитПоиска = "Наименование";
	Иначе
		РеквизитПоиска = "Код";
	КонецЕсли;
	РеквизитДанных = "Имя";
	Если ИмяСправочника = "Алгоритмы" Или ИмяСправочника = "Запросы" Тогда
		РеквизитДанных = "Код";
	КонецЕсли;
	Если ОбщиеПеременные.Обновление Тогда
		// Поиск существующего элемента конвертации.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ЭлементКонвертации.Ссылка КАК СсылкаПравило,
		|	Состав.Ссылка КАК СсылкаСостав
		|ИЗ Справочник." + ИмяСправочника + " КАК ЭлементКонвертации
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Справочник.СоставыКонвертаций КАК Состав
		|ПО Состав.ЭлементКонвертации = ЭлементКонвертации.Ссылка
		|	И Состав.Владелец = &Конвертация
		|	И Состав.Отключить = ЛОЖЬ
		|ГДЕ ЭлементКонвертации.Ссылка." + РеквизитПоиска + " = &Имя";
		Запрос.УстановитьПараметр("Конвертация", Конвертация);
		Запрос.УстановитьПараметр("Имя", СтрокаДанные[РеквизитДанных]);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЭлементКонвертации = Выборка.СсылкаПравило.ПолучитьОбъект();
			СоздаватьНовый = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если СоздаватьНовый Тогда
		ЭлементКонвертации = Справочники[ИмяСправочника].СоздатьЭлемент();
		ЭлементКонвертации[РеквизитПоиска] = СтрокаДанные[РеквизитДанных];
		УИД = Новый УникальныйИдентификатор;
		ЭлементКонвертации.УстановитьСсылкуНового(Справочники[ИмяСправочника].ПолучитьСсылку(УИД));
		
		СоставКонвертации = Справочники.СоставыКонвертаций.СоздатьЭлемент();
		СоставКонвертации.Владелец = Конвертация;
		СоставКонвертации.ЭлементКонвертации = ЭлементКонвертации.ПолучитьСсылкуНового();
		СоставКонвертации.Записать();
	КонецЕсли;
			
	Если ОбщиеПеременные.Обновление Тогда
		ОбщиеПеременные.ВсеПравилаКонвертации.Удалить(ЭлементКонвертации.Ссылка);
	КонецЕсли;
	Если ИмяСправочника = "ПравилаКонвертацииОбъектов"
		Или ИмяСправочника = "ПравилаОбработкиДанных"
		Или ИмяСправочника = "ПравилаКонвертацииПредопределенныхДанных" Тогда
		ЭлементКонвертации.Порядок      = СтрокаДанные.Порядок;
	КонецЕсли;
	Если ИмяСправочника <> "Запросы" Тогда
		ЭлементКонвертации.ТипКонвертации = Перечисления.ТипыКонвертаций.XML;
	КонецЕсли;
	ЭлементКонвертации.ОбменДанными.Загрузка = Истина;
	Возврат ЭлементКонвертации;
КонецФункции

Процедура УдалитьЭлементыКонвертации(Конвертация, ИмяСправочника)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|СоставСвой.Ссылка КАК СоставСсылка,
	|Правило.Ссылка КАК ЭлементСсылка,
	|ВЫБОР КОГДА СоставЧужой.Ссылка IS NULL ТОГДА ИСТИНА
	|	ИНАЧЕ ЛОЖЬ
	|КОНЕЦ КАК УдалитьЭлемент
	|ИЗ Справочник." + ИмяСправочника + " КАК Правило
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|	Справочник.СоставыКонвертаций КАК СоставСвой
	|ПО СоставСвой.ЭлементКонвертации = Правило.Ссылка
	|	И СоставСвой.Владелец = &Конвертация
	|	И СоставСвой.Отключить = ЛОЖЬ
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.СоставыКонвертаций КАК СоставЧужой
	|ПО СоставСвой.ЭлементКонвертации = Правило.Ссылка
	|	И СоставСвой.Владелец <> &Конвертация
	|";
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Удаление элемента из состава конвертации.
		СоставОбъект = Выборка.СоставСсылка.ПолучитьОбъект();
		СоставОбъект.Удалить();
		
		// Удаление элемента, если на него нет ссылок из других конвертаций.
		Если Выборка.УдалитьЭлемент Тогда
			
			ЭлементОбъект = Выборка.ЭлементСсылка.ПолучитьОбъект();
			Если ЭлементОбъект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ЭлементОбъект.Удалить();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПолучитьВсеПравилаКонвертации(Конвертация, ОбщиеПеременные)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|СоставСвой.Ссылка
	|ИЗ Справочник.СоставыКонвертаций КАК СоставСвой
	|ГДЕ СоставСвой.ЭлементКонвертации = ЭлементКонвертации.Ссылка
	|	И СоставСвой.Владелец = &Конвертация
	|	И СоставСвой.Отключить = ЛОЖЬ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|ЭлементКонвертации.Ссылка
	|ИЗ Справочник.ПравилаКонвертацииСвойств КАК ЭлементКонвертации
	|ЛЕВОЕ СОЕДИНЕНИЕ 
	|	Справочник.СоставыКонвертаций КАК СоставСвой
	|ПО СоставСвой.ЭлементКонвертации = ЭлементКонвертации.Владелец
	|	И СоставСвой.Владелец = &Конвертация
	|	И СоставСвой.Отключить = ЛОЖЬ
	|ГДЕ СоставСвой.ЭлементКонвертации IS NOT NULL
	|";
	ВсеПравилаКонвертации = Новый Соответствие;
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ВсеПравилаКонвертации.Вставить(Выборка.Ссылка, Выборка.Ссылка);
	КонецЦикла;
	ОбщиеПеременные.Вставить("ВсеПравилаКонвертации", ВсеПравилаКонвертации);
КонецПроцедуры

// Осуществляет инициализацию объектов, определяющих базовые типы
// Параметры:
//  Владелец       - ссылка на элемент справочника "Конфигурации",
//                   являющуюся владельцем инициализируемых объектов.
// 
Процедура ИнициализацияГруппОбъектов(Владелец)

	СоздатьБазовыйЭлементДляОбъектовКонфигурации(Владелец, "КонстантыНабор", "КонстантыНабор", НСтр("ru='Набор констант'"), Перечисления.ТипыОбъектов.НаборКонстант);
	СоздатьБазовыйЭлементДляОбъектовКонфигурации(Владелец, "Число", "Число", "Число", Перечисления.ТипыОбъектов.Число);
	СоздатьБазовыйЭлементДляОбъектовКонфигурации(Владелец, "Строка", "Строка", "Строка", Перечисления.ТипыОбъектов.Строка);
	СоздатьБазовыйЭлементДляОбъектовКонфигурации(Владелец, "Дата", "Дата", "Дата", Перечисления.ТипыОбъектов.Дата);


	СоздатьБазовыйЭлементДляОбъектовКонфигурации(Владелец, "Булево", "Булево", "Булево", Перечисления.ТипыОбъектов.Булево);
	СоздатьБазовыйЭлементДляОбъектовКонфигурации(Владелец, "ХранилищеЗначения", "ХранилищеЗначения", НСтр("ru='Хранилище значения'"), Перечисления.ТипыОбъектов.ХранилищеЗначения);
	СоздатьБазовыйЭлементДляОбъектовКонфигурации(Владелец, "УникальныйИдентификатор", "УникальныйИдентификатор", НСтр("ru='Уникальный идентификатор'"), Перечисления.ТипыОбъектов.УникальныйИдентификатор);

КонецПроцедуры // ИнициализацияГруппОбъектов()

Функция СоздатьБазовыйЭлементДляОбъектовКонфигурации(Владелец, НаименованиеЭлемента, ИмяЭлемента = "", СинонимЭлемента = "", Тип = Неопределено)
	
	ЭлементКонфигурации = Справочники.Объекты.НайтиПоНаименованию(НаименованиеЭлемента, 1,, Владелец);
	
	Если ЭлементКонфигурации.Пустая() Тогда
		
		Если Тип = Неопределено Тогда
			НовыйЭлемент = Справочники.Объекты.СоздатьГруппу();
		Иначе
			НовыйЭлемент = Справочники.Объекты.СоздатьЭлемент();
		КонецЕсли;	

        НовыйЭлемент.Владелец     = Владелец;
        НовыйЭлемент.Имя          = ?(ПустаяСтрока(ИмяЭлемента), Справочники.Объекты.ПолучитьИмяГруппыОбъектовПоНаименованию(НаименованиеЭлемента), ИмяЭлемента);
		НовыйЭлемент.Наименование = НаименованиеЭлемента;
		НовыйЭлемент.Синоним      = ?(ПустаяСтрока(СинонимЭлемента), ИмяЭлемента, СинонимЭлемента);
		Если Тип <> Неопределено Тогда
			НовыйЭлемент.Тип = Тип;
		КонецЕсли;
		НовыйЭлемент.Записать();
		
		Возврат НовыйЭлемент.Ссылка;
		
	Иначе	
		
		Возврат ЭлементКонфигурации;
		
	КонецЕсли;	
	
КонецФункции

// Читает текст элемента и приводит значение к указанному типу
//
// Параметры:
//  Объект           - объект типа XMLЧтение, из которого происходит чтение
//  Тип              - тип получаемого значения
//  ИскатьПоСвойству - для ссылочных типов может быть указано свойство, по которому
//                     следует искать объект: "Код", "Наименование", <ИмяРеквизита>, "Имя" (предопределенного значения)
//
// Возвращаемое значение:
//  Значение xml-элемента, приведенное к соответствующему типу
//
Функция одЗначениеЭлемента(Объект, Знач Тип = Неопределено)
	Если Тип = Неопределено Тогда
		Тип = Тип("Строка");
	КонецЕсли;

	Значение = "";
	Имя      = Объект.ЛокальноеИмя;

	Пока Объект.Прочитать() Цикл
		ИмяУзла = Объект.ЛокальноеИмя;
		ТипУзла = Объект.ТипУзла;
		Если ТипУзла = ТипУзлаXML.Текст Тогда
			Значение = СокрП(Объект.Значение);
		ИначеЕсли (ИмяУзла = Имя) И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			Прервать;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат XMLЗначение(Тип, Значение);	
	
КонецФункции // одЗначениеЭлемента() 

// Читает значение атрибута по имени из указанного объекта, приводит значение
// к указанному примитивному типу
//
// Параметры:
//  Объект      - объект типа XMLЧтение, спозиционированный на начале элемента,
//                атрибут которого требуется получить
//  Тип         - Значение типа Тип. Тип атрибута. Если не передан, значит Строка
//  Имя         - Строка. Имя атрибута
//
// Возвращаемое значение:
//  Значение атрибута полученное по имени и приведенное к указанному типу
// 
Функция одАтрибут(Объект, Имя, Знач Тип = Неопределено)
	Если Тип = Неопределено Тогда
		Тип = Тип("Строка");
	КонецЕсли;
	СтрЗначение = СокрП(Объект.ПолучитьАтрибут(Имя));
	Если Не ПустаяСтрока(СтрЗначение) Тогда
		Возврат XMLЗначение(Тип, СтрЗначение);
	Иначе
		Если Тип = Тип("Строка") Тогда  // Строка
			Возврат ""; 
		ИначеЕсли Тип = Тип("Булево") Тогда
			Возврат Ложь;
		ИначеЕсли Тип = Тип("Число") Тогда
			Возврат 0;
		ИначеЕсли Тип = Тип("Дата") Тогда
			Возврат Дата("01.01.0001 00:00:00");
		КонецЕсли; 
	КонецЕсли; 
	
КонецФункции // одАтрибут() 

Функция одОписаниеТипа(ЗначениеТипа)

	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип(ЗначениеТипа));
	ОписаниеТипов = Новый ОписаниеТипов(МассивТипов);

	Возврат ОписаниеТипов;

КонецФункции // одОписаниеТипа()

// Пропускает узлы xml до конца указанного элемента (по умолчанию текущего)
//
// Параметры:
//  Объект   - объект типа XMLЧтение
//  Имя      - имя узла, до конца которого пропускаем элементы
// 
Процедура одПропустить(Объект, Имя="")

	КолвоВложений = 0; // количество одноименных вложений

	Если Имя = "" Тогда
		Имя = Объект.ЛокальноеИмя;	
	КонецЕсли; 
	
	Пока Объект.Прочитать() Цикл
		ИмяУзла = Объект.ЛокальноеИмя;
		ТипУзла = Объект.ТипУзла;
		Если ИмяУзла = Имя Тогда
			Если ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Если КолвоВложений = 0 Тогда
					Прервать;
				Иначе
					КолвоВложений = КолвоВложений - 1;
				КонецЕсли; 
			ИначеЕсли ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				КолвоВложений = КолвоВложений + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // одПропустить() 

