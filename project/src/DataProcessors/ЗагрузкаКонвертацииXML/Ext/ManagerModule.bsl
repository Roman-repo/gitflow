Функция ПолучитьИмяФайлаДляЧтенияДанных(ОбщиеПеременные, ФайлЗапакован, ФлагОшибки)
	ИмяФайлаДляЧтенияДанных = "";

	Файл = Новый Файл(ОбщиеПеременные.ИмяФайлаПравил);
	Если НЕ Файл.Существует() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не найден файл с именем'") + ": " + ОбщиеПеременные.ИмяФайлаПравил);
		ФлагОшибки = Истина;
	ИначеЕсли НЕ Файл.ЭтоФайл() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Файл является каталогом'") + ": " + ОбщиеПеременные.ИмяФайлаПравил);
		ФлагОшибки = Истина;
	КонецЕсли;
	Возврат ОбщиеПеременные.ИмяФайлаПравил;
КонецФункции

Функция ОпределитьОбъектКонфигурации(ИмяОбъекта, ОбщиеПеременные, Корреспондент = Ложь)
	Если НЕ ЗначениеЗаполнено(ИмяОбъекта) Тогда
		Возврат Справочники.Объекты.ПустаяСсылка();
	КонецЕсли;
	Если Корреспондент Тогда
		ТекКонфигурация = ОбщиеПеременные.КонфигурацияКорреспондент;
	Иначе
		ТекКонфигурация = ОбщиеПеременные.Конфигурация;
	КонецЕсли;
	ТекСсылка = Справочники.Объекты.НайтиПоНаименованию(ИмяОбъекта, Истина,,ТекКонфигурация);
	Если ЗначениеЗаполнено(ТекСсылка) Тогда
		Возврат ТекСсылка;
	КонецЕсли;
	// Создание нового объекта и пометка его на удаление.
	ТекОбъект = Справочники.Объекты.СоздатьЭлемент();
	ТекОбъект.ПометкаУдаления = Истина;
	ТекОбъект.Наименование = ИмяОбъекта;
	ТекОбъект.Владелец = ТекКонфигурация;
	ТекОбъект.Записать();
	Возврат ТекОбъект.Ссылка;
КонецФункции

Функция ОпределитьСвойствоКонфигурации(ИмяСвойства, ОбъектКонфигурации, ДанныеДляЗаполнения, СвойствоРодитель = Неопределено)
	Если НЕ ЗначениеЗаполнено(ИмяСвойства) Тогда
		Возврат Справочники.Свойства.ПустаяСсылка();
	КонецЕсли;
	СвойствоСсылка = Справочники.Свойства.ПустаяСсылка();
	ЗапросСвойство = Новый Запрос;
	ЗапросСвойство.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ Справочник.Свойства
	|ГДЕ Родитель = &Родитель И Владелец = &Владелец И (Наименование = &Наименование Или Наименование = &Наименование2)
	|	И ЭтоГруппа = &ЭтоГруппа 
	|УПОРЯДОЧИТЬ ПО ПометкаУдаления ВОЗР";
	ВидСсылкой = Перечисления.ВидыСвойств.ПустаяСсылка();
	Если ДанныеДляЗаполнения.Свойство("Вид") И ЗначениеЗаполнено(ДанныеДляЗаполнения.Вид) Тогда
		Попытка
			ВидСсылкой = Перечисления.ВидыСвойств[ДанныеДляЗаполнения.Вид];
		Исключение
			ВидСсылкой = Перечисления.ВидыСвойств.ПустаяСсылка();
		КонецПопытки;
		Если ЗначениеЗаполнено(ВидСсылкой) Тогда
			Если ВидСсылкой = Перечисления.ВидыСвойств.Свойство Или ВидСсылкой = Перечисления.ВидыСвойств.Реквизит Тогда
				Виды = Новый Массив;
				Виды.Добавить(Перечисления.ВидыСвойств.Реквизит);
				Виды.Добавить(Перечисления.ВидыСвойств.Свойство);
				ЗапросСвойство.УстановитьПараметр("Вид", Виды);

				ЗапросСвойство.Текст = СтрЗаменить(ЗапросСвойство.Текст, "ГДЕ", "ГДЕ Вид В (&Вид) И ");
			Иначе
				ЗапросСвойство.УстановитьПараметр("Вид", ВидСсылкой);
				ЗапросСвойство.Текст = СтрЗаменить(ЗапросСвойство.Текст, "ГДЕ", "ГДЕ Вид = &Вид И ");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	ЗапросСвойство.УстановитьПараметр("Родитель", ?(ЗначениеЗаполнено(СвойствоРодитель), СвойствоРодитель, Справочники.Свойства.ПустаяСсылка()));
	ЗапросСвойство.УстановитьПараметр("Владелец", ОбъектКонфигурации);
	Если ДанныеДляЗаполнения.ЭтоГруппа И (ВидСсылкой = Перечисления.ВидыСвойств.НаборДвиженийРегистраБухгалтерии
		Или ВидСсылкой = Перечисления.ВидыСвойств.НаборДвиженийРегистраНакопления
		Или ВидСсылкой = Перечисления.ВидыСвойств.НаборДвиженийРегистраРасчета
		Или ВидСсылкой = Перечисления.ВидыСвойств.НаборДвиженийРегистраСведений) Тогда
		Если СтрНайти(СокрЛП(ИмяСвойства), "{") = 0 Тогда
			ЗапросСвойство.УстановитьПараметр("Наименование", СокрЛП(ИмяСвойства));
			ЗапросСвойство.УстановитьПараметр("Наименование2", "{" + СокрЛП(ИмяСвойства) + "}"); 
			ИмяСвойства = "{" + СокрЛП(ИмяСвойства) + "}";
		Иначе
			Наименование2 = СтрЗаменить(СокрЛП(ИмяСвойства), "{", "");
			Наименование2 = СтрЗаменить(СокрЛП(Наименование2), "}", "");
			ЗапросСвойство.УстановитьПараметр("Наименование2", СокрЛП(ИмяСвойства));
			ЗапросСвойство.УстановитьПараметр("Наименование", Наименование2);
			ИмяСвойства = СокрЛП(ИмяСвойства); 
		КонецЕсли;
	Иначе
		ЗапросСвойство.УстановитьПараметр("Наименование", СокрЛП(ИмяСвойства));
		ЗапросСвойство.УстановитьПараметр("Наименование2", СокрЛП(ИмяСвойства));
		ИмяСвойства = СокрЛП(ИмяСвойства);
	КонецЕсли;


	ЗапросСвойство.УстановитьПараметр("ЭтоГруппа", ДанныеДляЗаполнения.ЭтоГруппа);
	ВыборкаСвойство = ЗапросСвойство.Выполнить().Выбрать();
	Если ВыборкаСвойство.Следующий() Тогда
		СвойствоСсылка = ВыборкаСвойство.Ссылка;
	КонецЕсли;
	Если ЗначениеЗаполнено(СвойствоСсылка) Тогда
		Возврат СвойствоСсылка;
	КонецЕсли;
	
	// Создаем новое свойство и помечаем на удаление (есть в правилах но нет в структуре метаданных).
	Если ДанныеДляЗаполнения.ЭтоГруппа Тогда
		СвойствоОбъект = Справочники.Свойства.СоздатьГруппу();
		Если ЗначениеЗаполнено(ВидСсылкой) Тогда
			СвойствоОбъект.Вид = ВидСсылкой;
		Иначе
			СвойствоОбъект.Вид = Перечисления.ВидыСвойств.ТабличнаяЧасть;
		КонецЕсли;
	Иначе
		СвойствоОбъект = Справочники.Свойства.СоздатьЭлемент();
		СвойствоОбъект.Вид = ВидСсылкой;
	КонецЕсли;
	СвойствоОбъект.Владелец = ОбъектКонфигурации;
	СвойствоОбъект.ПометкаУдаления = Истина;
	СвойствоОбъект.Родитель = СвойствоРодитель;
	СвойствоОбъект.Наименование = ИмяСвойства;
	Если ДанныеДляЗаполнения.Свойство("Тип") И ЗначениеЗаполнено(ДанныеДляЗаполнения.Тип) Тогда
		СвойствоОбъект.ТипыСтрокой = ДанныеДляЗаполнения.Тип;
	КонецЕсли;
	СвойствоОбъект.ОбменДанными.Загрузка = Истина;
	СвойствоОбъект.Записать();
	Возврат СвойствоОбъект.Ссылка;
КонецФункции
#КонецОбласти

#КонецЕсли
