#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("парКонвертация") Тогда
		Объект.Конвертация = Параметры.парКонвертация;
	КонецЕсли;
	ЭтоКонвертацияXDTO = Истина;
	Если ЗначениеЗаполнено(Объект.Конвертация) Тогда
		РеквизитыКонвертации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Конвертация, "Наименование, ТипКонвертации");
		НаименованиеКонвертации = РеквизитыКонвертации.Наименование;
		ЭтоКонвертацияXDTO = (РеквизитыКонвертации.ТипКонвертации = Перечисления.ТипыКонвертаций.XDTO);
	КонецЕсли;
	Если ЭтоКонвертацияXDTO Тогда
		Если ВерсияФорматаМенеджера = "1" Тогда
			Элементы.ФормаСохранитьМодуль.Видимость = Истина;
			Элементы.ПодменюСохранитьМодуль.Видимость = Ложь;
		Иначе
			СовместнаяРабота = Константы.СовместнаяРабота.Получить();
			Элементы.ФормаСохранитьМодуль.Видимость = НЕ СовместнаяРабота;
			Элементы.ПодменюСохранитьМодуль.Видимость = СовместнаяРабота;
		КонецЕсли;
	Иначе
		Элементы.ФормаСохранитьМодуль.Видимость = Ложь;
		Элементы.ПодменюСохранитьМодуль.Видимость = Ложь;
	КонецЕсли;
	СовместнаяРабота = Константы.СовместнаяРабота.Получить();
	РазделениеМодуля = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Конвертация, "ИспользоватьРазделениеМодуля");

	Заголовок = НаименованиеКонвертации;
	ВерсияФорматаМенеджера = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Конвертация, "ВерсияФорматаМенеджера"));
	ЗаполнитьДеревоГруппПравил();
	
	ОбновитьПараметрыСписков();
	ОбновитьПараметрыСписков_ГруппыПравил(); 
	ОбновитьТекстКнопкиВыгрузки();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.ПКО;
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ЗагрузкаАлгоритмов" Тогда
		Если Параметр.Отказ = Ложь 
			И Параметр.ИдентификаторФормы = УникальныйИдентификатор Тогда
			ЗагрузкаОбработчиковНаСервере();
			ПодключитьОбработчикОжидания("ОбработчикОжиданияДлительнойОперации", 10, Истина); 
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ИзмененСтатусЗахвата" Тогда
		Если ТипЗнч(ЭтаФорма.ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
			ЭтаФорма.ТекущийЭлемент.Обновить();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КонвертацияПриИзменении(Элемент)
	
	ЗаполнитьДеревоГруппПравил();
	ОбновитьПараметрыСписков();
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	ИмяТекущейСтраницы = Элементы.Страницы.ТекущаяСтраница.Имя;
	ИмяОбработчика = "";
	Если ИмяТекущейСтраницы = "ПОД" Тогда
		ИмяОбработчика = "ГруппыПравилПОДПриАктивизацииСтрокиОбработчикОжидания";
	ИначеЕсли ИмяТекущейСтраницы = "ПКО" Тогда
		ИмяОбработчика = "ГруппыПравилПКОПриАктивизацииСтрокиОбработчикОжидания";
	ИначеЕсли ИмяТекущейСтраницы = "ПКПД" Тогда
		ИмяОбработчика = "ГруппыПравилПКПДПриАктивизацииСтрокиОбработчикОжидания";
	ИначеЕсли ИмяТекущейСтраницы = "ГруппаАлгоритмы" Тогда
		ИмяОбработчика = "ГруппыПравилАлгоритмыПриАктивизацииСтрокиОбработчикОжидания";
	ИначеЕсли ИмяТекущейСтраницы = "ГруппаЗапросы" Тогда
		ИмяОбработчика = "ГруппыПравилЗапросыПриАктивизацииСтрокиОбработчикОжидания";  
	КонецЕсли;
	Если НЕ ПустаяСтрока(ИмяОбработчика) Тогда
		ПодключитьОбработчикОжидания(ИмяОбработчика, 0.1, Истина);
	КонецЕсли;
КонецПроцедуры

