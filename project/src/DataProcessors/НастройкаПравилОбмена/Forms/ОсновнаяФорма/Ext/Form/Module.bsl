&НаСервере
Процедура ЗагрузкаОбработчиковНаСервере()
	ИмяФайлаСведений = ПолучитьИмяВременногоФайла("txt");
	ТХДок = Новый ТекстовыйДокумент();
	ТХДок.ДобавитьСтроку(ДанныеБуфера);
	ТХДок.Записать(ИмяФайлаСведений);

	ПомещенныеФайлыДляПередачи = Новый Массив;
	ПараметрыФайла = Новый Структура("ПолноеИмя, Хранение, ЭтоРасширение", "", ИмяФайлаСведений, Ложь);
	ПомещенныеФайлыДляПередачи.Добавить(ПараметрыФайла);

	
	СтруктураПараметров = Новый Структура("ИсточникЗагрузки, ПомещенныеФайлы", 0, ПомещенныеФайлыДляПередачи); 
	СтруктураПараметров.Вставить("Конвертация", Объект.Конвертация);
	СтруктураПараметров.Вставить("СоздатьНовуюКонвертацию", Ложь); 
	СтруктураПараметров.Вставить("ИмяНовойКонвертации", "");
    СтруктураПараметров.Вставить("Конфигурация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Конвертация, "Конфигурация"));
	СтруктураПараметров.Вставить("ТолькоОбработчики", Истина); 
	СтруктураПараметров.Вставить("ИтерацияЗагрузки", 1); 
	
	Попытка
		ПараметрыФоновогоЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
		ПараметрыФоновогоЗадания.НаименованиеФоновогоЗадания = НСтр("ru = 'Загрузка обработчиков'");
		ПараметрыФоновогоЗадания.ЗапуститьВФоне = Истина;
		Результат = ДлительныеОперации.ВыполнитьВФоне("Обработки.ЗагрузкаМодуляМенеджера.ВыполнитьЗагрузкуМодуляМенеджера",
			СтруктураПараметров, ПараметрыФоновогоЗадания);
		АдресХранилищаРезультата = Результат.АдресРезультата;
		ДлительнаяОперация = Истина;
		ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	Исключение
		Ошибки = Ошибки + НСтр("ru = 'При загрузке модуля менеджера произошла ошибка'") + Символы.ПС + ОписаниеОшибки() + Символы.ПС;
		ЕстьОшибки = Истина;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаОбработчиков(Команда)
	Если РазделениеМодуля Тогда 
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Загрузка из буфера обмена невозможна для конвертации с разделением модуля.'")); 
		Возврат;
	КонецЕсли;
	КОбъект = Новый COMОбъект("htmlfile");
	ДанныеБуфера = КОбъект.ParentWindow.ClipboardData.Getdata("Text");
	// Результат проверки будет в обработке оповещения.
	КонвертацияДанныхXDTOКлиент.ПроверитьКонвертациюПриЗагрузкеАлгоритмов(ДанныеБуфера, Объект.Конвертация, 
									НаименованиеКонвертации, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВыделенные(Команда)
	ИмяСписка = "";
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.ПОД Тогда
		ИмяСписка = "ПравилаОбработкиДанных";
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ПКО Тогда
		ИмяСписка = "ПравилаКонвертацииОбъектов";
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ПКПД Тогда
		ИмяСписка = "ПравилаКонвертацииПредопределенныхДанных";
	ИначеЕсли Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаАлгоритмы Тогда
		ИмяСписка = "Алгоритмы";
	Иначе
		Возврат;
	КонецЕсли;
	
	ГрупповоеИзменениеОбъектовКлиент.ИзменитьВыделенные(Элементы[ИмяСписка]);
КонецПроцедуры

