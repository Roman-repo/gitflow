&НаСервере
Процедура ЗаполнитьДеревоГруппПравил()
	
	ГруппыПравил_ПКО.ПолучитьЭлементы().Очистить();
	ГруппыПравил_ПОД.ПолучитьЭлементы().Очистить();
	ГруппыПравил_Алгоритмы.ПолучитьЭлементы().Очистить();
	ГруппыПравил_ПКПД.ПолучитьЭлементы().Очистить();
	ГруппыПравил_Запросы.ПолучитьЭлементы().Очистить();

	Если Не ЗначениеЗаполнено(Объект.Конвертация) Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполняемыеГруппы = Новый Структура();
	ЗаполняемыеГруппы.Вставить("Алгоритмы", ГруппыПравил_Алгоритмы);
	ЗаполняемыеГруппы.Вставить("ПравилаКонвертацииОбъектов", ГруппыПравил_ПКО);
	ЗаполняемыеГруппы.Вставить("ПравилаКонвертацииПредопределенныхДанных", ГруппыПравил_ПКПД);
	ЗаполняемыеГруппы.Вставить("ПравилаОбработкиДанных", ГруппыПравил_ПОД);
	ЗаполняемыеГруппы.Вставить("Запросы", ГруппыПравил_Запросы);

	
	Для Каждого КлючИЗначение Из ЗаполняемыеГруппы Цикл
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Правила.ГруппаПравил КАК Группа
		|ИЗ
		|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник." + КлючИЗначение.Ключ + " КАК Правила
		|		ПО (Правила.Ссылка = СоставыКонвертаций.ЭлементКонвертации)
		|ГДЕ
		|	СоставыКонвертаций.Владелец = &Владелец");
		Запрос.УстановитьПараметр("Владелец", Объект.Конвертация);

	
		ТаблицаГруппыПравил = Запрос.Выполнить().Выгрузить();
		ТаблицаГруппыПравил.Свернуть("Группа");
		ТаблицаГруппыПравил.Сортировать("Группа");
		
		СтрокиДерева = Новый Соответствие;
		
		Корень = КлючИЗначение.Значение.ПолучитьЭлементы().Добавить();
		Корень.Наименование = НСтр("ru = '<Все правила>'");
		Корень.НаименованиеПоиска = НСтр("ru = '<Все правила>'");
		
		ДобавитьСтрокиДереваГруппПравил(ТаблицаГруппыПравил, Корень, СтрокиДерева);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиДереваГруппПравил(ТаблицаГруппыПравил, Корень, СтрокиДерева, Индекс = 0, Префикс = "")
	Если ТаблицаГруппыПравил.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СтрокаГруппыПравил = ТаблицаГруппыПравил[Индекс];
	
	Родитель  = Корень;
	ИмяГруппы = СтрокаГруппыПравил.Группа;
	
	Если Не ПустаяСтрока(Префикс) Тогда
		ИмяГруппы = СтрЗаменить(ИмяГруппы, Префикс + "\", "");
		Родитель  = СтрокиДерева[Префикс];
	КонецЕсли;
	
	Поз = СтрНайти(ИмяГруппы, "\");
	
	Если Поз = 0 Тогда
		ИмяДочернего = ИмяГруппы;
		ИмяПоиска = ИмяДочернего;
		
		Если Не ПустаяСтрока(Префикс) Тогда
			ИмяПоиска = Префикс + "\" + ИмяПоиска;
		КонецЕсли;
		
		Если ПустаяСтрока(ИмяДочернего) Тогда
			Дочерний = Родитель.ПолучитьЭлементы().Добавить();
			Дочерний.Наименование       = НСтр("ru = '<Без группы>'");
			Дочерний.НаименованиеПоиска = НСтр("ru = '<Без группы>'");
		Иначе
			Дочерний = Родитель.ПолучитьЭлементы().Добавить();
			Дочерний.Наименование       = ИмяДочернего;
			Дочерний.НаименованиеПоиска = ИмяПоиска;
		КонецЕсли;
		
		СтрокиДерева.Вставить(ИмяПоиска, Дочерний);
	Иначе
		ИмяДочернего = Лев(ИмяГруппы, Поз - 1);
		ИмяПоиска = ИмяДочернего;
		
		Если Не ПустаяСтрока(Префикс) Тогда
			ИмяПоиска = Префикс + "\" + ИмяПоиска;
		КонецЕсли;
		
		Если СтрокиДерева[ИмяПоиска] = Неопределено Тогда
			Дочерний = Родитель.ПолучитьЭлементы().Добавить();
			Дочерний.Наименование       = ИмяДочернего;
			Дочерний.НаименованиеПоиска = ИмяПоиска;
			
			СтрокиДерева.Вставить(ИмяПоиска, Дочерний);
		КонецЕсли;
		
		ДобавитьСтрокиДереваГруппПравил(ТаблицаГруппыПравил, Корень, СтрокиДерева, Индекс, ИмяПоиска);
		
		Возврат;
	КонецЕсли;
	
	Если Индекс < ТаблицаГруппыПравил.Количество() - 1 Тогда
		ДобавитьСтрокиДереваГруппПравил(ТаблицаГруппыПравил, Корень, СтрокиДерева, Индекс + 1);
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыСписков()
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	ПравилаОбработкиДанных.Параметры.УстановитьЗначениеПараметра("парКонвертация", Объект.Конвертация);
	ПравилаОбработкиДанных.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ТекущийПользователь);

	Алгоритмы.Параметры.УстановитьЗначениеПараметра("парКонвертация", Объект.Конвертация);
	Алгоритмы.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ТекущийПользователь);

	ПравилаКонвертацииОбъектов.Параметры.УстановитьЗначениеПараметра("парКонвертация", Объект.Конвертация);
	ПравилаКонвертацииОбъектов.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ТекущийПользователь);

	ПравилаКонвертацииПредопределенныхДанных.Параметры.УстановитьЗначениеПараметра("парКонвертация", Объект.Конвертация);
	ПравилаКонвертацииПредопределенныхДанных.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ТекущийПользователь);

	Запросы.Параметры.УстановитьЗначениеПараметра("парКонвертация", Объект.Конвертация);
	Запросы.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ТекущийПользователь);

КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыСписков_ГруппыПравил(ИмяТекущейСтраницы = "")
	ОбновитьВсе = (ИмяТекущейСтраницы = "");
	Если ОбновитьВсе Или ИмяТекущейСтраницы = "ПКО" Тогда
		НетОтбораПоГруппе = (ТекущаяГруппаПравилПКО = НСтр("ru = '<Все правила>'"));
		ПустаяГруппа      = (ТекущаяГруппаПравилПКО = НСтр("ru = '<Без группы>'"));
		ПравилаКонвертацииОбъектов.Параметры.УстановитьЗначениеПараметра("парГруппа",         ТекущаяГруппаПравилПКО + "%");
		ПравилаКонвертацииОбъектов.Параметры.УстановитьЗначениеПараметра("НетОтбораПоГруппе", НетОтбораПоГруппе);
		ПравилаКонвертацииОбъектов.Параметры.УстановитьЗначениеПараметра("ПустаяГруппа",      ПустаяГруппа);
	КонецЕсли;
	Если ОбновитьВсе Или ИмяТекущейСтраницы = "ГруппаАлгоритмы" Тогда
		НетОтбораПоГруппе = (ТекущаяГруппаПравилАлгоритмы = НСтр("ru = '<Все правила>'"));
		ПустаяГруппа      = (ТекущаяГруппаПравилАлгоритмы = НСтр("ru = '<Без группы>'"));
		Алгоритмы.Параметры.УстановитьЗначениеПараметра("парГруппа",         ТекущаяГруппаПравилАлгоритмы + "%");
		Алгоритмы.Параметры.УстановитьЗначениеПараметра("НетОтбораПоГруппе", НетОтбораПоГруппе);
		Алгоритмы.Параметры.УстановитьЗначениеПараметра("ПустаяГруппа",      ПустаяГруппа);
	КонецЕсли;
	Если ОбновитьВсе Или ИмяТекущейСтраницы = "ГруппаЗапросы" Тогда
		НетОтбораПоГруппе = (ТекущаяГруппаПравилЗапросы = НСтр("ru = '<Все правила>'"));
		ПустаяГруппа      = (ТекущаяГруппаПравилЗапросы = НСтр("ru = '<Без группы>'"));
		Запросы.Параметры.УстановитьЗначениеПараметра("парГруппа",         ТекущаяГруппаПравилЗапросы + "%");
		Запросы.Параметры.УстановитьЗначениеПараметра("НетОтбораПоГруппе", НетОтбораПоГруппе);
		Запросы.Параметры.УстановитьЗначениеПараметра("ПустаяГруппа",      ПустаяГруппа);
	КонецЕсли;
	Если ОбновитьВсе Или ИмяТекущейСтраницы = "ПОД" Тогда
		НетОтбораПоГруппе = (ТекущаяГруппаПравилПОД = НСтр("ru = '<Все правила>'"));
		ПустаяГруппа      = (ТекущаяГруппаПравилПОД = НСтр("ru = '<Без группы>'"));  	
		ПравилаОбработкиДанных.Параметры.УстановитьЗначениеПараметра("парГруппа",         ТекущаяГруппаПравилПОД + "%");
		ПравилаОбработкиДанных.Параметры.УстановитьЗначениеПараметра("НетОтбораПоГруппе", НетОтбораПоГруппе);
		ПравилаОбработкиДанных.Параметры.УстановитьЗначениеПараметра("ПустаяГруппа",      ПустаяГруппа);
	КонецЕсли;
	Если ОбновитьВсе Или ИмяТекущейСтраницы = "ПКПД" Тогда
		НетОтбораПоГруппе = (ТекущаяГруппаПравилПКПД = НСтр("ru = '<Все правила>'"));
		ПустаяГруппа      = (ТекущаяГруппаПравилПКПД = НСтр("ru = '<Без группы>'"));  	
		ПравилаКонвертацииПредопределенныхДанных.Параметры.УстановитьЗначениеПараметра("парГруппа",         ТекущаяГруппаПравилПКПД + "%");
		ПравилаКонвертацииПредопределенныхДанных.Параметры.УстановитьЗначениеПараметра("НетОтбораПоГруппе", НетОтбораПоГруппе);
		ПравилаКонвертацииПредопределенныхДанных.Параметры.УстановитьЗначениеПараметра("ПустаяГруппа",      ПустаяГруппа);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСправочника(ИмяСправочника, Отказ, Копирование, Группа, Ключ = Неопределено)
	
	Если Группа Или Копирование Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если Ключ <> Неопределено Тогда
		СтруктураПараметров = Новый Структура("Ключ", Ключ);
	Иначе
	
		СтруктураПараметров = Новый Структура("Конвертация", Объект.Конвертация);
		ТекущаяГруппаПравил = "";
		ИмяФормыЭлементаСпр = "ФормаЭлемента";

		Если ИмяСправочника = "ПравилаОбработкиДанных" Тогда
			ТекущаяГруппаПравил = ТекущаяГруппаПравилПОД;
		ИначеЕсли ИмяСправочника = "ПравилаКонвертацииОбъектов" Тогда
			ТекущаяГруппаПравил = ТекущаяГруппаПравилПКО;
		ИначеЕсли ИмяСправочника = "Алгоритмы" Тогда
			ТекущаяГруппаПравил = ТекущаяГруппаПравилАлгоритмы;
		ИначеЕсли ИмяСправочника = "ПравилаКонвертацииПредопределенныхДанных" Тогда			
			ТекущаяГруппаПравил = ТекущаяГруппаПравилПКПД;
		ИначеЕсли ИмяСправочника = "Запросы" Тогда
			ТекущаяГруппаПравил = ТекущаяГруппаПравилЗапросы;
		КонецЕсли;
			
		СтруктураПараметров.Вставить("ГруппаПравил", ТекущаяГруппаПравил);
			
	КонецЕсли;

	Если ИмяСправочника = "ПравилаКонвертацииПредопределенныхДанных" Тогда
		ИмяФормыЭлементаСпр = ?(ЭтоКонвертацияXDTO, "ФормаЭлементаXDTO", "ФормаЭлементаXML");
	Иначе
		ИмяФормыЭлементаСпр = "ФормаЭлемента";
	КонецЕсли;
	ОткрытьФорму("Справочник." + ИмяСправочника + ".Форма." + ИмяФормыЭлементаСпр,
		СтруктураПараметров);


КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьМодулиКлиент(ПоСостояниюХранилища) 
	Если НЕ ПроверитьЗаполненаКонвертация() Тогда
		Возврат;
	КонецЕсли;
	ИменаФайловДляСохранения = Новый Структура;
	НастройкиВыгрузки = Новый Структура;
	Модули = СохранитьМодульСервер(ПоСостояниюХранилища, ИменаФайловДляСохранения, НастройкиВыгрузки);
	Если Модули.Количество() = 1 И ИменаФайловДляСохранения.Количество() = 0 Тогда
		ТХ = Модули.МенеджерОбменаЧерезУниверсальныйФормат;
		КонвертацияДанныхXDTOКлиент.ВывестиТекстДляИспользования(ТХ);
	Иначе
		КонвертацияДанныхXDTOКлиент.СохранитьМодулиКонвертацииВФайлы(Модули, НастройкиВыгрузки, ИменаФайловДляСохранения);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СохранитьМодульСервер(ПоСостояниюХранилища, ИменаФайловДляСохранения, НастройкиВыгрузки)
	Обработки.ВыгрузкаМодуля.ПодготовитьНастройкиВыгрузкиМодулей(Объект.Конвертация, ИменаФайловДляСохранения, НастройкиВыгрузки);
	Если ВерсияФорматаМенеджера = "1" Тогда
		ОбработкаОбъект = Обработки.УдалитьВыгрузкаМодуля_3_0_7.Создать();
		ОбработкаОбъект.Конвертация = Объект.Конвертация;
		Результат = Новый Структура("МенеджерОбменаЧерезУниверсальныйФормат" ,ОбработкаОбъект.ВыполнитьВыгрузкуМодулей());
	Иначе
		ОбработкаОбъект = Обработки.ВыгрузкаМодуля.Создать();
		ОбработкаОбъект.ПоСостояниюХранилища = ПоСостояниюХранилища;
		ОбработкаОбъект.Конвертация = Объект.Конвертация;
		Результат = ОбработкаОбъект.ВыполнитьВыгрузкуМодулей();
	КонецЕсли;
	Возврат Результат;
КонецФункции

