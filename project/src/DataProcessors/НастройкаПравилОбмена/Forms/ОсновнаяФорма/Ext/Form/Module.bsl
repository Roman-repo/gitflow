&НаКлиенте
Процедура ПерейтиКПКО(Команда)
	Если Элементы.Страницы.ТекущаяСтраница <> Элементы.ПОД Тогда
		Возврат;
	КонецЕсли;
	ТекПОД = Элементы.ПравилаОбработкиДанных.ТекущаяСтрока;
	Если НЕ ЗначениеЗаполнено(ТекПОД) Тогда
		Возврат;
	КонецЕсли;
	ТекПКО = ПолучитьПКО(ТекПОД);
	Если НЕ ЗначениеЗаполнено(ТекПКО) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ТекПКО) = Тип("Массив") Тогда
		ОткрытьФормуВыбораПКО(ТекПКО);
		Возврат;
	КонецЕсли;
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.ПКО;
	Элементы.ПравилаКонвертацииОбъектов.ТекущаяСтрока = ТекПКО;
КонецПроцедуры

&НаСервере
Функция ПолучитьПКО(ТекПОД)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Конвертация", Объект.Конвертация);
	Запрос.УстановитьПараметр("ПОД", ТекПОД);
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПКО.Ссылка КАК Ссылка
		|ИЗ Справочник.ПравилаКонвертацииОбъектов КАК ПКО
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Справочник.СоставыКонвертаций КАК Состав
		|ПО Состав.Владелец = &Конвертация
		|	И Состав.ЭлементКонвертации = ПКО.Ссылка
		|	И Состав.Отключить = ЛОЖЬ
		|ГДЕ ПКО.Код = &ИмяПКО";
	Если ЗначениеЗаполнено(ТекПОД.ПравилоКонвертацииОбъекта) Тогда
		Запрос.УстановитьПараметр("ИмяПКО", ТекПОД.ПравилоКонвертацииОбъекта);
	ИначеЕсли ТекПОД.ПравилаКонвертацииОбъектов.Количество() = 1 Тогда
		Запрос.УстановитьПараметр("ИмяПКО", ТекПОД.ПравилаКонвертацииОбъектов[0].ПравилоКонвертацииОбъекта);
	ИначеЕсли ТекПОД.ПравилаКонвертацииОбъектов.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='В текущем правиле обработки данных не указано правило конвертации объекта'"));
		Возврат Неопределено;
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПКО.Ссылка КАК Ссылка
		|ИЗ Справочник.ПравилаКонвертацииОбъектов КАК ПКО
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Справочник.СоставыКонвертаций КАК Состав
		|	ПО Состав.Владелец = &Конвертация
		|	И Состав.ЭлементКонвертации = ПКО.Ссылка
		|	И Состав.Отключить = ЛОЖЬ
		|ГДЕ ПКО.Код В (ВЫБРАТЬ РАЗЛИЧНЫЕ ПравилоКонвертацииОбъекта
		|					ИЗ Справочник.ПравилаОбработкиДанных.ПравилаКонвертацииОбъектов
		|					ГДЕ Ссылка = &ПОД)";
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	Иначе
		МассивПКО = Новый Массив;
		Пока Выборка.Следующий() Цикл
			МассивПКО.Добавить(Выборка.Ссылка);
		КонецЦикла;
		Возврат МассивПКО;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуВыбораПКО(МассивПКО)
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Ссылка, Конвертация",МассивПКО, Объект.Конвертация));
	ОписаниеОповещенияОВыборе = Новый ОписаниеОповещения("ОбработатьВыборПКО",ЭтотОбъект);
	ОткрытьФорму("Справочник.ПравилаКонвертацииОбъектов.ФормаВыбора", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОВыборе, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборПКО(РезультатЗакрытияФормы, ДопПараметры) Экспорт
	Если ТипЗнч(РезультатЗакрытияФормы) = Тип("СправочникСсылка.ПравилаКонвертацииОбъектов")
		И ЗначениеЗаполнено(РезультатЗакрытияФормы) Тогда
			Элементы.Страницы.ТекущаяСтраница = Элементы.ПКО;
			Элементы.ПравилаКонвертацииОбъектов.ТекущаяСтрока = РезультатЗакрытияФормы;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	Элементы.ФормаВыгрузкаКонвертацииXML.Видимость = НЕ ЭтоКонвертацияXDTO;

	Элементы.ФормаЗагрузкаОбработчиков.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ПравилаОбработкиДанныхИспользоватьДляОтправки.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ПравилаОбработкиДанныхИспользоватьДляПолучения.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ГруппаЗапросы.Видимость = НЕ ЭтоКонвертацияXDTO;
	
	// ПКО
	Элементы.ПравилаКонвертацииОбъектовИспользоватьДляОтправки.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ПравилаКонвертацииОбъектовИспользоватьДляПолучения.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ПравилаКонвертацииОбъектовОбъектФормата.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ПравилаКонвертацииОбъектовОбъектКонфигурацииКорреспондент.Видимость = НЕ ЭтоКонвертацияXDTO;
	// ПКПД
	Элементы.ПравилаКонвертацииПредопределенныхДанныхИспользоватьДляОтправки.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ПравилаКонвертацииПредопределенныхДанныхИспользоватьДляПолучения.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ПравилаКонвертацииПредопределенныхДанныхОбъектФормата.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ПравилаКонвертацииПредопределенныхДанныхОбъектКонфигурацииКорреспондент.Видимость = НЕ ЭтоКонвертацияXDTO;
	// Заголовки.
	Если НЕ ЭтоКонвертацияXDTO Тогда
		Элементы.ПОД.Заголовок = НСтр("ru='Правила выгрузки данных'");
		Элементы.ПравилаКонвертацииОбъектовОбъектКонфигурации.Заголовок = НСтр("ru='Источник'");
		Элементы.ПравилаКонвертацииПредопределенныхДанныхОбъектКонфигурации.Заголовок = НСтр("ru='Источник'");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполненаКонвертация()
	Если НЕ ЗначениеЗаполнено(Объект.Конвертация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не указана конвертация'"));
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ГруппыПравилПеретаскиваниеОбработчикОжидания()
	 // Поиск в новом дереве.
	 Если Перетаскивание_Где = "ГруппыПравил_ПОД" Тогда
		 СтрокиДереваВсе = ГруппыПравил_ПОД.ПолучитьЭлементы();
		 ИмяСправочника = "ПравилаОбработкиДанных";
	 ИначеЕсли Перетаскивание_Где = "ГруппыПравил_ПКО" Тогда
		 СтрокиДереваВсе = ГруппыПравил_ПКО.ПолучитьЭлементы();
		 ИмяСправочника = "ПравилаКонвертацииОбъектов";
	 ИначеЕсли Перетаскивание_Где = "ГруппыПравил_ПКПД" Тогда
		 СтрокиДереваВсе = ГруппыПравил_ПКПД.ПолучитьЭлементы();
		 ИмяСправочника = "ПравилаКонвертацииПредопределенныхДанных";
	 ИначеЕсли Перетаскивание_Где = "ГруппыПравил_Запросы" Тогда
		 СтрокиДереваВсе = ГруппыПравил_Запросы.ПолучитьЭлементы();
		 ИмяСправочника = "Запросы";
	 ИначеЕсли Перетаскивание_Где = "ГруппыПравил_Алгоритмы" Тогда
		 СтрокиДереваВсе = ГруппыПравил_Алгоритмы.ПолучитьЭлементы();
		 ИмяСправочника = "Алгоритмы";
	 Иначе
		 Возврат;
	 КонецЕсли;
	 СтрокаДереваПослеПеретаскивания = НайтиПоНаименованиюПоиска(СтрокиДереваВсе);
	 Если СтрокаДереваПослеПеретаскивания = Неопределено Тогда
		 Возврат;
	 КонецЕсли;
	 ГруппаИсходная = СтрокаДереваПослеПеретаскивания.НаименованиеПоиска;
	 ГруппаНовая = СтрокаДереваПослеПеретаскивания.Наименование;
	 ТекРодитель = СтрокаДереваПослеПеретаскивания.ПолучитьРодителя();
	 Пока ТекРодитель <> Неопределено Цикл
		 Если ТекРодитель.Наименование = "<Все правила>"
			 Или ТекРодитель.Наименование = "<Без группы>" Тогда
			 Прервать;
		 КонецЕсли;
		 ГруппаНовая = ТекРодитель.Наименование + "\" + ГруппаНовая;
		 ТекРодитель = ТекРодитель.ПолучитьРодителя();
	 КонецЦикла;
	 Если ГруппаИсходная <> ГруппаНовая Тогда
		 ПерезаполнитьГруппуПравил(ГруппаИсходная, ГруппаНовая, ИмяСправочника);
	 КонецЕсли;
	 СтрокаДереваПослеПеретаскивания.НаименованиеПоиска = ГруппаНовая;
	 
 КонецПроцедуры
 
&НаКлиенте 
Функция НайтиПоНаименованиюПоиска(СтрокиДерева)
	Для Каждого Строка Из СтрокиДерева Цикл
		Если Строка.НаименованиеПоиска = Перетаскивание_Что Тогда
			 Возврат Строка;
		Иначе
			 Результат = НайтиПоНаименованиюПоиска(Строка.ПолучитьЭлементы());
			 Если Результат <> Неопределено Тогда
				 Возврат Результат;
			 КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецФункции

&НаСервере
Процедура ПерезаполнитьГруппуПравил(ГруппаИсходная, ГруппаНовая, ИмяСправочника)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Правила.Ссылка КАК Ссылка
	|ИЗ
	|Справочник." + ИмяСправочника + " КАК Правила
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоставыКонвертаций КАК СоставКонвертации
	|	ПО (СоставКонвертации.ЭлементКонвертации = Правила.Ссылка)
	|		И (СоставКонвертации.Владелец = &ПарКонвертация)
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СовместнаяРаботаСОбъектами.СрезПоследних КАК ДанныеЗахвата_Мои
	|	ПО Правила.Ссылка = ДанныеЗахвата_Мои.Объект
	|	И ДанныеЗахвата_Мои.Действие = ЗНАЧЕНИЕ(Перечисление.ДействияПриСовместнойРаботе.Захват)
	|	И ДанныеЗахвата_Мои.Пользователь = &ТекущийПользователь
	|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СовместнаяРаботаСОбъектами.СрезПоследних КАК ДанныеЗахвата_Чужие
	|	ПО Правила.Ссылка = ДанныеЗахвата_Чужие.РабочаяКопия
	|	И ДанныеЗахвата_Чужие.Действие = ЗНАЧЕНИЕ(Перечисление.ДействияПриСовместнойРаботе.Захват)
	|	И ДанныеЗахвата_Чужие.Пользователь <> &ТекущийПользователь
	|ГДЕ
	|	Правила.ГруппаПравил ПОДОБНО &парГруппа
	|	И ( НЕ Правила.Захвачен
	|	ИЛИ (ДанныеЗахвата_Мои.Пользователь Is not null И НЕ Правила.Копия)
	|	ИЛИ (ДанныеЗахвата_Чужие.Пользователь Is not null И Правила.Копия)
	|	)";
	Запрос.УстановитьПараметр("парГруппа", ГруппаИсходная);
	Запрос.УстановитьПараметр("ПарКонвертация", Объект.Конвертация);
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.ТекущийПользователь());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СпрОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СпрОбъект.ГруппаПравил = ГруппаНовая;
		СпрОбъект.Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьТекстКнопкиВыгрузки()
	Результат = Обработки.ВыгрузкаМодуля.ПолучитьТекстЗаголовкаКомандыВыгрузкиМодуля(Объект.Конвертация);
	Элементы.ФормаСохранитьМодуль.Заголовок = Результат.ЗаголовокКоманды;
	Элементы.ПодменюСохранитьМодуль.Заголовок = Результат.ЗаголовокКоманды;
	Элементы.ПодменюСохранитьМодуль.Подсказка = Результат.Подсказка;
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикОжиданияДлительнойОперации()
	Если ДлительнаяОперацияВыполнена() Тогда
		ДлительнаяОперация = Ложь;
		ПодключитьОбработчикОжидания("ОкончаниеЗагрузки", 1, Истина);  
	Иначе
		ПодключитьОбработчикОжидания("ОбработчикОжиданияДлительнойОперации", 5, Истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ДлительнаяОперацияВыполнена()
	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
КонецФункции

&НаКлиенте
Процедура ОкончаниеЗагрузки() 
	РезультатЗагрузки = ПолучитьИзВременногоХранилища(АдресХранилищаРезультата);
	ДлительнаяОперация = Ложь;
	Если РезультатЗагрузки.Успешно Тогда
		Если РезультатЗагрузки.Свойство("СообщениеОРезультате") И ЗНачениеЗаполнено(РезультатЗагрузки.СообщениеОРезультате) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатЗагрузки.СообщениеОРезультате);
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'При загрузке обработчиков произошли ошибки'") + Символы.ПС + РезультатЗагрузки.Ошибки);
	КонецЕсли;
КонецПроцедуры


