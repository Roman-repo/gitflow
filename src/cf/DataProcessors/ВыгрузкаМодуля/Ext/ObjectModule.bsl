	|УНИЧТОЖИТЬ ТабПКС_ТЧ";
	
	ЗапросПКО.УстановитьПараметр("Конвертация", Конвертация);
	ЗапросПКО.УстановитьПараметр("Конфигурация", ПараметрыМодуля.Релиз);

	РезультатЗапроса = ЗапросПКО.ВыполнитьПакет();
	ТабСвойстваИзРасширений = РезультатЗапроса[1].Выгрузить();
	ВыборкаПоНаправлению = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СоответствиеТеги = Новый Соответствие;
	
	Пока ВыборкаПоНаправлению.Следующий() Цикл 
		Если ВыборкаПоНаправлению.Направление = 0 Тогда
			ТелоПроцедуры = ПараметрыМодуля.ПКО_Отправка;
		ИначеЕсли ВыборкаПоНаправлению.Направление = 1 Тогда
			ТелоПроцедуры = ПараметрыМодуля.ПКО_Получение;
		Иначе
			ТелоПроцедуры = ПараметрыМодуля.ПКО_ОтправкаИПолучение;
		КонецЕсли;
	
		ВыборкаДетальная = ВыборкаПоНаправлению.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
			ТегиДляПравила = ПолучитьТегиДляПравила(ВыборкаДетальная.Правило, ПараметрыМодуля);
			СоответствиеТеги.Вставить(ВыборкаДетальная.Правило, ТегиДляПравила);
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегОткрытие) Тогда
				ТелоПроцедуры.ДобавитьСтроку(ТегиДляПравила.ТегОткрытие);
			КонецЕсли;

			Строка = ПараметрыМодуля.ПрефиксВызоваОбработчика + "ДобавитьПКО_" + ВыборкаДетальная.Код + "(ПравилаКонвертации);";
			ТелоПроцедуры.ДобавитьСтроку(Строка);
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегЗакрытие) Тогда
				ТелоПроцедуры.ДобавитьСтроку(ТегиДляПравила.ТегЗакрытие);
			КонецЕсли;
		КонецЦикла;
		Если ВыборкаПоНаправлению.Направление = 0 Тогда
			ПараметрыМодуля.ПКО_Отправка = ТелоПроцедуры;
		ИначеЕсли ВыборкаПоНаправлению.Направление = 1 Тогда
			ПараметрыМодуля.ПКО_Получение = ТелоПроцедуры;
		Иначе
			ПараметрыМодуля.ПКО_ОтправкаИПолучение = ТелоПроцедуры;
		КонецЕсли;
	КонецЦикла;
	
	ТабПКС = РезультатЗапроса[4].Выгрузить();
	ТабПКС.Индексы.Добавить("ПравилоКонвертацииОбъекта");
	
	ТабПКС_ТЧСвод = РезультатЗапроса[6].Выгрузить();
	ТабПКС_ТЧСвод.Индексы.Добавить("ПравилоКонвертацииОбъекта");
	
	ТабПКС_ТЧ = РезультатЗапроса[7].Выгрузить();
	ТабПКС_ТЧ.Индексы.Добавить("ПравилоКонвертацииОбъекта");
	ТабПКС_ТЧ.Индексы.Добавить("ГруппаСвойствФормата");
	ТабПКС_ТЧ.Индексы.Добавить("ГруппаСвойствКонфигурации");
	ТабПКС_ТЧ.Индексы.Добавить("ГруппаСвойствКонфигурацииСтрокой");

	
	ТабПолейПоиска = РезультатЗапроса[8].Выгрузить();
	ТабПолейПоиска.Индексы.Добавить("ПравилоКонвертацииОбъекта");
	
	ВыборкаПоГруппе = РезультатЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоГруппе.Следующий() Цикл
		ОбластьГруппаТекст = "";
		ТекГруппаПравил = ВыборкаПоГруппе.ГруппаПравил;
		ПривестиИмяГруппыПравил(ТекГруппаПравил);

		ВыборкаДетальная = ВыборкаПоГруппе.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
			ТегиДляПравила = СоответствиеТеги.Получить(ВыборкаДетальная.Ссылка);
			КоллекцияПКС = ТабПКС.НайтиСтроки(Новый Структура("ПравилоКонвертацииОбъекта", ВыборкаДетальная.Ссылка));
			КоллекцияПКС_ТЧ = ТабПКС_ТЧСвод.НайтиСтроки(Новый Структура("ПравилоКонвертацииОбъекта", ВыборкаДетальная.Ссылка));
			КоллекцияПолейПоиска = ТабПолейПоиска.НайтиСтроки(Новый Структура("ПравилоКонвертацииОбъекта", ВыборкаДетальная.Ссылка));

			ОбластьПКОТекст = ПолучитьОбластьСТекстомПКО(ПараметрыМодуля, ВыборкаДетальная, ВыборкаПоГруппе.Направление, КоллекцияПКС, КоллекцияПКС_ТЧ, ТабПКС_ТЧ, КоллекцияПолейПоиска, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила);
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегОткрытие) Тогда
				ОбластьПКОТекст = ТегиДляПравила.ТегОткрытие + Символы.ПС + ОбластьПКОТекст;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегЗакрытие) Тогда
				ОбластьПКОТекст = ОбластьПКОТекст + Символы.ПС + ТегиДляПравила.ТегЗакрытие;
			КонецЕсли;
			Если ОбластьГруппаТекст = "" Тогда
				ОбластьГруппаТекст = ОбластьПКОТекст;
			Иначе
				ОбластьГруппаТекст = ОбластьГруппаТекст + Символы.ПС + ОбластьПКОТекст;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ПустаяСтрока(ТекГруппаПравил)
			И НЕ ПредопределеннаяГруппаПравил(ТекГруппаПравил) Тогда
			Если ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам_ПКО.Свойство(ТекГруппаПравил) Тогда
				ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам_ПКО[ТекГруппаПравил].ДобавитьСтроку(ОбластьГруппаТекст);
			Иначе
				РазделПравил = Новый ТекстовыйДокумент;
				РазделПравил.ДобавитьСтроку(ОбластьГруппаТекст);
				ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам_ПКО.Вставить(ТекГруппаПравил, РазделПравил);
			КонецЕсли;
		Иначе
			ТекстыПоГруппам.СлужебныеПроцедурыИФункции_ПКО.ДобавитьСтроку(ОбластьГруппаТекст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьОбластьСТекстомПКО(ПараметрыМодуля, ВыборкаДетальная, Направление, КоллекцияПКС_Шапка, КоллекцияПКС_ТЧ, ТабПКС_ТЧ, КоллекцияПолейПоиска, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила)
	ИспользоватьТэг = Ложь; 
	ТекущийТэг = "";
	ПостфиксЗаголовкаОбработчика = "";
	Если ПараметрыМодуля.ИспользоватьРазделениеМодуля Тогда
		ПостфиксЗаголовкаОбработчика = " Экспорт"; 
	КонецЕсли;
	ИмяОбластиПКО = "";
	// Для корректного выравнивания в процедурах заполнения ПКО используются разные области.
	Если ВыборкаДетальная.ИспользоватьДляПолучения Тогда
		ИмяОбластиПКО = "ПКО_ЕстьПолучение";
	Иначе
		ИмяОбластиПКО = "ПКО_ТолькоОтправка";
	КонецЕсли;
	ОбластьПКОТекст = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть(ИмяОбластиПКО).ПолучитьТекст();
	ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "#Область " + ИмяОбластиПКО + Символы.ПС, "");
	ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&КонецОбласти" + Символы.ПС, "#КонецОбласти");
	
	ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ОбъявлениеОбласти", "#Область " + СокрЛП(ВыборкаДетальная.Код));
	ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ИмяПКО", СокрЛП(ВыборкаДетальная.Код));
	ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&Постфикс", ПостфиксЗаголовкаОбработчика);
	
	ОбъектДанных = ПолучитьТипМетаданные(ВыборкаДетальная.ТипДанных, ВыборкаДетальная.ОбъектКонфигурации);
	ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ОбъектДанных", ОбъектДанных);
	
	ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ОбъектФормата", СокрЛП(ВыборкаДетальная.ОбъектФормата));
	Если ПараметрыМодуля.ЗапретитьПереводИменОбъектовФормата Тогда
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ТегЗапретПеревода", " //@NON-NLS-1");
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ТегЗапретПеревода", "");
	КонецЕсли;
	Если ВыборкаДетальная.ПравилоДляГруппыСправочника Тогда
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПравилоДляГруппыСправочника","Истина");
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПравилоДляГруппыСправочника", "---");
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыборкаДетальная.ПриОтправкеДанных)
		И ВыборкаДетальная.ИспользоватьДляОтправки	Тогда
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПриОтправкеДанных",
			"ПКО_" + СокрЛП(ВыборкаДетальная.Код) + "_ПриОтправкеДанных");
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПриОтправкеДанных", "---");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаДетальная.ПриКонвертацииДанныхXDTO)
		И ВыборкаДетальная.ИспользоватьДляПолучения Тогда
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПриКонвертацииДанныхXDTO",
			"ПКО_" + СокрЛП(ВыборкаДетальная.Код) + "_ПриКонвертацииДанныхXDTO");
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПриКонвертацииДанныхXDTO", "---");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаДетальная.ПередЗаписьюПолученныхДанных)
		И ВыборкаДетальная.ИспользоватьДляПолучения Тогда
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПередЗаписьюПолученныхДанных",
			"ПКО_" + СокрЛП(ВыборкаДетальная.Код) + "_ПередЗаписьюПолученныхДанных");
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПередЗаписьюПолученныхДанных", "---");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаДетальная.ПослеЗагрузкиВсехДанных_Код)
		И ВыборкаДетальная.ИспользоватьДляПолучения Тогда
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПослеЗагрузкиВсехДанных", СокрЛП(ВыборкаДетальная.ПослеЗагрузкиВсехДанных_Код));
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ПослеЗагрузкиВсехДанных", "---");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаДетальная.ВариантИдентификации)
		И ВыборкаДетальная.ИспользоватьДляПолучения Тогда
		ВариантИдентификацииСтрокой = Метаданные.Перечисления.ВариантыИдентификацииОбъектов.ЗначенияПеречисления.Получить(
			Перечисления.ВариантыИдентификацииОбъектов.Индекс(ВыборкаДетальная.ВариантИдентификации)).Имя;
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ВариантИдентификации", ВариантИдентификацииСтрокой);
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ВариантИдентификации", "---");
	КонецЕсли;
	
	МассивПространстваИмен = Новый Массив;
	
	ЗаполнениеПКС = Новый ТекстовыйДокумент;
	Если КоллекцияПКС_Шапка.Количество() > 0 Тогда
		ЗаполнениеПКС.ДобавитьСтроку("СвойстваШапки = ПравилоКонвертации.Свойства;");
		МаксДлинаСвойствоКонфигурации = 0;
		// Вычисление максимальной длины свойств для выравнивания.
		Для Каждого Строка Из КоллекцияПКС_Шапка Цикл
			ИмяСвойстваКонфигурации = СокрЛП(Строка.СвойствоКонфигурации);
			Если СтрДлина(ИмяСвойстваКонфигурации) > МаксДлинаСвойствоКонфигурации Тогда
				МаксДлинаСвойствоКонфигурации = СтрДлина(ИмяСвойстваКонфигурации);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Строка Из КоллекцияПКС_Шапка Цикл
			ИмяСвойстваКонфигурации = СокрЛП(Строка.СвойствоКонфигурации);
			Если ПустаяСтрока(ИмяСвойстваКонфигурации) И ПустаяСтрока(СокрЛП(Строка.СвойствоФормата)) Тогда
				Продолжить;
			КонецЕсли;
			ОтступСвойствоФормата = "";
			Для СчетчикПробелов = 1 По МаксДлинаСвойствоКонфигурации - СтрДлина(СокрЛП(Строка.СвойствоКонфигурации)) Цикл
				ОтступСвойствоФормата = ОтступСвойствоФормата + " ";
			КонецЦикла;
			ПараметрИспользуетсяАлгоритм = ?(Строка.ИспользуетсяАлгоритмКонвертации,"1","");
			СтрокаДобавлениеПКС = "ДобавитьПКС(СвойстваШапки, "  
							+ """" + ИмяСвойстваКонфигурации + """, " + ОтступСвойствоФормата
							+ """" + СокрЛП(Строка.СвойствоФормата) + """";
			Если НЕ ПустаяСтрока(ПараметрИспользуетсяАлгоритм) Или НЕ ПустаяСтрока(Строка.ПравилоКонвертацииСвойства)
					Или НЕ ПустаяСтрока(Строка.ПространствоИмен) Тогда
				СтрокаДобавлениеПКС = СтрокаДобавлениеПКС + ", " + ?(ПустаяСтрока(ПараметрИспользуетсяАлгоритм),"",ПараметрИспользуетсяАлгоритм);
				СтрокаДобавлениеПКС = СтрокаДобавлениеПКС + ", " + ?(ПустаяСтрока(Строка.ПравилоКонвертацииСвойства),"",
								"""" + СокрЛП(Строка.ПравилоКонвертацииСвойства) + """");
				СтрокаДобавлениеПКС = СтрокаДобавлениеПКС + ?(ПустаяСтрока(Строка.ПространствоИмен),"",
								", """ + СокрЛП(Строка.ПространствоИмен) + """");
				Если НЕ ПустаяСтрока(Строка.ПространствоИмен) И МассивПространстваИмен.Найти(СокрЛП(Строка.ПространствоИмен)) = Неопределено Тогда
					МассивПространстваИмен.Добавить(СокрЛП(Строка.ПространствоИмен));
				КонецЕсли;
				// Убрать возможные лишние запятые
				ЛишнихЗнаков = 0;
				Если Прав(СтрокаДобавлениеПКС, 6) = ", , , " Тогда
					ЛишнихЗнаков = 6;
				ИначеЕсли Прав(СтрокаДобавлениеПКС, 4) = ", , " Тогда
					ЛишнихЗнаков = 4;
				ИначеЕсли Прав(СтрокаДобавлениеПКС, 2) = ", " Тогда
					ЛишнихЗнаков = 2;
				КонецЕсли;
				Если ЛишнихЗнаков > 0 Тогда
					СтрокаДобавлениеПКС = Лев(СтрокаДобавлениеПКС, СтрДлина(СтрокаДобавлениеПКС) - ЛишнихЗнаков);
				КонецЕсли;
			КонецЕсли;
			СтрокаДобавлениеПКС = СтрокаДобавлениеПКС + ");";
			ЗаполнениеПКС.ДобавитьСтроку(СтрокаДобавлениеПКС);
		КонецЦикла;
		ЗаполнениеПКСТекст = ДобавитьОтступыВСтроку(ЗаполнениеПКС.ПолучитьТекст());
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ЗаполнениеПКС", ЗаполнениеПКСТекст);
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ЗаполнениеПКС", "---");
	КонецЕсли;
	
	ЗаполнениеПКС = Новый ТекстовыйДокумент;
	Если КоллекцияПКС_ТЧ.Количество() > 0 Тогда

		ТаблицаГруппировок = Новый ТаблицаЗначений;
		ТаблицаГруппировок.Колонки.Добавить("ГруппаСвойствФормата");
		ТаблицаГруппировок.Колонки.Добавить("ГруппаСвойствКонфигурации");
		ТаблицаГруппировок.Колонки.Добавить("ГруппаСвойствКонфигурацииСтрокой");
		ТаблицаГруппировок.Колонки.Добавить("ПрямаяКонвертация");
		ТаблицаГруппировок.Колонки.Добавить("ПространствоИмен");
		МаксДлинаИмяТЧКонфигурации = 0;
		Для Каждого Строка_ТЧ Из КоллекцияПКС_ТЧ Цикл
			СтрокаГруппировки = ТаблицаГруппировок.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаГруппировки, Строка_ТЧ);
			ИмяГруппы = ?(ЗначениеЗаполнено(СтрокаГруппировки.ГруппаСвойствКонфигурации), СокрЛП(СтрокаГруппировки.ГруппаСвойствКонфигурации), СокрЛП(СтрокаГруппировки.ГруппаСвойствКонфигурацииСтрокой));
			Если СтрДлина(ИмяГруппы) > МаксДлинаИмяТЧКонфигурации Тогда
				МаксДлинаИмяТЧКонфигурации = СтрДлина(ИмяГруппы);
			КонецЕсли;
		КонецЦикла;
		ИмяКлючевойГруппы = "";
		ИмяКлючевогоСвойства = "";
		Если Направление = 0 Тогда
			ИмяКлючевойГруппы = "ГруппаСвойствФормата";
			ИмяКлючевогоСвойства = "СвойствоФормата";
			ТаблицаГруппировок.Сортировать("ГруппаСвойствФормата, ПрямаяКонвертация убыв");
		ИначеЕсли Направление = 1 Тогда
			ИмяКлючевойГруппы = "ГруппаСвойствКонфигурации";
			ИмяКлючевогоСвойства = "СвойствоКонфигурации";
			ТаблицаГруппировок.Сортировать("ГруппаСвойствКонфигурации, ГруппаСвойствКонфигурацииСтрокой, ПрямаяКонвертация убыв");
		Иначе
			ТаблицаГруппировок.Сортировать("ПрямаяКонвертация убыв, ГруппаСвойствКонфигурации, ГруппаСвойствКонфигурацииСтрокой, ГруппаСвойствФормата");
		КонецЕсли;
		ТекКлючеваяГруппа = "";
		ПерваяТЧ = Истина;
		Для Каждого Строка_ТЧ Из ТаблицаГруппировок Цикл
			Если ИмяКлючевойГруппы <> "" Тогда
				КлючеваяГруппа = Строка_ТЧ[ИмяКлючевойГруппы];
				// При необходимости переопределим имя ключевой группы в зависимости от данных строки
				Если ИмяКлючевойГруппы = "ГруппаСвойствКонфигурации" И НЕ ЗначениеЗаполнено(КлючеваяГруппа) Тогда
					КлючеваяГруппа = Строка_ТЧ.ГруппаСвойствКонфигурацииСтрокой;
					ИмяКлючевойГруппы = "ГруппаСвойствКонфигурацииСтрокой";
				ИначеЕсли ИмяКлючевойГруппы = "ГруппаСвойствКонфигурацииСтрокой" И НЕ ЗначениеЗаполнено(КлючеваяГруппа) Тогда
					КлючеваяГруппа = Строка_ТЧ.ГруппаСвойствКонфигурации;
					ИмяКлючевойГруппы = "ГруппаСвойствКонфигурации";
				КонецЕсли;
			Иначе
				КлючеваяГруппа = "" + Строка_ТЧ.ГруппаСвойствФормата  + "_" + Строка_ТЧ.ГруппаСвойствКонфигурации;
			КонецЕсли;
			Если ТекКлючеваяГруппа <> КлючеваяГруппа Тогда
				ТекКлючеваяГруппа = КлючеваяГруппа;
				ОтступТЧФормата = "";
				ИмяГруппы = ?(ЗначениеЗаполнено(Строка_ТЧ.ГруппаСвойствКонфигурацииСтрокой),Строка_ТЧ.ГруппаСвойствКонфигурацииСтрокой,Строка_ТЧ.ГруппаСвойствКонфигурации);
				Для СчетчикПробелов = 1 По МаксДлинаИмяТЧКонфигурации - СтрДлина(ИмяГруппы) Цикл
					ОтступТЧФормата = ОтступТЧФормата + " ";
				КонецЦикла;
				Если ПерваяТЧ Тогда
					ПерваяТЧ = Ложь;
				Иначе
					ЗаполнениеПКС.ДобавитьСтроку("");
				КонецЕсли;
				СтрокаЗаполнениеПКС = "СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "
							+ """" + ИмяГруппы + """, " + ОтступТЧФормата
							+ """" + СокрЛП(Строка_ТЧ.ГруппаСвойствФормата) + """);";
				Если ЗначениеЗаполнено(Строка_ТЧ.ПространствоИмен) Тогда
					СтрокаЗаполнениеПКС = СтрЗаменить(СтрокаЗаполнениеПКС, ");", ", """ + Строка_ТЧ.ПространствоИмен + """);");			
					Если МассивПространстваИмен.Найти(СокрЛП(Строка_ТЧ.ПространствоИмен)) = Неопределено Тогда
						МассивПространстваИмен.Добавить(СокрЛП(Строка_ТЧ.ПространствоИмен));
					КонецЕсли;
				КонецЕсли;
				
				ЗаполнениеПКС.ДобавитьСтроку(СтрокаЗаполнениеПКС);
				
				СтруктураПоискаПКС = Новый Структура("ПравилоКонвертацииОбъекта", ВыборкаДетальная.Ссылка);
				Если ИмяКлючевойГруппы = "" Тогда
					СтруктураПоискаПКС.Вставить("ГруппаСвойствФормата", Строка_ТЧ.ГруппаСвойствФормата);
					СтруктураПоискаПКС.Вставить("ГруппаСвойствКонфигурации", Строка_ТЧ.ГруппаСвойствКонфигурации);
				Иначе
					СтруктураПоискаПКС.Вставить(ИмяКлючевойГруппы, КлючеваяГруппа);
				КонецЕсли;
				КоллекцияПКС = ТабПКС_ТЧ.НайтиСтроки(СтруктураПоискаПКС);
				ТаблицаПКС = Новый ТаблицаЗначений;
				ТаблицаПКС.Колонки.Добавить("СвойствоКонфигурации");
				ТаблицаПКС.Колонки.Добавить("СвойствоФормата");
				ТаблицаПКС.Колонки.Добавить("ИспользуетсяАлгоритмКонвертации");
				ТаблицаПКС.Колонки.Добавить("ПравилоКонвертацииСвойства");
				ТаблицаПКС.Колонки.Добавить("ПространствоИмен");
				ТаблицаПКС.Колонки.Добавить("НомерСтроки");
				МаксДлинаСвойствоКонфигурации = 0;
				Для Каждого Строка Из КоллекцияПКС Цикл
					СтрокаПКС = ТаблицаПКС.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаПКС, Строка);
					ИмяСвойствоКонфигурации = СокрЛП(Строка.СвойствоКонфигурации);
					Если СтрДлина(ИмяСвойствоКонфигурации) > МаксДлинаСвойствоКонфигурации Тогда
						МаксДлинаСвойствоКонфигурации = СтрДлина(ИмяСвойствоКонфигурации);
					КонецЕсли;
				КонецЦикла;
				Если ЗначениеЗаполнено(ИмяКлючевогоСвойства) Тогда
					ТаблицаПКС.Сортировать(ИмяКлючевогоСвойства + ",НомерСтроки");
				Иначе
					ТаблицаПКС.Сортировать("НомерСтроки");
				КонецЕсли;
				Для Каждого Строка Из ТаблицаПКС Цикл
					ОтступСвойствоФормата = "";
					ИмяСвойствоКонфигурации = СокрЛП(Строка.СвойствоКонфигурации);
					Для СчетчикПробелов = 1 По МаксДлинаСвойствоКонфигурации - СтрДлина(ИмяСвойствоКонфигурации) Цикл
						ОтступСвойствоФормата = ОтступСвойствоФормата + " ";
					КонецЦикла;
					ПараметрИспользуетсяАлгоритм = ?(Строка.ИспользуетсяАлгоритмКонвертации,"1","");
					СтрокаДобавлениеПКС = "ДобавитьПКС(СвойстваТЧ, "  
					+ """" + ИмяСвойствоКонфигурации + """, " + ОтступСвойствоФормата
					+ """" + СокрЛП(Строка.СвойствоФормата) + """";
					Если НЕ ПустаяСтрока(ПараметрИспользуетсяАлгоритм) Или НЕ ПустаяСтрока(Строка.ПравилоКонвертацииСвойства)
						Или ПустаяСтрока(Строка.ПространствоИмен) Тогда
						СтрокаДобавлениеПКС = СтрокаДобавлениеПКС + ", " + ?(ПустаяСтрока(ПараметрИспользуетсяАлгоритм),"",ПараметрИспользуетсяАлгоритм);
						СтрокаДобавлениеПКС = СтрокаДобавлениеПКС + ", " + ?(ПустаяСтрока(Строка.ПравилоКонвертацииСвойства),"",
						"""" + СокрЛП(Строка.ПравилоКонвертацииСвойства) + """");
						СтрокаДобавлениеПКС = СтрокаДобавлениеПКС + ?(ПустаяСтрока(Строка.ПространствоИмен),"",
						",""" + СокрЛП(Строка.ПространствоИмен) + """");
						// Убрать возможные лишние запятые
						ЛишнихЗнаков = 0;
						Если Прав(СтрокаДобавлениеПКС, 6) = ", , , " Тогда
							ЛишнихЗнаков = 6;
						ИначеЕсли Прав(СтрокаДобавлениеПКС, 4) = ", , " Тогда
							ЛишнихЗнаков = 4;
						ИначеЕсли Прав(СтрокаДобавлениеПКС, 2) = ", " Тогда
							ЛишнихЗнаков = 2;
						КонецЕсли;
						Если ЛишнихЗнаков > 0 Тогда
							СтрокаДобавлениеПКС = Лев(СтрокаДобавлениеПКС, СтрДлина(СтрокаДобавлениеПКС) - ЛишнихЗнаков);
						КонецЕсли;
						Если НЕ ПустаяСтрока(Строка.ПространствоИмен) И МассивПространстваИмен.Найти(СокрЛП(Строка.ПространствоИмен)) = Неопределено Тогда
							МассивПространстваИмен.Добавить(СокрЛП(Строка.ПространствоИмен));
						КонецЕсли;
					КонецЕсли;
					СтрокаДобавлениеПКС = СтрокаДобавлениеПКС + ");";
					ЗаполнениеПКС.ДобавитьСтроку(СтрокаДобавлениеПКС);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		ЗаполнениеПКСТекст = ДобавитьОтступыВТекстовыйДокумент(ЗаполнениеПКС);
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ЗаполнениеТЧПКС", ЗаполнениеПКСТекст);
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ЗаполнениеТЧПКС", "---");
	КонецЕсли;
	ИнициализироватьРасширение = "";
	Для Каждого ИмяРасш Из МассивПространстваИмен Цикл
		ИнициализироватьРасширение = ИнициализироватьРасширение + ?(ИнициализироватьРасширение = "", "", Символы.ПС) + Символы.Таб +
			"ОбменДаннымиXDTOСервер.ИнициализироватьРасширениеПравилаКонвертацииОбъекта(ПравилоКонвертации, " + """" + ИмяРасш + """);";
	КонецЦикла; 
	Если ИнициализироватьРасширение = "" Тогда
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ИнициализироватьРасширение", "---");
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ИнициализироватьРасширение", ИнициализироватьРасширение);
	КонецЕсли;
	ЗаполнениеПолейПоиска = Новый ТекстовыйДокумент;
	Если ВыборкаДетальная.ИспользоватьДляПолучения Тогда
		Для Каждого Строка Из КоллекцияПолейПоиска Цикл
			СтрокаПолейПоиска = """" + СокрЛП(Строка.РеквизитыПоиска) + """";
			ЗаполнениеПолейПоиска.ДобавитьСтроку("ПравилоКонвертации.ПоляПоиска.Добавить(""" + Строка.РеквизитыПоиска+""");");
		КонецЦикла;
	КонецЕсли;
	Если ЗаполнениеПолейПоиска.КоличествоСтрок() > 0 Тогда
		ЗаполнениеПолейПоискаТекст = ДобавитьОтступыВСтроку(ЗаполнениеПолейПоиска.ПолучитьТекст());
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ЗаполнениеПолейПоиска", ЗаполнениеПолейПоискаТекст);
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&ЗаполнениеПолейПоиска", "---");
	КонецЕсли;
	Если ПараметрыМодуля.ИспользоватьТипизациюПеременных Тогда
		ОбластьПКОКомментарий = ПараметрыМодуля.МакетТекстовМодулейДетализацияКомментариев.ПолучитьОбласть("Комментарий_ДобавитьПКО").ПолучитьТекст();
		ОбластьПКОКомментарий = СтрЗаменить(ОбластьПКОКомментарий, "#Область Комментарий_ДобавитьПКО", "---");
		ОбластьПКОТекст = ОбластьПКОКомментарий + ОбластьПКОТекст;
	КонецЕсли;
	ТекстОбработчики = "";
	Если ВыборкаДетальная.ИспользоватьДляОтправки Тогда
		ДобавитьОбработчикиВТекстМодуля("ПКО", "ПриОтправкеДанных", 
			ВыборкаДетальная,ПараметрыМодуля, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила, ТекстОбработчики);
	КонецЕсли;
	Если ВыборкаДетальная.ИспользоватьДляПолучения Тогда
		ДобавитьОбработчикиВТекстМодуля("ПКО", "ПриКонвертацииДанныхXDTO", 
			ВыборкаДетальная, ПараметрыМодуля, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила, ТекстОбработчики);
		ДобавитьОбработчикиВТекстМодуля("ПКО", "ПередЗаписьюПолученныхДанных", 
			ВыборкаДетальная, ПараметрыМодуля, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила, ТекстОбработчики);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстОбработчики) Тогда
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&Обработчики", ТекстОбработчики);
	Иначе
		ОбластьПКОТекст = СтрЗаменить(ОбластьПКОТекст, "&Обработчики", "---");
	КонецЕсли;
	
	Возврат ОбластьПКОТекст;
КонецФункции

Процедура ДобавитьПроцедурыПОДиПКОВМодуль(ПараметрыМодуля)
	Если ПараметрыМодуля.ИспользоватьТипизациюПеременных Тогда
		ИспользуемыйМакет = ПараметрыМодуля.МакетТекстовМодулейДетализацияКомментариев;
	Иначе
		ИспользуемыйМакет = ПараметрыМодуля.МакетТекстовМодулей;
	КонецЕсли;
	ЗаполнитьПравилаОбработкиДанныхТекст = ИспользуемыйМакет.ПолучитьОбласть("ЗаполнитьПравилаОбработкиДанных").ПолучитьТекст();
	ЗаполнитьПравилаОбработкиДанныхТекст = СтрЗаменить(ЗаполнитьПравилаОбработкиДанныхТекст,
		"#Область ЗаполнитьПравилаОбработкиДанных" + Символы.ПС, "");
	УдалитьПоследнийПереводСтроки(ЗаполнитьПравилаОбработкиДанныхТекст);
	ПараметрыМодуля.ПрограммныйИнтерфейс.ДобавитьСтроку(ЗаполнитьПравилаОбработкиДанныхТекст); 
	ТелоПроцедуры = Новый ТекстовыйДокумент;

	ТекстМодуляПОД = ПараметрыМодуля.ПОД_Отправка;
	ЕслиОткрыто = Ложь;
	Если ТекстМодуляПОД.КоличествоСтрок() > 0 Тогда
		ЕслиОткрыто = Истина;
		ТелоПроцедуры.ДобавитьСтроку("Если НаправлениеОбмена = ""Отправка"" Тогда");
		ТелоПроцедуры.ДобавитьСтроку(Символы.Таб + "Если ПравилаОбработкиДанных.Колонки.Найти(""ОчисткаДанных"") = Неопределено Тогда");
		ТелоПроцедуры.ДобавитьСтроку(Символы.Таб + Символы.Таб + "ПравилаОбработкиДанных.Колонки.Добавить(""ОчисткаДанных"");");
		ТелоПроцедуры.ДобавитьСтроку(Символы.Таб + "КонецЕсли;");
		Для НомерСтроки = 1 По ТекстМодуляПОД.КоличествоСтрок() Цикл
			СтрокаМодуля = Символы.Таб + ТекстМодуляПОД.ПолучитьСтроку(НомерСтроки);
			ТелоПроцедуры.ДобавитьСтроку(СтрокаМодуля);
		КонецЦикла;
	КонецЕсли;
	ТекстМодуляПОД = ПараметрыМодуля.ПОД_Получение; 
	Если ТекстМодуляПОД.КоличествоСтрок() > 0 Тогда
		Если Не ЕслиОткрыто Тогда
			Строка = "Если";
		Иначе
			Строка = "ИначеЕсли";
		КонецЕсли;
		ТелоПроцедуры.ДобавитьСтроку(Строка + " НаправлениеОбмена = ""Получение"" Тогда");
		ЕслиОткрыто = Истина;
		Для НомерСтроки = 1 По ТекстМодуляПОД.КоличествоСтрок() Цикл
			СтрокаМодуля = Символы.Таб + ТекстМодуляПОД.ПолучитьСтроку(НомерСтроки);
			ТелоПроцедуры.ДобавитьСтроку(СтрокаМодуля);
		КонецЦикла;
	КонецЕсли;
	Если ЕслиОткрыто Тогда
		ТелоПроцедуры.ДобавитьСтроку("КонецЕсли;");
		ЕслиОткрыто = Ложь;
	КонецЕсли;
	ТекстТелаПроцедуры = ДобавитьОтступыВСтроку(ТелоПроцедуры.ПолучитьТекст());
	ПараметрыМодуля.ПрограммныйИнтерфейс.ДобавитьСтроку(ТекстТелаПроцедуры); 
	ПараметрыМодуля.ПрограммныйИнтерфейс.ДобавитьСтроку("КонецПроцедуры"); 
	
	ЗаполнитьПравилаКонвертацииОбъектовТекст = ИспользуемыйМакет.ПолучитьОбласть("ЗаполнитьПравилаКонвертацииОбъектов").ПолучитьТекст();
	ЗаполнитьПравилаКонвертацииОбъектовТекст = СтрЗаменить(ЗаполнитьПравилаКонвертацииОбъектовТекст,
		"#Область ЗаполнитьПравилаКонвертацииОбъектов", "---");
	УдалитьПоследнийПереводСтроки(ЗаполнитьПравилаКонвертацииОбъектовТекст);
	ПараметрыМодуля.ПрограммныйИнтерфейс.ДобавитьСтроку(ЗаполнитьПравилаКонвертацииОбъектовТекст);
	
	ЕслиОткрыто = Ложь;
	ТелоПроцедуры = Новый ТекстовыйДокумент;

	ТекстМодуляПКО = ПараметрыМодуля.ПКО_Отправка;
	Если ТекстМодуляПКО.КоличествоСтрок() > 0 Тогда
		ТелоПроцедуры.ДобавитьСтроку("Если НаправлениеОбмена = ""Отправка"" Тогда");
		ЕслиОткрыто = Истина;
		Для НомерСтроки = 1 По ТекстМодуляПКО.КоличествоСтрок() Цикл
			СтрокаМодуля = Символы.Таб + ТекстМодуляПКО.ПолучитьСтроку(НомерСтроки);
			ТелоПроцедуры.ДобавитьСтроку(СтрокаМодуля);
		КонецЦикла;
	КонецЕсли;
	ТекстМодуляПКО = ПараметрыМодуля.ПКО_Получение;
	Если ТекстМодуляПКО.КоличествоСтрок() > 0 Тогда
		Если Не ЕслиОткрыто Тогда
			Строка = "Если";
		Иначе
			Строка = "ИначеЕсли";
		КонецЕсли;
		ТелоПроцедуры.ДобавитьСтроку(Строка + " НаправлениеОбмена = ""Получение"" Тогда");
		ЕслиОткрыто = Истина;
		Для НомерСтроки = 1 По ТекстМодуляПКО.КоличествоСтрок() Цикл
			СтрокаМодуля = Символы.Таб + ТекстМодуляПКО.ПолучитьСтроку(НомерСтроки);
			ТелоПроцедуры.ДобавитьСтроку(СтрокаМодуля);
		КонецЦикла;
	КонецЕсли;
	Если ЕслиОткрыто Тогда
		ТелоПроцедуры.ДобавитьСтроку("КонецЕсли;");
		ЕслиОткрыто = Ложь;
	КонецЕсли; 
	ТекстМодуляПКО = ПараметрыМодуля.ПКО_ОтправкаИПолучение;
	Для НомерСтроки = 1 По ТекстМодуляПКО.КоличествоСтрок() Цикл
		СтрокаМодуля = ТекстМодуляПКО.ПолучитьСтроку(НомерСтроки);
		ТелоПроцедуры.ДобавитьСтроку(СтрокаМодуля);
	КонецЦикла;
	ТекстТелаПроцедуры = ДобавитьОтступыВСтроку(ТелоПроцедуры.ПолучитьТекст());	
	ПараметрыМодуля.ПрограммныйИнтерфейс.ДобавитьСтроку(ТекстТелаПроцедуры); 

    ПараметрыМодуля.ПрограммныйИнтерфейс.ДобавитьСтроку("КонецПроцедуры");
КонецПроцедуры

// Компоновка результирующего модуля: Программный интерфейс, служебные процедуры, обработчики и т.д.
Процедура ДобавитьПроцедурыВТекстМодуля(ОбщийТекстМодуля, ТекстыПоГруппам, ПараметрыМодуля, ЭтоМодульМенеджера = Ложь)
	Если НЕ ПараметрыМодуля.ИспользоватьРазделениеМодуля Тогда
		ОбщийТекстМодуля.ДобавитьСтроку("#Область СлужебныйПрограммныйИнтерфейс");
		ОбщийТекстМодуля.ДобавитьСтроку(ПараметрыМодуля.ПрограммныйИнтерфейс.ПолучитьТекст());
		ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	КонецЕсли;
	Если НЕ ЭтоМодульМенеджера Тогда
		ОбщийТекстМодуля.ДобавитьСтроку("#Область СлужебныеПроцедурыИФункции"); 
	КонецЕсли;
	Если НЕ (ПараметрыМодуля.ИспользоватьРазделениеМодуля И ПараметрыМодуля.ТекущийМодуль.ЭтоМодульМенеджера) Тогда
		ДобавитьУИДМодуля(ОбщийТекстМодуля);
	КонецЕсли;
	ОбщийТекстМодуля.ДобавитьСтроку("#Область ПОД");
	Для Каждого ГруппаПравил Из ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам_ПОД Цикл
		ОбщийТекстМодуля.ДобавитьСтроку("#Область " + ГруппаПравил.Ключ);
		ОбщийТекстМодуля.ДобавитьСтроку(ГруппаПравил.Значение.ПолучитьТекст());
		ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	КонецЦикла;
	ОбщийТекстМодуля.ДобавитьСтроку(ТекстыПоГруппам.СлужебныеПроцедурыИФункции_ПОД.ПолучитьТекст());
	ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	ОбщийТекстМодуля.ДобавитьСтроку("#Область ПКО");
	Для Каждого ГруппаПравил Из ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам_ПКО Цикл
		ОбщийТекстМодуля.ДобавитьСтроку("#Область " + ГруппаПравил.Ключ);
		ОбщийТекстМодуля.ДобавитьСтроку(ГруппаПравил.Значение.ПолучитьТекст());
		ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	КонецЦикла;
	ОбщийТекстМодуля.ДобавитьСтроку(ТекстыПоГруппам.СлужебныеПроцедурыИФункции_ПКО.ПолучитьТекст());
	ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	Для Каждого ГруппаПравил Из ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам Цикл
		// Алгоритмы принудительно добавляем в конец позднее.
		Если  ГруппаПравил.Ключ = "Алгоритмы" Тогда
			Продолжить;
		КонецЕсли;
		ОбщийТекстМодуля.ДобавитьСтроку("#Область " + ГруппаПравил.Ключ);
		ОбщийТекстМодуля.ДобавитьСтроку(ГруппаПравил.Значение.ПолучитьТекст());
		ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	КонецЦикла;
	ОбщийТекстМодуля.ДобавитьСтроку(ТекстыПоГруппам.СлужебныеПроцедурыИФункции.ПолучитьТекст());
	СлужебныеПроцедурыДополнение = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Служебные_ЗаполнениеПКС").ПолучитьТекст();
	СлужебныеПроцедурыДополнение = СтрЗаменить(СлужебныеПроцедурыДополнение,"#Область Служебные_ЗаполнениеПКС", "");
	ОбщийТекстМодуля.ДобавитьСтроку(СлужебныеПроцедурыДополнение);
	Если ПараметрыМодуля.ГруппироватьПоОбъектамВыгрузки = Ложь Тогда
		ОбщийТекстМодуля.ДобавитьСтроку("#Область ОбработчикиКонвертации");
		Для Каждого ГруппаПравил Из ТекстыПоГруппам.ОбработчикиКонвертацииПоГруппам Цикл
			ОбщийТекстМодуля.ДобавитьСтроку("#Область " + ГруппаПравил.Ключ);
			ОбщийТекстМодуля.ДобавитьСтроку(ГруппаПравил.Значение.ПолучитьТекст());
			ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
		КонецЦикла; 
		ОбщийТекстМодуля.ДобавитьСтроку(ТекстыПоГруппам.ОбработчикиКонвертации.ПолучитьТекст());
		ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	КонецЕсли;
	// Алгоритмы принудительно добавляем в конец.
	Если (НЕ ПараметрыМодуля.ИспользоватьРазделениеМодуля Или ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.Пользовательский)
		И ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам.Свойство("Алгоритмы") Тогда
		ОбщийТекстМодуля.ДобавитьСтроку("#Область Алгоритмы");
		ОбщийТекстМодуля.ДобавитьСтроку(ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам.Алгоритмы.ПолучитьТекст());
		ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти"); 
	КонецЕсли; 
	Если НЕ ЭтоМодульМенеджера Тогда
		// Нет области Служебные процедуры и функции.
		ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	КонецЕсли;
	УдалитьЛишниеСтрокиИзМодуля(ОбщийТекстМодуля);

КонецПроцедуры

Процедура УдалитьЛишниеСтрокиИзМодуля(ОбщийТекстМодуля)
	КоличествоСтрок = ОбщийТекстМодуля.КоличествоСтрок();
	ТекстДляПлатформы82 = Конвертация.Версия82;
	
	Для ОбратныйСчетчик = 0 По КоличествоСтрок - 1 Цикл
		
		НомерСтроки = КоличествоСтрок - ОбратныйСчетчик;
		
		Строка = ОбщийТекстМодуля.ПолучитьСтроку(НомерСтроки);
		Если Найти(Строка, "---") > 0 Тогда
			ОбщийТекстМодуля.УдалитьСтроку(НомерСтроки);
		ИначеЕсли ТекстДляПлатформы82 Тогда
			Если Найти(Строка, "#Область") > 0 Тогда
				ОбщийТекстМодуля.ЗаменитьСтроку(НомерСтроки, СтрЗаменить(Строка, "#Область", "// "));
			ИначеЕсли Найти(Строка, "#КонецОбласти") > 0 Тогда
				ОбщийТекстМодуля.УдалитьСтроку(НомерСтроки);
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Добавление обработчиков конвертации.
Функция ЗаполнитьТекстПроцедурыКонвертации(МакетТекстовМодулей)
	
	ТекстПроцедуры = Новый ТекстовыйДокумент;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	Конвертации.АлгоритмПередКонвертацией КАК АлгоритмПередКонвертацией,
	|	Конвертации.АлгоритмПослеКонвертации КАК АлгоритмПослеКонвертации,
	|	Конвертации.АлгоритмПередОбработкойУдаления КАК АлгоритмПередОбработкойУдаления,
	|	Конвертации.АлгоритмПередОтложеннымЗаполнением КАК АлгоритмПередОтложеннымЗаполнением
	|ИЗ
	|	Справочник.Конвертации КАК Конвертации
	|ГДЕ
	|	Конвертации.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Конвертация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ПередКонвертациейЗаголовок = МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ПередКонвертацией_Заголовок").ПолучитьТекст();
	ПередКонвертациейЗаголовок = СтрЗаменить(ПередКонвертациейЗаголовок,"#Область Конвертация_ПередКонвертацией_Заголовок", "---"); 
	УдалитьПоследнийПереводСтроки(ПередКонвертациейЗаголовок);
	ТекстПроцедуры.ДобавитьСтроку(ПередКонвертациейЗаголовок);
	Если ЗначениеЗаполнено(Выборка.АлгоритмПередКонвертацией) Тогда
		ТекстПроцедуры.ДобавитьСтроку(ДобавитьОтступыВСтроку(Выборка.АлгоритмПередКонвертацией));
	КонецЕсли;
	ТекстПроцедуры.ДобавитьСтроку("КонецПроцедуры");
	ТекстПроцедуры.ДобавитьСтроку("");
	
	ПослеКонвертацииЗаголовок = МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ПослеКонвертации_Заголовок").ПолучитьТекст();
	ПослеКонвертацииЗаголовок = СтрЗаменить(ПослеКонвертацииЗаголовок,"#Область Конвертация_ПослеКонвертации_Заголовок", "---");
	УдалитьПоследнийПереводСтроки(ПослеКонвертацииЗаголовок);
	ТекстПроцедуры.ДобавитьСтроку(ПослеКонвертацииЗаголовок);
	Если ЗначениеЗаполнено(Выборка.АлгоритмПослеКонвертации) Тогда
		ТекстПроцедуры.ДобавитьСтроку(ДобавитьОтступыВСтроку(Выборка.АлгоритмПослеКонвертации));
	КонецЕсли;
	ТекстПроцедуры.ДобавитьСтроку("КонецПроцедуры");
	ТекстПроцедуры.ДобавитьСтроку("");

	ПередОтложеннымЗаполнениемЗаголовок = МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ПередОтложеннымЗаполнением_Заголовок").ПолучитьТекст();
	ПередОтложеннымЗаполнениемЗаголовок = СтрЗаменить(ПередОтложеннымЗаполнениемЗаголовок,"#Область Конвертация_ПередОтложеннымЗаполнением_Заголовок", "---");
	УдалитьПоследнийПереводСтроки(ПередОтложеннымЗаполнениемЗаголовок);
	ТекстПроцедуры.ДобавитьСтроку(ПередОтложеннымЗаполнениемЗаголовок);
	Если ЗначениеЗаполнено(Выборка.АлгоритмПередОтложеннымЗаполнением) Тогда
		ТекстПроцедуры.ДобавитьСтроку(ДобавитьОтступыВСтроку(Выборка.АлгоритмПередОтложеннымЗаполнением));
	КонецЕсли;
	ТекстПроцедуры.ДобавитьСтроку("КонецПроцедуры");

	ПередУдалениемЗаголовок = МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ПередОбработкойУдаления_Заголовок").ПолучитьТекст();
	ПередУдалениемЗаголовок = СтрЗаменить(ПередУдалениемЗаголовок,"#Область Конвертация_ПередОбработкойУдаления_Заголовок", "");
	УдалитьПоследнийПереводСтроки(ПередУдалениемЗаголовок);
	ТекстПроцедуры.ДобавитьСтроку(ПередУдалениемЗаголовок);
	Если ЗначениеЗаполнено(Выборка.АлгоритмПередОбработкойУдаления) Тогда
		ТекстПроцедуры.ДобавитьСтроку(ДобавитьОтступыВСтроку(Выборка.АлгоритмПередОбработкойУдаления));
	КонецЕсли;
	ТекстПроцедуры.ДобавитьСтроку("КонецПроцедуры");
	
	Возврат ТекстПроцедуры.ПолучитьТекст();
	
КонецФункции

// Добавление алгоритмов.
Процедура ЗаполнитьТекстПроцедурыАлгоритмы(ТекстыПоГруппам, ПараметрыМодуля)
	ТекстПроцедуры = Новый ТекстовыйДокумент;
	ОбластьКомментарий = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_Алгоритмы_Комментарий");
	ТекстКомментария = СтрЗаменить(ОбластьКомментарий.ПолучитьТекст(), "#Область Конвертация_Алгоритмы_Комментарий","---");
	ТекстПроцедуры.ДобавитьСтроку(ТекстКомментария);
	
	Если Константы.СовместнаяРабота.Получить() Тогда
		Если ПоСостояниюХранилища Тогда
			КОбработке = ТекстЗапросаВсеИзХранилища("Алгоритмы");
			КОбработкеПКО = ТекстЗапросаСвоиДоработки("ПравилаКонвертацииОбъектов");
		Иначе
			КОбработке = ТекстЗапросаСвоиДоработки("Алгоритмы");
			КОбработкеПКО = ТекстЗапросаСвоиДоработки("ПравилаКонвертацииОбъектов");
		КонецЕсли;
	Иначе
		КОбработке = ТекстЗапросаБезСовместнойРаботы("Алгоритмы");
		КОбработкеПКО = ТекстЗапросаБезСовместнойРаботы("ПравилаКонвертацииОбъектов");
	КонецЕсли;
	КОбработкеПКО = СтрЗаменить(КОбработкеПКО, "ГДЕ", "ГДЕ Правила.АлгоритмПослеЗагрузкиВсехДанных <> """" И ");
	Запрос = Новый Запрос; 
	ВсеАлгоритмыЭкспортные = Ложь;
	Если ПараметрыМодуля.ИспользоватьРазделениеМодуля Тогда
		// Отбор по модулю.
		ВсеАлгоритмыЭкспортные = Истина;
		Если ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.Пользовательский Тогда
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод
			|ГДЕ Свод.Ссылка.ДополнительныйМодуль = &ДополнительныйМодуль
			|; ";
			Запрос.УстановитьПараметр("ДополнительныйМодуль", ПараметрыМодуля.ТекущийМодуль.Ссылка);
		Иначе
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод
			|ГДЕ Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|; ";
		КонецЕсли;
		ВызовыАлгоритмов = Неопределено;
		ПараметрыМодуля.Свойство("ВызовыАлгоритмов", ВызовыАлгоритмов);
		Если ВызовыАлгоритмов = Неопределено Тогда
			ПараметрыМодуля.Вставить("ВызовыАлгоритмов", Новый Соответствие());
		КонецЕсли;
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ссылка 
		|ПОМЕСТИТЬ КОбработке
		|ИЗ (" + КОбработке + ") КАК Свод
		|;"
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.АлгоритмПослеЗагрузкиВсехДанных КАК Код
	|ПОМЕСТИТЬ АлгоритмыОтложеннойОбработки
	|ИЗ ("
	+ КОбработкеПКО + "
	|) КАК Свод
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Алгоритмы.Код КАК Код,
	|	Алгоритмы.Ссылка КАК Ссылка,
	|	Алгоритмы.Параметры КАК Параметры,
	|	Алгоритмы.Алгоритм КАК Алгоритм,
	|	Алгоритмы.ЭтоФункция КАК ЭтоФункция,
	|	Алгоритмы.Экспортный КАК Экспортный, 
	|	Алгоритмы.Комментарий КАК Комментарий,
	|	ВЫБОР
	|		КОГДА АлгоритмыОтложеннойОбработки.Код ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоАлгоритмПослеЗагрузкиВсехДанных
	|ИЗ
	|	Справочник.Алгоритмы КАК Алгоритмы
	|ЛЕВОЕ СОЕДИНЕНИЕ АлгоритмыОтложеннойОбработки КАК АлгоритмыОтложеннойОбработки
	|ПО Алгоритмы.Код = АлгоритмыОтложеннойОбработки.Код
	|ГДЕ Алгоритмы.Ссылка В (ВЫБРАТЬ Ссылка ИЗ КОбработке)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Алгоритмы.Код
	|;
	|ВЫБРАТЬ
	|	Код,
	|	Количество(Ссылка) КАК Количество
	|ИЗ
	|	Справочник.Алгоритмы КАК Алгоритмы
	|ГДЕ Алгоритмы.Ссылка В (ВЫБРАТЬ Ссылка ИЗ КОбработке)
	|СГРУППИРОВАТЬ ПО Код
	|ИМЕЮЩИЕ Количество(Ссылка) > 1
	|";
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.ТекущийПользователь());
	Результат = Запрос.ВыполнитьПакет();
	КоличествоТаблиц = Результат.Количество();
	ВыборкаДубли = Результат[КоличествоТаблиц - 1].Выбрать();
	Пока ВыборкаДубли.Следующий() Цикл
		ОбщегоНазначения.СообщитьПользователю("Обнаружены алгоритмы с одинаковыми именами: " + ВыборкаДубли.Код);
	КонецЦикла;
	Выборка = Результат[КоличествоТаблиц - 2].Выбрать();
	ТекстПроцедурыВызоваОбработчика = ПараметрыМодуля.ТекстПроцедурыВызоваОбработчика;
	СтрокойВышеЕстьТег = Ложь;
	Пока Выборка.Следующий() Цикл
		Если ПараметрыМодуля.ИспользоватьРазделениеМодуля Тогда
			ПараметрыМодуля.ВызовыАлгоритмов.Вставить(НРег(СокрЛП(Выборка.Код)) + "(", СокрЛП(ПараметрыМодуля.ТекущийМодуль.Наименование) + "." + СокрЛП(Выборка.Код) + "(");
		КонецЕсли;
		ТегиПравила = ПолучитьТегиДляПравила(Выборка.Ссылка, ПараметрыМодуля);
		Если ЗначениеЗаполнено(ТегиПравила.ТегОткрытие) Тогда
			СтрокойВышеЕстьТег = Истина;
			ТекстПроцедуры.ДобавитьСтроку(ТегиПравила.ТегОткрытие);
		КонецЕсли;
		ДобавитьТекстАлгоритма(ТекстПроцедуры, Выборка, ВсеАлгоритмыЭкспортные, СтрокойВышеЕстьТег); 
		Если ЗначениеЗаполнено(ТегиПравила.ТегЗакрытие) Тогда
			ТекстПроцедуры.ДобавитьСтроку(ТегиПравила.ТегЗакрытие);
			СтрокойВышеЕстьТег = Истина;
		Иначе
			СтрокойВышеЕстьТег = Ложь;
		КонецЕсли;
		Если Выборка.ЭтоАлгоритмПослеЗагрузкиВсехДанных Тогда
			
			ТекстПараметрыВызова = Выборка.Параметры;
			НовыйМассивПараметров = Новый Массив;
			МассивПараметров = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстПараметрыВызова, ",");
			Для Каждого ПараметрСтрокой Из МассивПараметров Цикл
				Если НРЕГ(СокрЛП(ПараметрСтрокой)) = НРег("ПараметрыКонвертации") Тогда
					ПараметрСтрокойПолный = "Параметры.КомпонентыОбмена." + СокрЛП(ПараметрСтрокой);
				Иначе
					ПараметрСтрокойПолный = "Параметры." + СокрЛП(ПараметрСтрокой);
				КонецЕсли;
				НовыйМассивПараметров.Добавить(ПараметрСтрокойПолный);
			КонецЦикла;
			ТекстПараметрыВызова = СтрСоединить(НовыйМассивПараметров, ", "); 
			Если ЗначениеЗаполнено(ТегиПравила.ТегОткрытие) Тогда
				ТекстПроцедурыВызоваОбработчика = ТекстПроцедурыВызоваОбработчика + Символы.ПС + ТегиПравила.ТегОткрытие;
			КонецЕсли;
			ТекстПроцедурыВызоваОбработчика = ТекстПроцедурыВызоваОбработчика 
				+ ?(ТекстПроцедурыВызоваОбработчика = "", "Если ", Символы.ПС + "ИначеЕсли ")
				+ "ИмяПроцедуры = """ + СокрЛП(Выборка.Код) + """ Тогда " + Символы.ПС + Символы.Таб
				+ СокрЛП(Выборка.Код) + "(" + Символы.ПС + Символы.Таб + Символы.Таб + ТекстПараметрыВызова + ");";
			Если ЗначениеЗаполнено(ТегиПравила.ТегЗакрытие) Тогда
				ТекстПроцедурыВызоваОбработчика = ТекстПроцедурыВызоваОбработчика + Символы.ПС + ТегиПравила.ТегЗакрытие;
			КонецЕсли;
		КонецЕсли;
			
	КонецЦикла;   
	Если ПараметрыМодуля.ИспользоватьРазделениеМодуля И ЗначениеЗаполнено(ТекстПроцедурыВызоваОбработчика) Тогда
		ПараметрыМодуля.ТекущийМодуль.ЕстьПроцедурыВызоваОбработчика = Истина;
	КонецЕсли;
	ПараметрыМодуля.ТекстПроцедурыВызоваОбработчика = ТекстПроцедурыВызоваОбработчика;
	ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам.Вставить("Алгоритмы",ТекстПроцедуры);

КонецПроцедуры

Процедура ДобавитьТекстАлгоритма(ТекстПроцедуры, Выборка, ВсеАлгоритмыЭкспортные, СтрокойВышеЗакрытТег)
	Если ЗначениеЗаполнено(Выборка.Комментарий) Тогда
		Если СтрокойВышеЗакрытТег Тогда
			ТекстПроцедуры.ДобавитьСтроку(Символы.ПС + Выборка.Комментарий);
		Иначе
			ТекстПроцедуры.ДобавитьСтроку(Выборка.Комментарий);
		КонецЕсли;
	КонецЕсли;

	ТекстПроцедуры.ДобавитьСтроку(?(Выборка.ЭтоФункция, "Функция ", "Процедура ") + СокрЛП(Выборка.Код) + "("
		+ СокрЛП(Выборка.Параметры)+")" + ?(ВсеАлгоритмыЭкспортные Или Выборка.Экспортный," Экспорт",""));
	ТекстПроцедуры.ДобавитьСтроку(ДобавитьОтступыВСтроку(Выборка.Алгоритм));
	ТекстПроцедуры.ДобавитьСтроку(?(Выборка.ЭтоФункция, "КонецФункции", "КонецПроцедуры"));
КонецПроцедуры

// Добавление процедуры вызова обработчиков.
Процедура ЗаполнитьТекстПроцедурыВызоваОбработчиков(ПараметрыМодуля)
	ТекстПроцедуры = Новый ТекстовыйДокумент;
	ОбластьКомментарий = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_Общие_Комментарий");
	ТекстПроцедуры.Вывести(ОбластьКомментарий);
	
	ЗаголовокПроцедуры = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ПроцедураВызоваОбработчика_Заголовок");
	ТекстПроцедуры.Вывести(ЗаголовокПроцедуры);
	Если ЗначениеЗаполнено(ПараметрыМодуля.ТекстПроцедурыВызоваОбработчика) Тогда 
		ТекстПроцедуры.ДобавитьСтроку(ДобавитьОтступыВСтроку(ПараметрыМодуля.ТекстПроцедурыВызоваОбработчика));
		ТекстПроцедуры.ДобавитьСтроку(Символы.Таб + "КонецЕсли;");
	КонецЕсли;
	ТекстПроцедуры.ДобавитьСтроку("КонецПроцедуры");

	Если ПараметрыМодуля.ТекстФункцииВызоваОбработчика <> "" Тогда
		ЗаголовокПроцедуры = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ФункцияВызоваОбработчика_Заголовок");
		ТекстПроцедуры.Вывести(ЗаголовокПроцедуры); 
		ТекстПроцедуры.ДобавитьСтроку(ДобавитьОтступыВСтроку(ПараметрыМодуля.ТекстФункцииВызоваОбработчика));
		ТекстПроцедуры.ДобавитьСтроку(Символы.Таб + "КонецЕсли;"+ Символы.ПС+"КонецФункции");
	КонецЕсли;
	ПараметрыМодуля.ПрограммныйИнтерфейс.ДобавитьСтроку(ТекстПроцедуры.ПолучитьТекст());
КонецПроцедуры

// Добавление процедур-обработчиков в текст модуля.
Процедура ДобавитьОбработчикиВТекстМодуля(ВидПравил, ИмяОбработчика, Выборка, ПараметрыМодуля, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила, ТекстОбработчики)
	ИмяПроцедуры = "";
	ТекстФункцииВызоваОбработчика = ПараметрыМодуля.ТекстФункцииВызоваОбработчика;
	ТекстПроцедурыВызоваОбработчика = ПараметрыМодуля.ТекстПроцедурыВызоваОбработчика;
	ТекстОбработчикиЛокально = ""; 
	ПостфиксЗаголовкаОбработчика = "";
	Если ПараметрыМодуля.ИспользоватьРазделениеМодуля Тогда
		ПостфиксЗаголовкаОбработчика = " Экспорт";
	КонецЕсли;
	Если СокрЛП(Выборка[ИмяОбработчика]) <> "" Тогда
		ИмяПроцедуры = ВидПравил+"_"+СокрЛП(Выборка.Код)+"_"+ИмяОбработчика;
		
		ОбластьПараметры = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_Параметры_"+ВидПравил+"_"+ИмяОбработчика);
		ТекстПараметры = СтрПолучитьСтроку(ОбластьПараметры.ПолучитьТекст(),2);
		// Параметры в месте объявления процедуры (общие).
		ТекстПараметрыПроцедуры = СтрЗаменить(ТекстПараметры, "_", "");
		
		Если ВидПравил = "ПОД" Тогда
			ИмяПараметра = ?(Выборка.ИспользоватьДляОтправки, "ДанныеИБ", "ДанныеXDTO");
			ТекстПараметрыПроцедуры = СтрЗаменить(ТекстПараметрыПроцедуры, "ОбъектОбработки", ИмяПараметра);
		КонецЕсли;
		
		// Параметры в месте вызова процедуры.
		ТекстПараметрыВызова = СтрЗаменить(ТекстПараметры, "_", "Параметры.");
		ТекстПараметрыВызова = СтрЗаменить(ТекстПараметрыВызова, "(", "(" + Символы.ПС + Символы.Таб + Символы.Таб);
		
		Если ИмяОбработчика = "ВыборкаДанных" Тогда
			
			ТекстОбработчикиЛокально = "Функция " + ИмяПроцедуры + ТекстПараметрыПроцедуры + ПостфиксЗаголовкаОбработчика 
				+ Символы.ПС + ДобавитьОтступыВСтроку(Выборка[ИмяОбработчика])
				+ Символы.ПС + "КонецФункции";
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегОткрытие) Тогда
				// Если есть тег тогда надо заполнить фиктивную ветку Если
				Если ТекстФункцииВызоваОбработчика = "" Тогда
					ТекстФункцииВызоваОбработчика = "Если ЛОЖЬ Тогда"; 
				КонецЕсли;
				ТекстФункцииВызоваОбработчика = ТекстФункцииВызоваОбработчика + Символы.ПС + ТегиДляПравила.ТегОткрытие + Символы.ПС + "ИначеЕсли "
					+ "ИмяФункции = """ + ИмяПроцедуры + """ Тогда " + Символы.ПС + Символы.Таб
					+ "Возврат " + ПараметрыМодуля.ПрефиксВызоваОбработчика + ИмяПроцедуры + ТекстПараметрыВызова + ";"
					+ ТегиДляПравила.ТегЗакрытие;
			Иначе
				ТекстФункцииВызоваОбработчика = ТекстФункцииВызоваОбработчика 
					+ ?(ТекстФункцииВызоваОбработчика = "", "Если ", Символы.ПС + "ИначеЕсли ")
					+ "ИмяФункции = """ + ИмяПроцедуры + """ Тогда " + Символы.ПС + Символы.Таб
					+ "Возврат " + ПараметрыМодуля.ПрефиксВызоваОбработчика + ИмяПроцедуры + ТекстПараметрыВызова + ";";
			КонецЕсли;
		Иначе
			
			ТекстОбработчика = Выборка[ИмяОбработчика];
			ПриВыгрузкеОбработчика(ИмяОбработчика, ТекстОбработчика, Выборка.ОбъектКонфигурации);
			ТекстОбработчикиЛокально = "Процедура " + ИмяПроцедуры + ТекстПараметрыПроцедуры + ПостфиксЗаголовкаОбработчика 
				+ Символы.ПС + ДобавитьОтступыВСтроку(ТекстОбработчика)
				+ Символы.ПС + "КонецПроцедуры";
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегОткрытие) Тогда
				Если ТекстПроцедурыВызоваОбработчика = "" Тогда
					ТекстПроцедурыВызоваОбработчика = "Если ЛОЖЬ Тогда";
				КонецЕсли;
				ТекстПроцедурыВызоваОбработчика = ТекстПроцедурыВызоваОбработчика + Символы.ПС + ТегиДляПравила.ТегОткрытие + Символы.ПС
					+  "ИначеЕсли " + "ИмяПроцедуры = """ + ИмяПроцедуры + """ Тогда " + Символы.ПС + Символы.Таб
					+ ПараметрыМодуля.ПрефиксВызоваОбработчика + ИмяПроцедуры + ТекстПараметрыВызова + ";"
					+ Символы.ПС + ТегиДляПравила.ТегЗакрытие;
			Иначе
				ТекстПроцедурыВызоваОбработчика = ТекстПроцедурыВызоваОбработчика 
					+ ?(ТекстПроцедурыВызоваОбработчика = "", "Если ", Символы.ПС + "ИначеЕсли ")
					+ "ИмяПроцедуры = """ + ИмяПроцедуры + """ Тогда " + Символы.ПС + Символы.Таб
					+ ПараметрыМодуля.ПрефиксВызоваОбработчика + ИмяПроцедуры + ТекстПараметрыВызова + ";";
			КонецЕсли;
		КонецЕсли;
			
		// Возможно, есть произвольные комментарии либо включен режим типизации переменных.
		Комментарий = РегистрыСведений.КомментарииКОбработчикам.ПрочитатьКомментарийКОбработчику(Выборка.Ссылка, ИмяОбработчика);
		Если НЕ ЗначениеЗаполнено(Комментарий) И ПараметрыМодуля.ИспользоватьТипизациюПеременных Тогда
			ИмяОбластиКомментарий = "Комментарий_"+ВидПравил+"_"+ИмяОбработчика; 
			ОбластьКомментарий = ПараметрыМодуля.МакетТекстовМодулейДетализацияКомментариев.ПолучитьОбласть(ИмяОбластиКомментарий);
			Комментарий = ОбластьКомментарий.ПолучитьТекст(); 
			Комментарий = СтрЗаменить(Комментарий, "#Область " + ИмяОбластиКомментарий, "");
			Если ИмяОбработчика = "ПриОбработке" Или ИмяОбработчика = "ПриКонвертацииДанныхXDTO"
				Или ИмяОбработчика = "ПередЗаписьюПолученныхДанных" Или ИмяОбработчика = "ПриОтправкеДанных" Тогда
				// Определить тип данных по правилу.
				Если ВидПравил = "ПКО" Тогда
					ОбъектКонфигурации = СокрЛП(Выборка.ОбъектКонфигурации);
				Иначе
					ОбъектКонфигурации = СокрЛП(Выборка.ОбъектВыборки);
				КонецЕсли;
				Комментарий = СтрЗаменить(Комментарий, "%ТипДанныеИБ%", ПолучитьТипОбъекта(ОбъектКонфигурации));
			КонецЕсли;
		КонецЕсли; 
		Если ЗначениеЗаполнено(Комментарий) Тогда
			ТекстОбработчикиЛокально = Комментарий + ТекстОбработчикиЛокально;
		КонецЕсли;
	КонецЕсли;
	ПараметрыМодуля.ТекстФункцииВызоваОбработчика = ТекстФункцииВызоваОбработчика;
	ПараметрыМодуля.ТекстПроцедурыВызоваОбработчика = ТекстПроцедурыВызоваОбработчика;
	Если ТекстОбработчикиЛокально <> "" Тогда
		Если ПараметрыМодуля.ГруппироватьПоОбъектамВыгрузки Тогда
			ТекстОбработчики = ТекстОбработчики + ?(ТекстОбработчики = "", "", Символы.ПС) + ТекстОбработчикиЛокально;
		Иначе
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегОткрытие) Тогда
				ТекстОбработчикиЛокально = ТегиДляПравила.ТегОткрытие + Символы.ПС + ТекстОбработчикиЛокально;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегЗакрытие) Тогда
				ТекстОбработчикиЛокально = ТекстОбработчикиЛокально + Символы.ПС + ТегиДляПравила.ТегЗакрытие;
			КонецЕсли;
			Если НЕ ПустаяСтрока(ТекГруппаПравил)
				И НЕ ПредопределеннаяГруппаПравил(ТекГруппаПравил) Тогда
				Если ТекстыПоГруппам.ОбработчикиКонвертацииПоГруппам.Свойство(ТекГруппаПравил) Тогда
					ТекстыПоГруппам.ОбработчикиКонвертацииПоГруппам[ТекГруппаПравил].ДобавитьСтроку(ТекстОбработчикиЛокально);
				Иначе
					РазделПравил = Новый ТекстовыйДокумент;
					РазделПравил.ДобавитьСтроку(ТекстОбработчикиЛокально);
					ТекстыПоГруппам.ОбработчикиКонвертацииПоГруппам.Вставить(ТекГруппаПравил, РазделПравил);
				КонецЕсли;
			Иначе
				ТекстыПоГруппам.ОбработчикиКонвертации.ДобавитьСтроку(ТекстОбработчикиЛокально);
			КонецЕсли;
		КонецЕсли; 
	КонецЕсли;
КонецПроцедуры
#КонецОбласти
#Область ВспомогательныеПроцедурыИФункции
// Дополнение для расширенного синтаксического контроля.
Процедура ПриВыгрузкеОбработчика(ИмяОбработчика, ТекстОбработчика, ОбъектКонфигурацииСтрокой)
	Если Не ВыгрузкаДляРасширенногоСинтаксическогоКонтроля Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОбъектКонфигурацииСтрокой) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяОбработчика = "ПриОтправкеДанных"
		Или ИмяОбработчика = "ПередЗаписьюПолученныхДанных"
		Или ИмяОбработчика = "ПриОбработке" Тогда
		
			Если Найти(ОбъектКонфигурацииСтрокой, "ДокументСсылка.") > 0 Тогда
				ТекстОбработчика = "ДанныеИБ = Документы." 
					+ СтрЗаменить(ОбъектКонфигурацииСтрокой, "ДокументСсылка.", "")
					+ ".СоздатьДокумент();"
					+ Символы.ПС
					+ ТекстОбработчика;
			ИначеЕсли Найти(ОбъектКонфигурацииСтрокой, "СправочникСсылка.") > 0 Тогда
				ТекстОбработчика = "ДанныеИБ = Справочники." 
					+ СтрЗаменить(ОбъектКонфигурацииСтрокой, "СправочникСсылка.", "")
					+ ".СоздатьЭлемент();"
					+ Символы.ПС
					+ ТекстОбработчика;
			КонецЕсли;
	КонецЕсли;
		
	Если ИмяОбработчика = "ПриКонвертацииДанныхXDTO"
		Или ИмяОбработчика = "ПередЗаписьюПолученныхДанных" Тогда
		
		Если Найти(ОбъектКонфигурацииСтрокой, "ДокументСсылка.") > 0 Тогда
				ТекстОбработчика = "ПолученныеДанные = Документы." 
					+ СтрЗаменить(ОбъектКонфигурацииСтрокой, "ДокументСсылка.", "")
					+ ".СоздатьДокумент();"
					+ Символы.ПС
					+ ТекстОбработчика;
			ИначеЕсли Найти(ОбъектКонфигурацииСтрокой, "СправочникСсылка.") > 0 Тогда
				ТекстОбработчика = "ПолученныеДанные = Справочники." 
					+ СтрЗаменить(ОбъектКонфигурацииСтрокой, "СправочникСсылка.", "")
					+ ".СоздатьЭлемент();"
					+ Символы.ПС
					+ ТекстОбработчика;
			КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Вычисление тип объекта выборки для добавления в таблицу правил.
Функция ПолучитьТипМетаданные(ТипОбъектаВыборки, ОбъектВыборки, БезМетаданных = Ложь)
	Если СокрЛП(ОбъектВыборки) = "" Тогда
		Возврат "Неопределено";
	КонецЕсли;
	
	Если БезМетаданных Тогда
		ТипМетаданные = "";
	Иначе
		ТипМетаданные = "Метаданные.";
	КонецЕсли;
	
	ИмяОбъекта = СокрЛП(ОбъектВыборки);
	ИмяОбъекта = Прав(ИмяОбъекта, СтрДлина(ИмяОбъекта) - Найти(ИмяОбъекта,"."));
	Если ТипОбъектаВыборки = Перечисления.ТипыОбъектов.Справочник
		Или Найти(НРег(ОбъектВыборки), НРег("СправочникСсылка.")) > 0 Тогда
		ТипОбъекта = "Справочники";
	ИначеЕсли ТипОбъектаВыборки = Перечисления.ТипыОбъектов.Документ
		Или Найти(НРег(ОбъектВыборки), НРег("ДокументСсылка.")) > 0 Тогда
		ТипОбъекта = "Документы";
	ИначеЕсли ТипОбъектаВыборки = Перечисления.ТипыОбъектов.БизнесПроцесс
		Или Найти(НРег(ОбъектВыборки), НРег("БизнесПроцессСсылка.")) > 0 Тогда
		ТипОбъекта = "БизнесПроцессы";
	ИначеЕсли ТипОбъектаВыборки = Перечисления.ТипыОбъектов.Задача
		Или Найти(НРег(ОбъектВыборки), НРег("ЗадачаСсылка.")) > 0 Тогда
		ТипОбъекта = "Задачи";
	ИначеЕсли ТипОбъектаВыборки = Перечисления.ТипыОбъектов.НаборКонстант
		Или Найти(НРег(ОбъектВыборки), НРег("КонстантыНабор")) > 0 Тогда
		ТипОбъекта = "Константы";
	ИначеЕсли ТипОбъектаВыборки = Перечисления.ТипыОбъектов.ПланВидовХарактеристик
		Или Найти(НРег(ОбъектВыборки), НРег("ПланВидовХарактеристикСсылка.")) > 0 Тогда
		ТипОбъекта = "ПланыВидовХарактеристик";
	ИначеЕсли ТипОбъектаВыборки = Перечисления.ТипыОбъектов.Перечисление
		Или Найти(НРег(ОбъектВыборки), НРег("ПеречислениеСсылка.")) > 0 Тогда
		ТипОбъекта = "Перечисления";
	ИначеЕсли ТипОбъектаВыборки = Перечисления.ТипыОбъектов.РегистрСведений
		Или Найти(НРег(ОбъектВыборки), НРег("РегистрСведенийЗапись.")) > 0 Тогда
		ТипОбъекта = "РегистрыСведений";
	Иначе
		ТипОбъекта = "";
	КонецЕсли;
	Возврат ТипМетаданные+ТипОбъекта+"."+ИмяОбъекта;
КонецФункции

// Вычисление типа объекта для добавления в комментарий к обработчику.
Функция ПолучитьТипОбъекта(ТипСсылки)
	ПозицияТочки = СтрНайти(ТипСсылки, ".");
	Если ПозицияТочки = 0 Тогда
		Возврат "Произвольный";
	КонецЕсли;
	ТипСсылкиаДляПоиска = НРег(ТипСсылки);
	Если Найти(ТипСсылкиаДляПоиска, НРег("СправочникСсылка.")) > 0
		Или Найти(ТипСсылкиаДляПоиска, НРег("Справочник.")) > 0 Тогда
		ТипОбъекта = "СправочникОбъект";
	ИначеЕсли Найти(ТипСсылкиаДляПоиска, НРег("ДокументСсылка.")) > 0 
		Или Найти(ТипСсылкиаДляПоиска, НРег("Документ.")) > 0  Тогда
		ТипОбъекта = "ДокументОбъект";
	ИначеЕсли Найти(ТипСсылкиаДляПоиска, НРег("БизнесПроцессСсылка.")) > 0 Тогда
		ТипОбъекта = "БизнесПроцессОбъект";
	ИначеЕсли Найти(ТипСсылкиаДляПоиска, НРег("ЗадачаСсылка.")) > 0 Тогда
		ТипОбъекта = "ЗадачаОбъект";
	ИначеЕсли Найти(ТипСсылкиаДляПоиска, НРег("ПланВидовХарактеристикСсылка.")) > 0 Тогда
		ТипОбъекта = "ПланыВидовХарактеристикОбъект";
	ИначеЕсли Найти(ТипСсылкиаДляПоиска, НРег("ПеречислениеСсылка.")) > 0 Тогда
		ТипОбъекта = "ПеречислениеСсылка";
	ИначеЕсли Найти(ТипСсылкиаДляПоиска, НРег("РегистрСведенийЗапись.")) > 0 Тогда
		ТипОбъекта = "РегистрСведенийЗапись";
	Иначе
		Возврат "Произвольный";
	КонецЕсли;
	Возврат ТипОбъекта + Сред(ТипСсылки, ПозицияТочки);
КонецФункции

// Добавление отступа для помещения текста обработчика в процедуру обработчика.
Функция ДобавитьОтступыВСтроку(СтрокаАлгоритма, СжиматьПробелы = Истина)
	Если СжиматьПробелы Тогда
		ТекСтрокаАлгоритма = СокрЛП(СтрокаАлгоритма);
	Иначе
		ТекСтрокаАлгоритма = СтрокаАлгоритма;
	КонецЕсли;
	Возврат Символы.Таб + СтрЗаменить(ТекСтрокаАлгоритма, Символы.ПС, Символы.ПС + Символы.Таб);
КонецФункции

// Добавление отступа в тестовый документ.
Функция ДобавитьОтступыВТекстовыйДокумент(ИсходныйДокумент)
	ПреобразованныйДокумент = Новый ТекстовыйДокумент;
	Для Стр = 0 По ИсходныйДокумент.КоличествоСтрок() Цикл
		ТекСтрока = ИсходныйДокумент.ПолучитьСтроку(Стр);
		СтрокаСОтступом = Символы.Таб + СокрЛП(ТекСтрока);
		ПреобразованныйДокумент.ДобавитьСтроку(СтрокаСОтступом);
	КонецЦикла;
	Возврат ПреобразованныйДокумент.ПолучитьТекст();
КонецФункции

// Объединение текстов для отправки, для получения и общего в один текст с обрамлением условиями по направлению обмена.
Процедура ДополнитьТекстПроцедурыСУсловиями(ТекстПроцедуры, ТекстДляОтправки, ТекстДляПолучения, ТекстОбщий)
	СтрокаТекстДляОтправки = ТекстДляОтправки.ПолучитьТекст();
	Если СокрЛП(СтрокаТекстДляОтправки) <> "" Тогда
		ТекстПроцедуры.ДобавитьСтроку(""+Символы.Таб+"Если НаправлениеОбмена = ""Отправка"" Тогда");
		ТекстПроцедуры.ДобавитьСтроку(""+Символы.Таб+ДобавитьОтступыВСтроку(СтрокаТекстДляОтправки));
		ТекстПроцедуры.ДобавитьСтроку(""+Символы.Таб+"КонецЕсли;");
	КонецЕсли;
	СтрокаТекстДляПолучения = ТекстДляПолучения.ПолучитьТекст();
	Если СокрЛП(СтрокаТекстДляПолучения) <> "" Тогда
		ТекстПроцедуры.ДобавитьСтроку(""+Символы.Таб+"Если НаправлениеОбмена = ""Получение"" Тогда");
		ТекстПроцедуры.ДобавитьСтроку(""+Символы.Таб+ДобавитьОтступыВСтроку(СтрокаТекстДляПолучения));
		ТекстПроцедуры.ДобавитьСтроку(""+Символы.Таб+"КонецЕсли;");
	КонецЕсли;
	СтрокаТекстОбщий = ТекстОбщий.ПолучитьТекст();
	Если СокрЛП(СтрокаТекстОбщий) <> "" Тогда
		ТекстПроцедуры.ДобавитьСтроку(СтрокаТекстОбщий);
	КонецЕсли;
КонецПроцедуры

// Формирование текста запроса к правилам при выключенной совместной работе.
Функция ТекстЗапросаБезСовместнойРаботы(ИмяСправочника)
	Возврат "ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Правила
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|	И СоставыКонвертаций.Владелец = &Конвертация
	|	И СоставыКонвертаций.Отключить = ЛОЖЬ
	|ГДЕ Правила.ПометкаУдаления = ЛОЖЬ 
	|	И Правила.ВременнаяКопия = ЛОЖЬ";	
КонецФункции

// Формирование текста запроса к правилам при формировании модуля на основании хранилища.
Функция ТекстЗапросаВсеИзХранилища(ИмяСправочника)
	Возврат "ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Правила
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|	И СоставыКонвертаций.Владелец = &Конвертация
	|	И СоставыКонвертаций.Отключить = ЛОЖЬ
	|ГДЕ Правила.ПометкаУдаления = ЛОЖЬ
	|	И Правила.ВременнаяКопия = ЛОЖЬ
	|	И (Правила.Захвачен = ЛОЖЬ
	|	ИЛИ Правила.Копия = ИСТИНА)";
КонецФункции

// Формирование текста запроса к правилам при формировании модуля по текущему состоянию.
Функция ТекстЗапросаСвоиДоработки(ИмяСправочника)
	Возврат "ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Правила
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|	И СоставыКонвертаций.Владелец = &Конвертация
	|	И СоставыКонвертаций.Отключить = ЛОЖЬ
	|ГДЕ Правила.ПометкаУдаления = ЛОЖЬ
	|	И Правила.Захвачен = ЛОЖЬ
	|	И Правила.ВременнаяКопия = ЛОЖЬ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правила.Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Правила
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|	И СоставыКонвертаций.Владелец = &Конвертация
	|	И СоставыКонвертаций.Отключить = ЛОЖЬ
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СовместнаяРаботаСОбъектами.СрезПоследних(, Объект ССЫЛКА Справочник." + ИмяСправочника +"
	|				И Действие = ЗНАЧЕНИЕ(Перечисление.ДействияПриСовместнойРаботе.Захват)) КАК ДанныеЗахвата
	|ПО ДанныеЗахвата.РабочаяКопия = Правила.Ссылка
	|	И ДанныеЗахвата.Пользователь <> &ТекущийПользователь
	|ГДЕ Правила.ПометкаУдаления = ЛОЖЬ
	|	И Правила.Копия = ИСТИНА   
	|	И Правила.ВременнаяКопия = ЛОЖЬ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|	Правила.Ссылка
	|ИЗ Справочник." + ИмяСправочника + " КАК Правила
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|	И СоставыКонвертаций.Владелец = &Конвертация
	|	И СоставыКонвертаций.Отключить = ЛОЖЬ
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|	РегистрСведений.СовместнаяРаботаСОбъектами.СрезПоследних(, Объект ССЫЛКА Справочник." + ИмяСправочника +"
	|				И Действие = ЗНАЧЕНИЕ(Перечисление.ДействияПриСовместнойРаботе.Захват)) КАК ДанныеЗахвата
	|ПО ДанныеЗахвата.Объект = Правила.Ссылка
	|	И ДанныеЗахвата.Пользователь = &ТекущийПользователь
	|ГДЕ Правила.ПометкаУдаления = ЛОЖЬ
	|	И Правила.Копия = ЛОЖЬ И Правила.Захвачен = ИСТИНА
	|	И Правила.ВременнаяКопия = ЛОЖЬ
	|";
	
КонецФункции

// Проверка является ли группа правил предопределенной.
Функция ПредопределеннаяГруппаПравил(ТекГруппаПравил)
	Если ТекГруппаПравил = "_Все_правила_" Или ТекГруппаПравил = "_Без_группы_" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Приведение имени группы правил к виду пригодному для модуля.
Процедура ПривестиИмяГруппыПравил(ТекГруппаПравил)
	ТекГруппаПравил = СокрЛП(ТекГруппаПравил);
	ТекГруппаПравил = СтроковыеФункцииКлиентСервер.ЗаменитьОдниСимволыДругими(" /\,.-()<>", ТекГруппаПравил, "__________"); 
КонецПроцедуры

#КонецОбласти
#Область ПроцедурыВычисленияТегов
Функция ПолучитьТегиДляПравила(ПравилоСсылка, ПараметрыМодуля)
	Если ПараметрыМодуля.ДобавлятьТеги = Ложь Тогда
		Возврат Новый Структура("ТегОткрытие, ТегЗакрытие", "", "");
	КонецЕсли;
	СтрокиТЧ = ПравилоСсылка.Теги.Выгрузить();
	Если СтрокиТЧ.Количество() = 0 Тогда
		Возврат Новый Структура("ТегОткрытие, ТегЗакрытие", "", "");
	КонецЕсли;
	ТегОткрытие = "";
	ТегЗакрытие = "";
	Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
		ТегОткрытие = ТегОткрытие + ?(ТегОткрытие = "", "", Символы.ПС + Символы.ПС) + "//++ " + СокрЛП(СтрокаТЧ.Тег.Наименование);
		ТегЗакрытие = "//-- " + СокрЛП(СтрокаТЧ.Тег.Наименование) + ?(ТегЗакрытие = "", "", Символы.ПС + Символы.ПС + ТегЗакрытие);
	КонецЦикла;
	ТекСхлопывание = ТегЗакрытие + Символы.ПС + ТегОткрытие;
	Если ПараметрыМодуля.СхлопываниеТегов.Найти(ТекСхлопывание) = Неопределено Тогда
		ПараметрыМодуля.СхлопываниеТегов.Добавить(ТекСхлопывание);
		Схлопывание1Отступ = ДобавитьОтступыВСтроку(ТекСхлопывание, Ложь);
		ПараметрыМодуля.СхлопываниеТегов.Добавить(Схлопывание1Отступ);
		Схлопывание2Отступ = ДобавитьОтступыВСтроку(Схлопывание1Отступ, Ложь);
		ПараметрыМодуля.СхлопываниеТегов.Добавить(Схлопывание2Отступ);
		ДлинаТега = СтрЧислоСтрок(ТекСхлопывание);
		Если ДлинаТега > ПараметрыМодуля.МаксимальнаяДлинаТега Тогда
			ПараметрыМодуля.МаксимальнаяДлинаТега = ДлинаТега;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("ТегОткрытие, ТегЗакрытие", ТегОткрытие, ТегЗакрытие)
КонецФункции

Процедура ВыполнитьСхлопываниеТеговВМодуле(ПараметрыМодуля, ОбщийТекстМодуля)
	ТекДлинаТега = ПараметрыМодуля.МаксимальнаяДлинаТега;
	Пока ТекДлинаТега > 0 Цикл
		Для Каждого СхлТег Из ПараметрыМодуля.СхлопываниеТегов Цикл
			Если СтрЧислоСтрок(СхлТег) = ТекДлинаТега Тогда
				ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, Символы.ПС + СхлТег + Символы.ПС, Символы.ПС);
			КонецЕсли;
		КонецЦикла;
		ТекДлинаТега = ТекДлинаТега - 2;
	КонецЦикла;
	
	// После схлопывания тегов может остаться склеенная строка.
	ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, "КонецПроцедурыПроцедура", "КонецПроцедуры" + Символы.ПС + "Процедура");
	ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, "КонецФункцииПроцедура", "КонецФункции" + Символы.ПС + "Процедура");
	ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, "КонецФункцииФункция", "КонецФункции" + Символы.ПС + "Функция");
	ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, "КонецПроцедурыФункция", "КонецПроцедуры" + Символы.ПС + "Функция");
	
	Для Каждого ТекТегЗакрытие Из ПараметрыМодуля.ВсеТеги Цикл
		Для Каждого ТекТегОткрытие Из ПараметрыМодуля.ВсеТеги Цикл
			Если ТекТегЗакрытие = ТекТегОткрытие Тогда
				Продолжить;
			КонецЕсли;
			НайтиИЗаменитьСклеенныйТег(ОбщийТекстМодуля, ТекТегОткрытие, ТекТегЗакрытие);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура НайтиИЗаменитьСклеенныйТег(ОбщийТекстМодуля, ТекТегОткрытие, ТекТегЗакрытие)
	ПодстрокаПоиска = "//-- " + ТекТегЗакрытие + Символы.ПС + "//++ " + ТекТегОткрытие;
	ПодстрокаЗамены = "//-- " + ТекТегЗакрытие + Символы.ПС + Символы.ПС + "//++ " + ТекТегОткрытие;
	ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, ПодстрокаПоиска, ПодстрокаЗамены);
	ПодстрокаПоискаОтступ1 = ДобавитьОтступыВСтроку(ПодстрокаПоиска);
	ПодстрокаЗаменыОтступ1 = ДобавитьОтступыВСтроку(ПодстрокаЗамены); 
	ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, ПодстрокаПоискаОтступ1, ПодстрокаЗаменыОтступ1);
	ПодстрокаПоискаОтступ2 = ДобавитьОтступыВСтроку(ПодстрокаПоискаОтступ1);
	ПодстрокаЗаменыОтступ2 = ДобавитьОтступыВСтроку(ПодстрокаЗаменыОтступ1);
	ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, ПодстрокаПоискаОтступ2, ПодстрокаЗаменыОтступ2);
	ПодстрокаПоискаОтступ3 = ДобавитьОтступыВСтроку(ПодстрокаПоискаОтступ3);
	ПодстрокаЗаменыОтступ3 = ДобавитьОтступыВСтроку(ПодстрокаЗаменыОтступ3);
	ОбщийТекстМодуля = СтрЗаменить(ОбщийТекстМодуля, ПодстрокаПоискаОтступ3, ПодстрокаЗаменыОтступ3);
КонецПроцедуры

Процедура УдалитьПоследнийПереводСтроки(СтрокаДляДобавления) 
	Если Прав(СтрокаДляДобавления, 1) = Символы.ПС Тогда
		СтрокаДляДобавления = Сред(СтрокаДляДобавления,1, СтрДлина(СтрокаДляДобавления)-1);
	КонецЕсли;
КонецПроцедуры
#КонецОбласти
#КонецОбласти
#КонецЕсли