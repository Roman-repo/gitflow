	ИначеЕсли ТипЗнч(Правило) = Тип("СправочникСсылка.Алгоритмы") Тогда
		ДанныеАлгоритма = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Правило, "Код, Параметры, Алгоритм, ЭтоФункция, Экспортный, Комментарий");
		ДобавитьТекстАлгоритма(ТекстПроцедуры, ДанныеАлгоритма, Ложь, Ложь);
	КонецЕсли; 
	КоличествоСтрок = ТекстПроцедуры.КоличествоСтрок();
	Для ОбратныйСчетчик = 0 По КоличествоСтрок - 1 Цикл
		
		НомерСтроки = КоличествоСтрок - ОбратныйСчетчик;
		
		Строка = ТекстПроцедуры.ПолучитьСтроку(НомерСтроки);
		Если Найти(Строка, "---") > 0 Тогда
			ТекстПроцедуры.УдалитьСтроку(НомерСтроки);
		КонецЕсли;
	КонецЦикла;

	Возврат ТекстПроцедуры;
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
#Область СРазделениемМодулей
// Заполнение модуля с правилами (документы, прочее, опциональный модуль).


Процедура ЗаполнитьДополнительныйМодуль_Правила(СтрМодуль, ПараметрыМодуля)
	ОбщийТекстМодуля = Новый ТекстовыйДокумент;
	
	ТекстыПоГруппам = Новый Структура;
	ТекстыПоГруппам.Вставить("СлужебныеПроцедурыИФункции", Новый ТекстовыйДокумент);
	ТекстыПоГруппам.Вставить("СлужебныеПроцедурыИФункции_ПОД", Новый ТекстовыйДокумент);
	ТекстыПоГруппам.Вставить("СлужебныеПроцедурыИФункцииПоГруппам_ПОД", Новый Структура);
	ТекстыПоГруппам.Вставить("СлужебныеПроцедурыИФункции_ПКО", Новый ТекстовыйДокумент);
	ТекстыПоГруппам.Вставить("СлужебныеПроцедурыИФункцииПоГруппам_ПКО", Новый Структура);
	ТекстыПоГруппам.Вставить("СлужебныеПроцедурыИФункцииПоГруппам", Новый Структура);

	ТекстыПоГруппам.Вставить("ОбработчикиКонвертации", Новый ТекстовыйДокумент);
	ТекстыПоГруппам.Вставить("ОбработчикиКонвертацииПоГруппам", Новый Структура);
	
	// Дополнение параметров модуля отбором.
	ПараметрыМодуля.Вставить("ТекущийМодуль", СтрМодуль);
	
	ЗаполнитьТекстПроцедурыПОД(ТекстыПоГруппам, ПараметрыМодуля);

	ЗаполнитьТекстПроцедурыПКО(ТекстыПоГруппам, ПараметрыМодуля);
	
	Если СтрМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.Пользовательский И НЕ СтрМодуль.ЭтоМодульМенеджера Тогда
		ЗаполнитьТекстПроцедурыАлгоритмы(ТекстыПоГруппам, ПараметрыМодуля);
	КонецЕсли;
	
	ДобавитьПроцедурыВТекстМодуля(ОбщийТекстМодуля, ТекстыПоГруппам, ПараметрыМодуля, СтрМодуль.ЭтоМодульМенеджера);

	// После заполнения модуля подменить вызовы алгоритмов
	СтрМодуль.ТекстМодуля = ОбщийТекстМодуля; 
КонецПроцедуры  

// Заполнение модуля с алгоритмами.
Процедура ЗаполнитьДополнительныйМодуль_Алгоритмы(СтрМодуль, ПараметрыМодуля)  
	ОбщийТекстМодуля = Новый ТекстовыйДокумент; 
    // Дополнение параметров модуля отбором.
	ПараметрыМодуля.Вставить("ТекущийМодуль", СтрМодуль);

	ТекстыПоГруппам = Новый Структура;
	ТекстыПоГруппам.Вставить("СлужебныеПроцедурыИФункцииПоГруппам", Новый Структура);

	ЗаполнитьТекстПроцедурыАлгоритмы(ТекстыПоГруппам, ПараметрыМодуля); 
	
	ОбщийТекстМодуля.ДобавитьСтроку("#Область СлужебныеПроцедурыИФункции");
	ОбщийТекстМодуля.ДобавитьСтроку("#Область Алгоритмы");
	ОбщийТекстМодуля.ДобавитьСтроку(ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам.Алгоритмы.ПолучитьТекст());
	ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	УдалитьЛишниеСтрокиИзМодуля(ОбщийТекстМодуля);
	СтрМодуль.ТекстМодуля = ОбщийТекстМодуля; 
КонецПроцедуры

// Заполнение базисного модуля.
Процедура ЗаполнитьБазисныйМодуль(СтрМодуль, ПараметрыМодуля)
	ОбщийТекстМодуля = Новый ТекстовыйДокумент;
	ДобавитьЗаголовокМодуля(ОбщийТекстМодуля);
	
	ОбщийТекстМодуля.ДобавитьСтроку("#Область СлужебныйПрограммныйИнтерфейс");
	// Обработчики конвертации и версия формата.
	ОбщийТекстМодуля.ДобавитьСтроку(ЗаполнитьТекстПроцедурыКонвертации(ПараметрыМодуля.МакетТекстовМодулей)); 
	ВерсияФорматаМенеджераТекст = ПолучитьВерсиюФорматаМенеджера(ПараметрыМодуля.МакетТекстовМодулей);
	ОбщийТекстМодуля.ДобавитьСтроку(ВерсияФорматаМенеджераТекст); 

	// Заполнение таблиц ПОД и ПКО 
	ДобавитьПроцедурыПОДиПКОВМодуль(ПараметрыМодуля);
	
	ЗаполнитьТекстПроцедурыПКПД(ПараметрыМодуля);
	
	// Процедуры вызова обработчиков. 
	ЗаполнитьТекстПроцедурыВызоваОбработчиков(ПараметрыМодуля);
	
	ОбщийТекстМодуля.ДобавитьСтроку(ПараметрыМодуля.ПрограммныйИнтерфейс.ПолучитьТекст());
	
	// Параметры конвертации.
	ЗаполнитьТекстПроцедурыПараметры(ПараметрыМодуля, ОбщийТекстМодуля);
	
	ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти");
	ОбщийТекстМодуля.ДобавитьСтроку("#Область СлужебныеПроцедурыИФункции");
	ДобавитьУИДМодуля(ОбщийТекстМодуля);
	ОбщийТекстМодуля.ДобавитьСтроку("#КонецОбласти"); 
	УдалитьЛишниеСтрокиИзМодуля(ОбщийТекстМодуля);
	СтрМодуль.ТекстМодуля = ОбщийТекстМодуля;
КонецПроцедуры

// Заполнение модулей которые выгружаются в модули менеджера.
Процедура ЗаполнитьМодулиМенеджеров(Результат, ПараметрыМодуля) 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Свод.Объект КАК Объект,
	|	Свод.Объект.Тип КАК Тип,
	|	Свод.Объект.Имя КАК Имя,
	|	Свод.Ссылка КАК Правило,
	|	ЭтоПОД
	|ИЗ
	|	(    
	|// ПОД с явно указанным объектом для выгрузки модуля менеджера
	|	ВЫБРАТЬ
	|		Правила.Ссылка КАК Ссылка,
	|		Правила.ОбъектКонфигурацииДляВыгрузкиМодуля КАК Объект,
	|		ИСТИНА КАК ЭтоПОД
	|	ИЗ Справочник.ПравилаОбработкиДанных КАК Правила
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|	ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|		И СоставыКонвертаций.Владелец = &Конвертация
	|		И СоставыКонвертаций.Отключить = ЛОЖЬ
	|	ГДЕ Правила.ПометкаУдаления = ЛОЖЬ
	|		И Правила.ВыгружатьВМодульМенеджера = ИСТИНА
	|		И Правила.ОбъектКонфигурацииДляВыгрузкиМодуля <> ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
	|
	|	ОБЪЕДИНИТЬ ВСЕ  
	|// ПОД для отправки, объект конфигурации указан в правиле
	|	ВЫБРАТЬ
	|		Правила.Ссылка КАК Ссылка,
	|		ВЫРАЗИТЬ(Правила.ОбъектВыборки КАК Справочник.Объекты) КАК Объект,
	|		ИСТИНА КАК ЭтоПОД
	|	ИЗ Справочник.ПравилаОбработкиДанных КАК Правила
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|	ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|		И СоставыКонвертаций.Владелец = &Конвертация
	|		И СоставыКонвертаций.Отключить = ЛОЖЬ
	|	ГДЕ Правила.ПометкаУдаления = ЛОЖЬ И Правила.ИспользоватьДляОтправки = ИСТИНА
	|		И Правила.ВыгружатьВМодульМенеджера = ИСТИНА
	|		И Правила.ОбъектКонфигурацииДляВыгрузкиМодуля = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
	|		И ВЫРАЗИТЬ(Правила.ОбъектВыборки КАК Справочник.Объекты) <> ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|// ПОД для получения с ПКО в ТЧ
	|	ВЫБРАТЬ
	|		Правила.Ссылка КАК Ссылка,
	|		ПКО.ОбъектКонфигурации КАК Объект,
	|		ИСТИНА КАК ЭтоПОД
	|	ИЗ Справочник.ПравилаОбработкиДанных.ПравилаКонвертацииОбъектов КАК Правила
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|	ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|		И СоставыКонвертаций.Владелец = &Конвертация
	|		И СоставыКонвертаций.Отключить = ЛОЖЬ 
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.ПравилаКонвертацииОбъектов КАК ПКО
	|	ПО (ПКО.Код = Правила.ПравилоКонвертацииОбъекта)
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.СоставыКонвертаций КАК СоставыКонвертаций2
	|	ПО СоставыКонвертаций2.ЭлементКонвертации = ПКО.Ссылка
	|		И СоставыКонвертаций2.Владелец = &Конвертация
	|		И СоставыКонвертаций2.Отключить = ЛОЖЬ 
	|	ГДЕ Правила.Ссылка.ПометкаУдаления = ЛОЖЬ И Правила.Ссылка.ИспользоватьДляПолучения = ИСТИНА
	|		И Правила.Ссылка.ВыгружатьВМодульМенеджера = ИСТИНА
	|		И Правила.Ссылка.ОбъектКонфигурацииДляВыгрузкиМодуля = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
    |// ПОД для получения с ПКО в Ш
	|	ВЫБРАТЬ
	|		Правила.Ссылка КАК Ссылка,
	|		ПКО.ОбъектКонфигурации КАК Объект,
	|		ИСТИНА КАК ЭтоПОД
	|	ИЗ Справочник.ПравилаОбработкиДанных КАК Правила
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|	ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|		И СоставыКонвертаций.Владелец = &Конвертация
	|		И СоставыКонвертаций.Отключить = ЛОЖЬ 
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.ПравилаКонвертацииОбъектов КАК ПКО
	|	ПО (ПКО.Код = Правила.ПравилоКонвертацииОбъекта)
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.СоставыКонвертаций КАК СоставыКонвертаций2
	|	ПО СоставыКонвертаций2.ЭлементКонвертации = ПКО.Ссылка
	|		И СоставыКонвертаций2.Владелец = &Конвертация
	|		И СоставыКонвертаций2.Отключить = ЛОЖЬ 
	|	ГДЕ Правила.ПометкаУдаления = ЛОЖЬ И Правила.ИспользоватьДляПолучения = ИСТИНА
	|		И Правила.ВыгружатьВМодульМенеджера = ИСТИНА 
	|		И Правила.ОбъектКонфигурацииДляВыгрузкиМодуля = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Правила.Ссылка КАК Ссылка,
	|		ВЫБОР КОГДА Правила.ОбъектКонфигурацииДляВыгрузкиМодуля <> ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка) ТОГДА
	|			Правила.ОбъектКонфигурацииДляВыгрузкиМодуля
	|		ИНАЧЕ Правила.ОбъектКонфигурации КОНЕЦ КАК Объект,
	|		ЛОЖЬ КАК ЭтоПОД
	|	ИЗ Справочник.ПравилаКонвертацииОбъектов КАК Правила
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ 
	|		Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|	ПО СоставыКонвертаций.ЭлементКонвертации = Правила.Ссылка
	|		И СоставыКонвертаций.Владелец = &Конвертация
	|		И СоставыКонвертаций.Отключить = ЛОЖЬ
	|	ГДЕ Правила.ПометкаУдаления = ЛОЖЬ И Правила.ВыгружатьВМодульМенеджера = ИСТИНА) КАК Свод
	|ИТОГИ ПО Свод.Объект";
	Запрос.УстановитьПараметр("Конвертация", Конвертация);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	ВыборкаОбъекты = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОбъекты.Следующий() Цикл
		МассивПОД = Новый Массив;
		МассивПКО = Новый Массив;
		ВыборкаПравило = ВыборкаОбъекты.Выбрать();
		Пока ВыборкаПравило.Следующий() Цикл
			Если ВыборкаПравило.ЭтоПОД Тогда
				МассивПОД.Добавить(ВыборкаПравило.Правило);
			Иначе
				МассивПКО.Добавить(ВыборкаПравило.Правило);
			КонецЕсли;
		КонецЦикла;
		
		// Добавляем модуль в таблицу модулей.
		СтрокаМодуль = ПараметрыМодуля.Модули.Добавить();
		СтрокаМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.Пользовательский;
		СтрокаМодуль.Ссылка = ВыборкаОбъекты.Объект; 
		// Наименование это путь к вызову процедур модуля, например: Документы.АвансовыйОтчет.
		Если ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.Документ Тогда
			ИмяМодуля = "Документы."; 
			ИмяПапки = "Documents";
		ИначеЕсли ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.Задача Тогда
            ИмяМодуля = "Задачи.";
			ИмяПапки = "Tasks";
		ИначеЕсли ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.Справочник Тогда
			ИмяМодуля = "Справочники.";
			ИмяПапки = "Catalogs";
		ИначеЕсли ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.ПланВидовХарактеристик Тогда
			ИмяМодуля = "ПланыВидовХарактеристик."; 
			ИмяПапки = "ChartsOfCharacteristicTypes";
		ИначеЕсли ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.ПланВидовРасчета Тогда
			ИмяМодуля = "ПланыВидовРасчета."; 
			ИмяПапки = "ChartsOfCalculationTypes";
		ИначеЕсли ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.РегистрСведений Тогда
			ИмяМодуля = "РегистрыСведений.";
			ИмяПапки = "InformationRegisters";
		ИначеЕсли ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.РегистрНакопления Тогда 
			ИмяМодуля = "РегистрыНакопления.";
			ИмяПапки = "AccumulationRegisters";
		ИначеЕсли ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.РегистрРасчета Тогда
			ИмяМодуля = "РегистрыРасчета.";
			ИмяПапки = "CalculationRegisters"; 
		ИначеЕсли ВыборкаОбъекты.Тип = Перечисления.ТипыОбъектов.РегистрБухгалтерии Тогда 
			ИмяМодуля = "РегистрыНакопления.";
			ИмяПапки = "AccumulationRegisters";

		КонецЕсли;
		СтрокаМодуль.Наименование = ИмяМодуля + СокрЛП(ВыборкаОбъекты.Имя); 
		СтрокаМодуль.ЭтоМодульМенеджера = Истина;
		
		// Добавим отбор в параметры модуля.
		ПараметрыМодуля.Вставить("МассивПОД", МассивПОД);
		ПараметрыМодуля.Вставить("МассивПКО", МассивПКО);
		
		// формируем текст модуля.
		ЗаполнитьДополнительныйМодуль_Правила(СтрокаМодуль, ПараметрыМодуля);
		// Добавляем теги. 
		ТегиДляМодуляМенеджера = КонвертацияДанныхXDTOСервер.ТегиДляМодуляМенеджераОбъекта();
        СтрокаМодуль.ТекстМодуля.ВставитьСтроку(1, ТегиДляМодуляМенеджера.ТегОткрытие);
		СтрокаМодуль.ТекстМодуля.ДобавитьСтроку(ТегиДляМодуляМенеджера.ТегЗакрытие);
		КаталогиМодулейМенеджеров = Неопределено;
		Результат.Свойство("КаталогиМодулейМенеджеров", КаталогиМодулейМенеджеров);
		Если КаталогиМодулейМенеджеров = Неопределено Тогда
			КаталогиМодулейМенеджеров = Новый Структура;
		КонецЕсли;
		ИмяМодуляДляВозврата = СтрЗаменить(СокрЛП(СтрокаМодуль.Наименование), ".", "_");
		КаталогиМодулейМенеджеров.Вставить(ИмяМодуляДляВозврата, ИмяПапки);
		Результат.Вставить("КаталогиМодулейМенеджеров", КаталогиМодулейМенеджеров);
	КонецЦикла;
	
КонецПроцедуры 

// Обход строк модуля с целью замены вызовов алгоритмов.
Процедура ЗаменитьВызовыАлгоритмов(ПараметрыМодуля, ОбщийТекстМодуля)
	ВызовыАлгоритмов = ПараметрыМодуля.ВызовыАлгоритмов;
    КоличествоСтрок = ОбщийТекстМодуля.КоличествоСтрок();
	Для ОбратныйСчетчик = 0 По КоличествоСтрок - 1 Цикл
		
		НомерСтроки = КоличествоСтрок - ОбратныйСчетчик;
		
		Строка = ОбщийТекстМодуля.ПолучитьСтроку(НомерСтроки);
		СтрокаЗамены = РезультатЗаменыВызоваАлгоритма(Строка, ВызовыАлгоритмов); 
		Если СтрокаЗамены <> "" Тогда
			ОбщийТекстМодуля.ЗаменитьСтроку(НомерСтроки, СтрокаЗамены);
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

// Поиск и при необходимости замена вызова алгоритма в строке модуля.
Функция РезультатЗаменыВызоваАлгоритма(Знач Строка, ВызовыАлгоритмов)
	// 1. Поиск вызова из обработчика.
	СтрокаИсходная = Строка;
	КоличествоСкобок = СтрЧислоВхождений(Строка, "("); 
	СтрокаДляПоиска = НРег(СокрЛП(Строка)); 
	УжеЗаменено = Новый Массив;
	Если КоличествоСкобок > 0
		И СтрНайти(НРег(СтрокаДляПоиска), "процедура") = 0 И СтрНайти(НРег(СтрокаДляПоиска), "функция") = 0 Тогда
		Для НомерВхождения = 1 По КоличествоСкобок Цикл
			ПозицияСкобки = СтрНайти(Строка, "(",,, НомерВхождения);
			Если ПозицияСкобки > 0 Тогда
				ПозицияСкобкиВСтрокеПоиска = СтрНайти(СтрокаДляПоиска, "(",,, НомерВхождения);
				Если ПозицияСкобкиВСтрокеПоиска > 1 Тогда
					ПозицияПробелаВСтрокеПоиска = СтрНайти(СтрокаДляПоиска, " ", НаправлениеПоиска.СКонца, ПозицияСкобкиВСтрокеПоиска - 1, 1); 
					ПозицияПредыдущейСкобкиВСтрокеПоиска = СтрНайти(СтрокаДляПоиска, "(", НаправлениеПоиска.СКонца, ПозицияСкобкиВСтрокеПоиска - 1, 1);
				Иначе
					ПозицияПробелаВСтрокеПоиска = СтрНайти(СтрокаДляПоиска, " ", НаправлениеПоиска.СКонца); 
					ПозицияПредыдущейСкобкиВСтрокеПоиска = СтрНайти(СтрокаДляПоиска, "(", НаправлениеПоиска.СКонца);
				КонецЕсли;
				Если ПозицияПробелаВСтрокеПоиска = 0 И ПозицияПредыдущейСкобкиВСтрокеПоиска = 0 Тогда
					НачалоИмениАлгоритма = 0;
				Иначе
					НачалоИмениАлгоритма = Макс(ПозицияПробелаВСтрокеПоиска, ПозицияПредыдущейСкобкиВСтрокеПоиска);
				КонецЕсли;
				ВозможноеИмяАлгоритма = Сред(СтрокаДляПоиска, НачалоИмениАлгоритма + 1, ПозицияСкобкиВСтрокеПоиска - НачалоИмениАлгоритма);
				Если СтрНайти(ВозможноеИмяАлгоритма, ".") > 0 Или УжеЗаменено.Найти(ВозможноеИмяАлгоритма) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ЗаменаИмениАлгоритма = ВызовыАлгоритмов.Получить(ВозможноеИмяАлгоритма);
				Если ЗаменаИмениАлгоритма <> Неопределено Тогда
					ДлинаИмениАлгоритма = СтрДлина(ВозможноеИмяАлгоритма);
					ИсходноеИмяАлгоритма = Сред(Строка,ПозицияСкобки - ДлинаИмениАлгоритма + 1, ДлинаИмениАлгоритма);
					Строка = СтрЗаменить(Строка,ИсходноеИмяАлгоритма, ЗаменаИмениАлгоритма); 
					УжеЗаменено.Добавить(ВозможноеИмяАлгоритма);
				КонецЕсли;     
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если СтрокаИсходная <> Строка Тогда
		Возврат Строка;
	КонецЕсли;
	// 2. Поиск из логики формирования таблицы ПКО.
	Если СтрНайти(СтрокаДляПоиска,НРег(".ПослеЗагрузкиВсехДанных")) > 0 Тогда
		ПозицияКавычки1 = СтрНайти(Строка, """",,,1); 
		ПозицияКавычки2 = СтрНайти(Строка, """",,,2);
		Если ПозицияКавычки1 > 0 И ПозицияКавычки2 > 0 Тогда
			ИмяАлгоритма = Сред(Строка, ПозицияКавычки1 + 1, ПозицияКавычки2 - ПозицияКавычки1 - 1);
			ЗаменаИмениАлгоритма = ВызовыАлгоритмов.Получить(НРег(ИмяАлгоритма)+"("); 
			Если ЗаменаИмениАлгоритма <> Неопределено Тогда
				ЗаменаИмениАлгоритма = СтрЗаменить(ЗаменаИмениАлгоритма,"(", "");
				Возврат Лев(Строка, ПозицияКавычки1) + ЗаменаИмениАлгоритма + Сред(Строка, ПозицияКавычки2); 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции
#КонецОбласти
#Область ФормированиеТекстаМодулей 
// Заголовок экспортного модуля.
Процедура ДобавитьЗаголовокМодуля(ОбщийТекстМодуля) 
	// Первая строка - имя конвертации.
	СтрокаЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '// Менеджер обмена через универсальный формат (%1 от %2)'"),
		Конвертация.Наименование,
		ТекущаяДатаСеанса());
	ОбщийТекстМодуля.ДобавитьСтроку("////////////////////////////////////////////////////////////////////////////////");
	ОбщийТекстМодуля.ДобавитьСтроку(СтрокаЗаголовка);
	ОбщийТекстМодуля.ДобавитьСтроку("//");
	ОбщийТекстМодуля.ДобавитьСтроку("////////////////////////////////////////////////////////////////////////////////");	
КонецПроцедуры

// Уникальный идентификатор модуля.
Процедура ДобавитьУИДМодуля(ОбщийТекстМодуля)
	// Функция уникального идентификатора модуля.
	СтрокаУИД = """" + СокрЛП(Новый УникальныйИдентификатор()) + """";
	ОбщийТекстМодуля.ДобавитьСтроку("Функция Подключаемый_ИдентификаторМодуля() Экспорт"); 
	ОбщийТекстМодуля.ДобавитьСтроку(Символы.Таб + "Возврат " + СтрокаУИД + ";");
	ОбщийТекстМодуля.ДобавитьСтроку("КонецФункции");
КонецПроцедуры 

// Версия формата менеджера обмена.
Функция ПолучитьВерсиюФорматаМенеджера(МакетТекстовМодулей)
	ВерсияФорматаМенеджераТекст = МакетТекстовМодулей.ПолучитьОбласть("ВерсияФорматаМенеджераОбмена").ПолучитьТекст();
	ВерсияФорматаМенеджераТекст = СтрЗаменить(ВерсияФорматаМенеджераТекст,
		"#Область ВерсияФорматаМенеджераОбмена" + Символы.ПС, "");
	ВерсияФорматаМенеджераТекст = СтрЗаменить(ВерсияФорматаМенеджераТекст, "&ВерсияФорматаМенеджераОбмена", 
									"""" + КонвертацияДанныхXDTOСервер.ВерсияФорматаМенеджераОбмена(Конвертация) + """");
	Возврат ВерсияФорматаМенеджераТекст;
КонецФункции

// Параметры конвертации.
Процедура ЗаполнитьТекстПроцедурыПараметры(ПараметрыМодуля, ТекстМодуля)
	ТекстПроцедуры = Новый ТекстовыйДокумент;
	ОбластьКомментарий = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_Параметры_Комментарий");
	ТекстПроцедуры.Вывести(ОбластьКомментарий);
	
	ОбластьШапки = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ЗаполнитьПараметрыКонвертации_Заголовок");
	ТекстПроцедуры.Вывести(ОбластьШапки);

	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|Параметр КАК Параметр
	|ИЗ Справочник.Конвертации.Параметры
	|ГДЕ Ссылка = &Конвертация И ВременнаяКопия = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО НомерСтроки
	|";
	Запрос.УстановитьПараметр("Конвертация", Конвертация);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстПроцедуры.ДобавитьСтроку(Символы.Таб
		+ "ПараметрыКонвертации.Вставить(" + """" + СокрЛП(Выборка.Параметр) + """" + ");");
	КонецЦикла;
	ТекстПроцедуры.ДобавитьСтроку("КонецПроцедуры");
	ТекстМодуля.ДобавитьСтроку("#Область ПараметрыКонвертации");
	ТекстМодуля.ДобавитьСтроку(ТекстПроцедуры.ПолучитьТекст());
	ТекстМодуля.ДобавитьСтроку("#КонецОбласти");
КонецПроцедуры

// Процедура ЗаполнитьПравилаКонвертацииПредопределенныхДанных.
Процедура ЗаполнитьТекстПроцедурыПКПД(ПараметрыМодуля)
	ТекстМодуля = ПараметрыМодуля.ПрограммныйИнтерфейс;
	ТекстПроцедуры = Новый ТекстовыйДокумент;
	ТекстПроцедуры.ДобавитьСтроку("#Область ПКПД");
	ОбластьКомментарий = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ПроцедурыПКПД_Комментарий");
	ТекстПроцедуры.Вывести(ОбластьКомментарий);
	
	ОбластьШапки = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ЗаполнитьПравилаКонвертацииПредопределенныхДанных_Заголовок");
	ТекстПроцедуры.Вывести(ОбластьШапки);
	
	Если Константы.СовместнаяРабота.Получить() Тогда
		Если ПоСостояниюХранилища Тогда
			КОбработке = ТекстЗапросаВсеИзХранилища("ПравилаКонвертацииПредопределенныхДанных");
		Иначе
			КОбработке = ТекстЗапросаСвоиДоработки("ПравилаКонвертацииПредопределенныхДанных");
		КонецЕсли;
	Иначе
		КОбработке = ТекстЗапросаБезСовместнойРаботы("ПравилаКонвертацииПредопределенныхДанных");
	КонецЕсли;

	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ЗапросОбъекты = Новый Запрос;
	ЗапросОбъекты.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросОбъекты.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка 
	|ПОМЕСТИТЬ КОбработке
	|ИЗ (" + КОбработке + ") КАК Свод
	|;
	|///////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПКПД.Ссылка КАК Ссылка,
	|	ПКПД.Код КАК Наименование,
	|	ПКПД.ОбъектКонфигурации КАК ОбъектКонфигурации,
	|	ПКПД.ОбъектФормата КАК ОбъектФормата,
	|	ПКПД.ИспользоватьДляОтправки КАК ИспользоватьДляОтправки,
	|	ПКПД.ИспользоватьДляПолучения КАК ИспользоватьДляПолучения,
	|	ОК.Тип КАК ТипДанных
	|	ИЗ
	|		Справочник.ПравилаКонвертацииПредопределенныхДанных КАК ПКПД
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Объекты КАК ОК
	|			ПО ПКПД.ОбъектКонфигурации = ОК.Наименование
	|				И ОК.Владелец = &Конфигурация
	|	ГДЕ
	|		ПКПД.Ссылка В (ВЫБРАТЬ Ссылка ИЗ КОбработке) 
	|УПОРЯДОЧИТЬ ПО
	|	ПКПД.Код
	|";
	ЗапросОбъекты.УстановитьПараметр("Конфигурация", ПараметрыМодуля.Релиз);
	ЗапросОбъекты.УстановитьПараметр("Конвертация", Конвертация);
	ЗапросОбъекты.УстановитьПараметр("ТекущийПользователь", Пользователи.ТекущийПользователь());
	ТекстДляОтправки = Новый ТекстовыйДокумент;
	ТекстДляПолучения = Новый ТекстовыйДокумент;
	ТекстОбщий = Новый ТекстовыйДокумент;
	
	Выборка = ЗапросОбъекты.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПолучитьОбластьСТекстомПКПД(ПараметрыМодуля, Выборка, ТекстДляОтправки, ТекстДляПолучения, ТекстОбщий);
	КонецЦикла;
	ДополнитьТекстПроцедурыСУсловиями(ТекстПроцедуры, ТекстДляОтправки, ТекстДляПолучения, ТекстОбщий);
	ТекстПроцедуры.ДобавитьСтроку("КонецПроцедуры"); 
	ТекстПроцедуры.ДобавитьСтроку("#КонецОбласти");
	ТекстМодуля.ДобавитьСтроку(ТекстПроцедуры.ПолучитьТекст());
КонецПроцедуры

Процедура ПолучитьОбластьСТекстомПКПД(ПараметрыМодуля, Выборка, ТекстДляОтправки, ТекстДляПолучения, ТекстОбщий)
	ТегиПравила = ПолучитьТегиДляПравила(Выборка.Ссылка, ПараметрыМодуля);
	ТегиПравила.ТегОткрытие = ДобавитьОтступыВСтроку(ТегиПравила.ТегОткрытие);
	ТегиПравила.ТегЗакрытие = ДобавитьОтступыВСтроку(ТегиПравила.ТегЗакрытие);
	// Добавить к тегам перевод строки если необходимо
	Если ЗначениеЗаполнено(ТегиПравила.ТегОткрытие) И Прав(ТегиПравила.ТегОткрытие,1) <> Символы.ПС Тогда
		ТегиПравила.ТегОткрытие = ТегиПравила.ТегОткрытие + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТегиПравила.ТегЗакрытие) И Прав(ТегиПравила.ТегЗакрытие,1) <> Символы.ПС Тогда
		ТегиПравила.ТегЗакрытие = ТегиПравила.ТегЗакрытие + Символы.ПС;
	КонецЕсли;

	ОбластьСтрока = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("Конвертация_ЗаполнитьПравилаКонвертацииПредопределенныхДанных_СтрокаПравила");
	ОбластьСтрокаТекст = ОбластьСтрока.ПолучитьТекст();
	ОбластьСтрокаТекст = СтрЗаменить(ОбластьСтрокаТекст, "#Область Конвертация_ЗаполнитьПравилаКонвертацииПредопределенныхДанных_СтрокаПравила", "---");
	ОбластьСтрокаТекст = СтрЗаменить(ОбластьСтрокаТекст, "[Наименование]", СокрЛП(Выборка.Наименование));
	ОбластьСтрокаТекст = СтрЗаменить(ОбластьСтрокаТекст, "[ОбъектФормата]", СокрЛП(Выборка.ОбъектФормата));
	
	ОбъектДанных = ПолучитьТипМетаданные(Выборка.ТипДанных, Выборка.ОбъектКонфигурации);
	ОбластьСтрокаТекст = СтрЗаменить(ОбластьСтрокаТекст, "[ОбъектДанных]", ОбъектДанных);
	// Правила конвертации значений.
	ТекстЗначенияДляОтправки = Символы.Таб + "ЗначенияДляОтправки = Новый Соответствие;";
	ТекстЗначенияДляПолучения = Символы.Таб + "ЗначенияДляПолучения = Новый Соответствие;";
	ЗапросСопоставление = Новый Запрос;
	ЗапросСопоставление.УстановитьПараметр("ПКПД", Выборка.Ссылка);
	ЗапросСопоставление.Текст = "ВЫБРАТЬ
	|	ЗначениеКонфигурации,
	|	ЗначениеФормата,
	|	Тег.Наименование КАК ТегВырезки
	|ИЗ Справочник.ПравилаКонвертацииПредопределенныхДанных.СопоставлениеЗначений
	|ГДЕ Ссылка = &ПКПД
	|УПОРЯДОЧИТЬ ПО ЗначениеКонфигурации, ЗначениеФормата";
	ТаблицаСопоставления = ЗапросСопоставление.Выполнить().Выгрузить();
	Для Каждого ПКЗ Из ТаблицаСопоставления Цикл
		СтрокаЗначениеМетаданных = ПолучитьТипМетаданные(Выборка.ТипДанных, Выборка.ОбъектКонфигурации, Истина)
		+ "." + СокрЛП(ПКЗ.ЗначениеКонфигурации);
		СтрокаЗначениеФормата = """"+СокрЛП(ПКЗ.ЗначениеФормата)+"""";
		
		ТегОткрытие = "";
		ТегЗакрытие = "";
		Если ЗначениеЗаполнено(ПКЗ.ТегВырезки) Тогда
			ТегОткрытие = "//++ " + СокрЛП(ПКЗ.ТегВырезки);
			ТегЗакрытие = "//-- " + СокрЛП(ПКЗ.ТегВырезки);
		КонецЕсли;
		Если Выборка.ИспользоватьДляОтправки Тогда
			ТекстЗначенияДляОтправки = ТекстЗначенияДляОтправки + Символы.ПС 
			+ ?(ТегОткрытие = "", "", Символы.Таб + ТегОткрытие + Символы.ПС)
			+ Символы.Таб + "ЗначенияДляОтправки.Вставить(" + СтрокаЗначениеМетаданных + ", " 
			+ СтрокаЗначениеФормата + ");"
			+ ?(ТегЗакрытие = "", "", Символы.ПС + Символы.Таб + ТегЗакрытие);
		КонецЕсли;
		Если Выборка.ИспользоватьДляПолучения Тогда
			ТекстЗначенияДляПолучения = ТекстЗначенияДляПолучения + Символы.ПС 
			+ ?(ТегОткрытие = "", "", Символы.Таб + ТегОткрытие + Символы.ПС)
			+ Символы.Таб + "ЗначенияДляПолучения.Вставить(" + СтрокаЗначениеФормата + ", "
			+  СтрокаЗначениеМетаданных + ");"
			+ ?(ТегЗакрытие = "", "", Символы.ПС + Символы.Таб + ТегЗакрытие);
		КонецЕсли;
	КонецЦикла;
	ТекстЗначенияДляОтправки = ТекстЗначенияДляОтправки + Символы.ПС + Символы.Таб 
	+ "ПравилоКонвертации.КонвертацииЗначенийПриОтправке = ЗначенияДляОтправки;";
	ТекстЗначенияДляПолучения = ТекстЗначенияДляПолучения + Символы.ПС + Символы.Таб 
	+ "ПравилоКонвертации.КонвертацииЗначенийПриПолучении = ЗначенияДляПолучения;";
	Если Выборка.ИспользоватьДляОтправки И Выборка.ИспользоватьДляПолучения Тогда
		Если ЗначениеЗаполнено(ТегиПравила.ТегОткрытие) Тогда
			ТекстОбщий.ДобавитьСтроку(ТегиПравила.ТегОткрытие);
		КонецЕсли;

		ТекстОбщий.ДобавитьСтроку(ОбластьСтрокаТекст);
		ТекстОбщий.ДобавитьСтроку(ТекстЗначенияДляОтправки);
		ТекстОбщий.ДобавитьСтроку(ТекстЗначенияДляПолучения);
	 	Если ЗначениеЗаполнено(ТегиПравила.ТегЗакрытие) Тогда
			ТекстОбщий.ДобавитьСтроку(ТегиПравила.ТегЗакрытие);
		КонецЕсли;
	ИначеЕсли Выборка.ИспользоватьДляОтправки Тогда
		Если ЗначениеЗаполнено(ТегиПравила.ТегОткрытие) Тогда
			ТекстДляОтправки.ДобавитьСтроку(ТегиПравила.ТегОткрытие);
		КонецЕсли;
		ТекстДляОтправки.ДобавитьСтроку(ОбластьСтрокаТекст);
		ТекстДляОтправки.ДобавитьСтроку(ТекстЗначенияДляОтправки);
 		Если ЗначениеЗаполнено(ТегиПравила.ТегЗакрытие) Тогда
			ТекстДляОтправки.ДобавитьСтроку(ТегиПравила.ТегЗакрытие);
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ТегиПравила.ТегОткрытие) Тогда
			ТекстДляПолучения.ДобавитьСтроку(ТегиПравила.ТегОткрытие);
		КонецЕсли;
		ТекстДляПолучения.ДобавитьСтроку(ОбластьСтрокаТекст);
		ТекстДляПолучения.ДобавитьСтроку(ТекстЗначенияДляПолучения);
 		Если ЗначениеЗаполнено(ТегиПравила.ТегЗакрытие) Тогда
			ТекстДляПолучения.ДобавитьСтроку(ТегиПравила.ТегЗакрытие);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура ЗаполнитьПравилаОбработкиДанных.
Процедура ЗаполнитьТекстПроцедурыПОД(ТекстыПоГруппам, ПараметрыМодуля)
	
	ЗапросОбъекты = Новый Запрос;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ЗапросОбъекты.МенеджерВременныхТаблиц = МенеджерВТ;
	ПрефиксВызоваОбработчика = "";
	Если Константы.СовместнаяРабота.Получить() Тогда
		Если ПоСостояниюХранилища Тогда
			КОбработке = ТекстЗапросаВсеИзХранилища("ПравилаОбработкиДанных");
			КОбработке_ПКО = ТекстЗапросаВсеИзХранилища("ПравилаКонвертацииОбъектов"); 
		Иначе
			КОбработке = ТекстЗапросаСвоиДоработки("ПравилаОбработкиДанных");
			КОбработке_ПКО = ТекстЗапросаСвоиДоработки("ПравилаКонвертацииОбъектов"); 
		КонецЕсли;
	Иначе
		КОбработке = ТекстЗапросаБезСовместнойРаботы("ПравилаОбработкиДанных");
		КОбработке_ПКО = ТекстЗапросаБезСовместнойРаботы("ПравилаКонвертацииОбъектов"); 
	КонецЕсли;
	Если ПараметрыМодуля.ИспользоватьРазделениеМодуля Тогда
		// Отбор по модулю либо по массиву правил. 
		Если ПараметрыМодуля.ТекущийМодуль.ЭтоМодульМенеджера Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод
			|ГДЕ Свод.Ссылка В (&МассивПОД) 
			|; ";
			ЗапросОбъекты.УстановитьПараметр("МассивПОД", ПараметрыМодуля.МассивПОД);
		ИначеЕсли ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.Пользовательский Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод
			|ГДЕ Свод.Ссылка.ДополнительныйМодуль = &ДополнительныйМодуль И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|; ";
			ЗапросОбъекты.УстановитьПараметр("ДополнительныйМодуль", ПараметрыМодуля.ТекущийМодуль.Ссылка);
		ИначеЕсли ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.ДокументыОтправка Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод 
			|ГДЕ Свод.Ссылка.ИспользоватьДляОтправки = ИСТИНА И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|	И (ЕстьNULL(ВЫРАЗИТЬ(Свод.Ссылка.ОбъектВыборки КАК Справочник.Объекты).Тип, ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.Документ) 
			|		ИЛИ Свод.Ссылка.Наименование ПОДОБНО ""%Документ%"")
			|	И Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|; ";
        ИначеЕсли ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.ПрочееОтправка Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод 
			|ГДЕ Свод.Ссылка.ИспользоватьДляОтправки = ИСТИНА И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|	И НЕ (ЕстьNULL(ВЫРАЗИТЬ(Свод.Ссылка.ОбъектВыборки КАК Справочник.Объекты).Тип, ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.Документ) 
			|		ИЛИ Свод.Ссылка.Наименование ПОДОБНО ""%Документ%"")
			|	И Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|; ";

		ИначеЕсли ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.ДокументыПолучение Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод 
			|ГДЕ Свод.Ссылка.ИспользоватьДляПолучения = ИСТИНА И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|	И (ВЫРАЗИТЬ(Свод.Ссылка.ОбъектВыборки КАК Строка(50)) ПОДОБНО ""Документ.%"" ИЛИ Свод.Ссылка.Наименование ПОДОБНО ""%Документ%"")
			|	И Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|; ";

		Иначе
			// Прочее получение
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод 
			|ГДЕ Свод.Ссылка.ИспользоватьДляПолучения = ИСТИНА И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|	И НЕ (ВЫРАЗИТЬ(Свод.Ссылка.ОбъектВыборки КАК Строка(50)) ПОДОБНО ""Документ.%"" ИЛИ Свод.Ссылка.Наименование ПОДОБНО ""%Документ%"")
			|	И Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|; ";
		КонецЕсли;
		ПрефиксВызоваОбработчика = СокрЛП(ПараметрыМодуля.ТекущийМодуль.Наименование) + ".";
	Иначе
		ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ссылка 
		|ПОМЕСТИТЬ КОбработке
		|ИЗ (" + КОбработке + ") КАК Свод
		|; "

	КонецЕсли;
	ПараметрыМодуля.Вставить("ПрефиксВызоваОбработчика", ПрефиксВызоваОбработчика);
	ЗапросОбъекты.Текст = ЗапросОбъекты.Текст + "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Код КАК ИмяПКО,
	|	Ссылка.ОбъектКонфигурации КАК ОбъектКонфигурации
	|ПОМЕСТИТЬ ПКОДляПолучения
	|ИЗ (" + КОбработке_ПКО + ") КАК Свод
	|ГДЕ Ссылка.ИспользоватьДляПолучения = ИСТИНА
	|";
	ЗапросОбъекты.УстановитьПараметр("Конвертация", Конвертация);
	ЗапросОбъекты.УстановитьПараметр("Конфигурация", ПараметрыМодуля.Релиз);
	ЗапросОбъекты.УстановитьПараметр("ТекущийПользователь", Пользователи.ТекущийПользователь());
	ЗапросОбъекты.Выполнить();
	
	ЗапросПОД = Новый Запрос;
	ЗапросПОД.МенеджерВременныхТаблиц = МенеджерВТ;
	ЗапросПОД.Текст = "ВЫБРАТЬ 
	|	ПОД.Ссылка,
	|	0 КАК Направление
	|ПОМЕСТИТЬ ТабПравил
	|ИЗ
	|	Справочник.ПравилаОбработкиДанных КАК ПОД
	|ГДЕ
	|	ПОД.ИспользоватьДляОтправки = ИСТИНА
	|	И ПОД.ИспользоватьДляПолучения = ЛОЖЬ
	|	И ПОД.Ссылка В (ВЫБРАТЬ КОбработке.Ссылка ИЗ КОбработке)
	|	И НЕ ПОД.Отключить
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПОД.Ссылка,
	|	1
	|ИЗ
	|	Справочник.ПравилаОбработкиДанных КАК ПОД
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПравилаОбработкиДанных.ПравилаКонвертацииОбъектов КАК ПОД_ПКО
	|	ПО ПОД.Ссылка = ПОД_ПКО.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПКОДляПолучения КАК ПКО
	|ПО (ПКО.ИмяПКО = ПОД_ПКО.ПравилоКонвертацииОбъекта
	|	ИЛИ ПКО.ИмяПКО = ПОД.ПравилоКонвертацииОбъекта)
	|ГДЕ
	|	ПОД.ИспользоватьДляОтправки = ЛОЖЬ
	|	И ПОД.ИспользоватьДляПолучения = ИСТИНА
	|	И ПОД.Ссылка В (ВЫБРАТЬ КОбработке.Ссылка ИЗ КОбработке)
	|	И НЕ ПОД.Отключить
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПОД.Ссылка,
	|	2
	|ИЗ
	|	Справочник.ПравилаОбработкиДанных КАК ПОД
	|ГДЕ
	|	ПОД.ИспользоватьДляОтправки = ИСТИНА
	|	И ПОД.ИспользоватьДляПолучения = ИСТИНА
	|	И ПОД.Ссылка В (ВЫБРАТЬ КОбработке.Ссылка ИЗ КОбработке)
	|	И НЕ ПОД.Отключить
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка.Наименование КАК Наименование,
	|	Ссылка КАК Правило,
	|	Направление 
	|ИЗ 
	|	ТабПравил КАК ТабПравил
	|УПОРЯДОЧИТЬ ПО
	|	Направление,
	|	Ссылка.Наименование
	|ИТОГИ ПО
	|	Направление
	|;  
	|
	|//////////////////////////////////////////////////////////////////////////////// 
	|ВЫБРАТЬ 
	|	Ссылка,
	|	ПравилоКонвертацииОбъекта, 
	|	Наименование, 
	|	Код, 
	|	ОбъектВыборки, 
	|	ОбъектКонфигурации, 
	|	ИспользоватьДляОтправки, 
	|	ИспользоватьДляПолучения, 
	|	ПриОбработке, 
	|	ВыборкаДанных, 
	|	ТипОбъектаВыборки, 
	|	Свод.ГруппаПравил КАК ГруппаПравил, 
	|	ОчисткаДанных
	|ИЗ (
	|		ВЫБРАТЬ
	|			ТабПравил.Ссылка КАК Ссылка,
	|			ТабПравил.Ссылка.ПравилоКонвертацииОбъекта КАК ПравилоКонвертацииОбъекта,
	|			ТабПравил.Ссылка.Наименование КАК Наименование,
	|			ТабПравил.Ссылка.Наименование КАК Код,
	|			ТабПравил.Ссылка.ОбъектВыборки КАК ОбъектВыборки,
	|			ВЫБОР
	|				КОГДА ТабПравил.Ссылка.ИспользоватьДляОтправки
	|				ТОГДА ТабПравил.Ссылка.ОбъектВыборки
	|				ИНАЧЕ """"
	|			КОНЕЦ КАК ОбъектКонфигурации,
	|			ТабПравил.Ссылка.ИспользоватьДляОтправки КАК ИспользоватьДляОтправки,
	|			ТабПравил.Ссылка.ИспользоватьДляПолучения КАК ИспользоватьДляПолучения,
	|			ТабПравил.Ссылка.АлгоритмПриОбработке КАК ПриОбработке,
	|			ВЫБОР
	|				КОГДА ТабПравил.Ссылка.ИспользоватьДляОтправки
	|					ТОГДА ТабПравил.Ссылка.АлгоритмВыборкаДанных
	|				ИНАЧЕ """"
	|			КОНЕЦ КАК ВыборкаДанных,
	|			ВЫБОР
	|				КОГДА ТабПравил.Ссылка.ИспользоватьДляОтправки
	|					ТОГДА ВЫРАЗИТЬ(ТабПравил.Ссылка.ОбъектВыборки КАК Справочник.Объекты).Тип
	|				ИНАЧЕ """"
	|			КОНЕЦ КАК ТипОбъектаВыборки,
	|			ВЫРАЗИТЬ(ТабПравил.Ссылка.ГруппаПравил КАК Строка(100)) КАК ГруппаПравил,
	|			ТабПравил.Ссылка.ОчисткаДанных КАК ОчисткаДанных
	|		ИЗ
	|			ТабПравил КАК ТабПравил
	|) КАК Свод
	|УПОРЯДОЧИТЬ ПО
	|	Свод.ГруппаПравил,
	|	Свод.Наименование
	|ИТОГИ ПО
	|	Свод.ГруппаПравил
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабПКО.ПравилоКонвертацииОбъекта КАК ПКО,
	|	ТабПравил.Ссылка КАК ПОД
	|ИЗ
	|	ТабПравил КАК ТабПравил
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|		Справочник.ПравилаОбработкиДанных.ПравилаКонвертацииОбъектов КАК ТабПКО
	|	ПО ТабПКО.Ссылка = ТабПравил.Ссылка
	|	УПОРЯДОЧИТЬ ПО ПКО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабПравил
	|";
	ЗапросПОД.УстановитьПараметр("Конвертация", Конвертация);
	ЗапросПОД.УстановитьПараметр("Конфигурация", ПараметрыМодуля.Релиз);
	
	ТелоПроцедуры = Новый ТекстовыйДокумент;
	РезультатЗапроса = ЗапросПОД.ВыполнитьПакет();
	ВыборкаПоНаправлению = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	СоответствиеТеги = Новый Соответствие();
	ЕслиОткрыто = Ложь;
	Пока ВыборкаПоНаправлению.Следующий() Цикл
		
		Если ВыборкаПоНаправлению.Направление = 0 Тогда
			ТелоПроцедуры = ПараметрыМодуля.ПОД_Отправка;
		ИначеЕсли ВыборкаПоНаправлению.Направление = 1 Тогда
			ТелоПроцедуры = ПараметрыМодуля.ПОД_Получение;
		КонецЕсли;
	
		ВыборкаДетальная = ВыборкаПоНаправлению.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
			ТегиДляПравила = ПолучитьТегиДляПравила(ВыборкаДетальная.Правило, ПараметрыМодуля);
			СоответствиеТеги.Вставить(ВыборкаДетальная.Правило, ТегиДляПравила);
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегОткрытие) Тогда
				ТелоПроцедуры.ДобавитьСтроку(ТегиДляПравила.ТегОткрытие);
			КонецЕсли;
			Строка = ПараметрыМодуля.ПрефиксВызоваОбработчика + "ДобавитьПОД_" + ВыборкаДетальная.Наименование + "(ПравилаОбработкиДанных);";
			ТелоПроцедуры.ДобавитьСтроку(Строка);
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегЗакрытие) Тогда
				ТелоПроцедуры.ДобавитьСтроку(ТегиДляПравила.ТегЗакрытие);
			КонецЕсли;
		КонецЦикла;
		Если ВыборкаПоНаправлению.Направление = 0 Тогда
			ПараметрыМодуля.ПОД_Отправка = ТелоПроцедуры;
		ИначеЕсли ВыборкаПоНаправлению.Направление = 1 Тогда
			ПараметрыМодуля.ПОД_Получение = ТелоПроцедуры;
		КонецЕсли;
	КонецЦикла;

	ТабПКО = РезультатЗапроса[3].Выгрузить();
	ТабПКО.Индексы.Добавить("ПОД");
	ВыборкаПоГруппе = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоГруппе.Следующий() Цикл
		ОбластьГруппаТекст = "";
		ТекГруппаПравил = ВыборкаПоГруппе.ГруппаПравил;
		ПривестиИмяГруппыПравил(ТекГруппаПравил);
		ВыборкаДетальная = ВыборкаПоГруппе.Выбрать();
		Пока ВыборкаДетальная.Следующий() Цикл
			ТегиДляПравила = СоответствиеТеги.Получить(ВыборкаДетальная.Ссылка);
			КоллекцияПКО = ТабПКО.НайтиСтроки(Новый Структура("ПОД", ВыборкаДетальная.Ссылка));
			ОбластьПОДТекст = ПолучитьОбластьСТекстомПОД(ПараметрыМодуля, ВыборкаДетальная, КоллекцияПКО, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила);
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегОткрытие) Тогда
				ОбластьПОДТекст = ТегиДляПравила.ТегОткрытие + Символы.ПС + ОбластьПОДТекст;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТегиДляПравила.ТегЗакрытие) Тогда
				ОбластьПОДТекст = ОбластьПОДТекст + Символы.ПС + ТегиДляПравила.ТегЗакрытие;
			КонецЕсли;
			Если ОбластьГруппаТекст = "" Тогда
				ОбластьГруппаТекст = ОбластьПОДТекст;
			Иначе
				ОбластьГруппаТекст = ОбластьГруппаТекст + Символы.ПС + ОбластьПОДТекст;
			КонецЕсли;
		КонецЦикла;

		Если НЕ ПустаяСтрока(ТекГруппаПравил)
			И НЕ ПредопределеннаяГруппаПравил(ТекГруппаПравил) Тогда
			Если ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам_ПОД.Свойство(ТекГруппаПравил) Тогда
				ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам_ПОД[ТекГруппаПравил].ДобавитьСтроку(ОбластьГруппаТекст);
			Иначе
				РазделПравил = Новый ТекстовыйДокумент;
				РазделПравил.ДобавитьСтроку(ОбластьГруппаТекст);
				ТекстыПоГруппам.СлужебныеПроцедурыИФункцииПоГруппам_ПОД.Вставить(ТекГруппаПравил, РазделПравил);
			КонецЕсли;
		Иначе
			ТекстыПоГруппам.СлужебныеПроцедурыИФункции_ПОД.ДобавитьСтроку(ОбластьГруппаТекст);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры 

Функция ПолучитьОбластьСТекстомПОД(ПараметрыМодуля, ВыборкаДетальная, КоллекцияПКО, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила)
	ПостфиксЗаголовкаОбработчика = "";
	Если ПараметрыМодуля.ИспользоватьРазделениеМодуля Тогда
		ПостфиксЗаголовкаОбработчика = " Экспорт";
	КонецЕсли;

	ОбластьПОДТекст = ПараметрыМодуля.МакетТекстовМодулей.ПолучитьОбласть("ПОД").ПолучитьТекст();
	ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "#Область ПОД" + Символы.ПС, "");
	
	ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ИмяПОДДляТаблицы", СокрЛП(ВыборкаДетальная.Наименование));
	ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ИмяПОД", "ДобавитьПОД_" + СокрЛП(ВыборкаДетальная.Наименование));
	ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&Постфикс", ПостфиксЗаголовкаОбработчика);
	
	Если ВыборкаДетальная.ИспользоватьДляОтправки Тогда
		ОбъектВыборкиМетаданные = ПолучитьТипМетаданные(ВыборкаДетальная.ТипОбъектаВыборки, ВыборкаДетальная.ОбъектВыборки);
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ОбъектВыборкиМетаданные", ОбъектВыборкиМетаданные);
	Иначе
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ОбъектВыборкиМетаданные", "---");
	КонецЕсли;
	
	Если ВыборкаДетальная.ИспользоватьДляПолучения Тогда
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ОбъектВыборкиФормат", СокрЛП(ВыборкаДетальная.ОбъектВыборки));
		Если ПараметрыМодуля.ЗапретитьПереводИменОбъектовФормата Тогда
			ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ТегЗапретПеревода", " //@NON-NLS-1");
		Иначе
			ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ТегЗапретПеревода", "");
		КонецЕсли;
	Иначе
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ОбъектВыборкиФормат", "---");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаДетальная.ПриОбработке) Тогда
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ПриОбработке",
			"ПОД_" + СокрЛП(ВыборкаДетальная.Наименование) + "_ПриОбработке");
	Иначе
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ПриОбработке", "---");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаДетальная.ВыборкаДанных)
		И ВыборкаДетальная.ИспользоватьДляОтправки Тогда
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ВыборкаДанных",
			"ПОД_" + СокрЛП(ВыборкаДетальная.Наименование) + "_ВыборкаДанных");
	Иначе
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ВыборкаДанных", "---");
	КонецЕсли;
	Если ВыборкаДетальная.ИспользоватьДляОтправки Тогда
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ОчисткаДанных", ?(ВыборкаДетальная.ОчисткаДанных, "Истина", "Ложь"));
	Иначе
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ОчисткаДанных", "---");
	КонецЕсли;
	ЗаполнениеМассиваПравил = Новый ТекстовыйДокумент;
	Если КоллекцияПКО.Количество() > 0
		Или ЗначениеЗаполнено(ВыборкаДетальная.ПравилоКонвертацииОбъекта) Тогда
		Для Каждого Строка Из КоллекцияПКО Цикл
			ЗаполнениеМассиваПравил.ДобавитьСтроку("ПравилоОбработки.ИспользуемыеПКО.Добавить(""" + Строка.ПКО + """);");
		КонецЦикла;
		Если ЗначениеЗаполнено(ВыборкаДетальная.ПравилоКонвертацииОбъекта) Тогда
			ЗаполнениеМассиваПравил.ДобавитьСтроку("ПравилоОбработки.ИспользуемыеПКО.Добавить(""" + ВыборкаДетальная.ПравилоКонвертацииОбъекта + """);");
		КонецЕсли;
		ЗаполнениеМассиваПравилТекст = ДобавитьОтступыВСтроку(ЗаполнениеМассиваПравил.ПолучитьТекст());
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ЗаполнениеМассиваПравил", ЗаполнениеМассиваПравилТекст);
	Иначе
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&ЗаполнениеМассиваПравил", "---");
	КонецЕсли;
	Если ПараметрыМодуля.ИспользоватьТипизациюПеременных Тогда
		ОбластьПОДКомментарий = ПараметрыМодуля.МакетТекстовМодулейДетализацияКомментариев.ПолучитьОбласть("Комментарий_ДобавитьПОД").ПолучитьТекст(); 
		ОбластьПОДКомментарий = СтрЗаменить(ОбластьПОДКомментарий, "#Область Комментарий_ДобавитьПОД", "---");
		ОбластьПОДТекст = ОбластьПОДКомментарий + ОбластьПОДТекст;
	КонецЕсли; 
	ТекстОбработчики = "";
	ДобавитьОбработчикиВТекстМодуля("ПОД", "ПриОбработке", 
		ВыборкаДетальная, ПараметрыМодуля, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила, ТекстОбработчики);
	Если ВыборкаДетальная.ИспользоватьДляОтправки Тогда
		ДобавитьОбработчикиВТекстМодуля("ПОД", "ВыборкаДанных", 
			ВыборкаДетальная, ПараметрыМодуля, ТекстыПоГруппам, ТекГруппаПравил, ТегиДляПравила, ТекстОбработчики);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстОбработчики) Тогда
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&Обработчики", ТекстОбработчики);
	Иначе
		ОбластьПОДТекст = СтрЗаменить(ОбластьПОДТекст, "&Обработчики", "---");
	КонецЕсли;
	Возврат ОбластьПОДТекст;
КонецФункции

// Процедура ЗаполнитьПравилаКонвертацииОбъектов
Процедура ЗаполнитьТекстПроцедурыПКО(ТекстыПоГруппам, ПараметрыМодуля)
	
	ВсяПроцедура = Новый ТекстовыйДокумент;
	Если Константы.СовместнаяРабота.Получить() Тогда
		Если ПоСостояниюХранилища Тогда
			КОбработке = ТекстЗапросаВсеИзХранилища("ПравилаКонвертацииОбъектов");
		Иначе
			КОбработке = ТекстЗапросаСвоиДоработки("ПравилаКонвертацииОбъектов");
		КонецЕсли;
	Иначе
		КОбработке = ТекстЗапросаБезСовместнойРаботы("ПравилаКонвертацииОбъектов");
	КонецЕсли;
	ЗапросОбъекты = Новый Запрос;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	ЗапросОбъекты.МенеджерВременныхТаблиц = МенеджерВТ;
	ПрефиксВызоваОбработчика = "";

	Если ПараметрыМодуля.ИспользоватьРазделениеМодуля Тогда
		// Отбор по модулю либо по массиву правил.
		Если ПараметрыМодуля.ТекущийМодуль.ЭтоМодульМенеджера Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод
			|ГДЕ Свод.Ссылка В (&МассивПКО) 
			|; ";
			ЗапросОбъекты.УстановитьПараметр("МассивПКО", ПараметрыМодуля.МассивПКО);
		ИначеЕсли ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.Пользовательский Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод
			|ГДЕ Свод.Ссылка.ДополнительныйМодуль = &ДополнительныйМодуль И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|; ";
			ЗапросОбъекты.УстановитьПараметр("ДополнительныйМодуль", ПараметрыМодуля.ТекущийМодуль.Ссылка);
		ИначеЕсли ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.ДокументыОтправка Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод 
			|ГДЕ Свод.Ссылка.ИспользоватьДляОтправки = ИСТИНА И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|	И Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|	И (ЕстьNULL(Свод.Ссылка.ОбъектКонфигурации.Тип, ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.Документ)
			|		ИЛИ (Свод.Ссылка.ОбъектКонфигурации = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
			|			И Свод.Ссылка.ОбъектФормата ПОДОБНО ""Документ.%"" )
			|	)
			|; ";
        ИначеЕсли ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.ПрочееОтправка Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод 
			|ГДЕ Свод.Ссылка.ИспользоватьДляОтправки = ИСТИНА И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|	И Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|	И НЕ (ЕстьNULL(Свод.Ссылка.ОбъектКонфигурации.Тип, ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.Документ)
			|		ИЛИ (Свод.Ссылка.ОбъектКонфигурации = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
			|		И Свод.Ссылка.ОбъектФормата ПОДОБНО ""Документ.%"" ))
			|; ";

		ИначеЕсли ПараметрыМодуля.ТекущийМодуль.Раздел = Перечисления.РазделыДополнительныхМодулей.ДокументыПолучение Тогда
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод 
			|ГДЕ Свод.Ссылка.ИспользоватьДляОтправки = ЛОЖЬ И Свод.Ссылка.ИспользоватьДляПолучения = ИСТИНА 
			|	И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|	И Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|	И (ЕстьNULL(Свод.Ссылка.ОбъектКонфигурации.Тип, ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.Документ)
			|		ИЛИ (Свод.Ссылка.ОбъектКонфигурации = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
			|			И Свод.Ссылка.ОбъектФормата ПОДОБНО ""Документ.%"" ))
			|; ";

		Иначе
			// Прочее получение
			ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	Свод.Ссылка 
			|ПОМЕСТИТЬ КОбработке
			|ИЗ (" + КОбработке + ") КАК Свод 
			|ГДЕ Свод.Ссылка.ИспользоватьДляОтправки = ЛОЖЬ И Свод.Ссылка.ИспользоватьДляПолучения = ИСТИНА
			|	И Свод.Ссылка.ВыгружатьВМодульМенеджера = ЛОЖЬ
			|	И Свод.Ссылка.ДополнительныйМодуль = ЗНАЧЕНИЕ(Справочник.ДополнительныеМодули.ПустаяСсылка)
			|	И НЕ (ЕстьNULL(Свод.Ссылка.ОбъектКонфигурации.Тип, ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыОбъектов.Документ)
			|		ИЛИ (Свод.Ссылка.ОбъектКонфигурации = ЗНАЧЕНИЕ(Справочник.Объекты.ПустаяСсылка)
			|			И Свод.Ссылка.ОбъектФормата ПОДОБНО ""Документ.%"" ))
			|; ";
		КонецЕсли; 
		ПрефиксВызоваОбработчика = СокрЛП(ПараметрыМодуля.ТекущийМодуль.Наименование) + ".";
	Иначе
		ЗапросОбъекты.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Ссылка 
		|ПОМЕСТИТЬ КОбработке
		|ИЗ (" + КОбработке + ") КАК Свод
		|; ";  
	КонецЕсли;
