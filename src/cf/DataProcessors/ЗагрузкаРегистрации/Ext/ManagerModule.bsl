	Колонки.Добавить("Код",             Новый ОписаниеТипов("Строка")); 
	Колонки.Добавить("Описание",        Новый ОписаниеТипов("Строка")); 
	Колонки.Добавить("Комментарий",     Новый ОписаниеТипов("Строка")); 
