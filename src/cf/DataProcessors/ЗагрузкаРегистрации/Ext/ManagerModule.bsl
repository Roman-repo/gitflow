#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс
// Выполняет загрузку правил регистрации из файла.
// Параметры:
//   ОбщиеПеременные - Структура - Переменные, которые используются при загрузке.
//   АдресВременногоХранилища - Произвольный - Адрес, в который будет помещен результат выполнения загрузки.
Процедура ВыполнитьЗагрузкуРегистрации(ОбщиеПеременные, АдресВременногоХранилища) Экспорт 
 	ОбщиеПеременные.Вставить("Ошибки", ""); 
	ОбщиеПеременные.Вставить("Отказ", Ложь);
	ОбщиеПеременные.Вставить("СообщениеОРезультате", "");
    ОбщиеПеременные.Вставить("ТекущийТег", Новый Массив);   
	ОбщиеПеременные.Вставить("ТегОткрытие", "");
	ОбщиеПеременные.Вставить("ТегЗакрытие", "");
	ОбщиеПеременные.Вставить("ДанныеДляЗагрузки", Неопределено);
 	ОбщиеПеременные.Вставить("ШаблонДереваОтборПоСвойствамПланаОбмена", ИнициализацияТаблицыОтборПоСвойствамПланаОбмена(Ложь));
	ОбщиеПеременные.Вставить("ШаблонДереваОтборПоСвойствамОбъекта", ИнициализацияТаблицыОтборПоСвойствамОбъекта(Ложь));
	ОбщиеПеременные.Вставить("ШаблонДереваСвойствОбъекта", ИнициализацияТаблицыИлиДереваСвойств());
	ОбщиеПеременные.Вставить("ШаблонТаблицыСвойствОбъекта", ИнициализацияТаблицыИлиДереваСвойств(Ложь));
	ОбщиеПеременные.Вставить("ОтборыПоСвойствамПланаОбмена", Новый Соответствие);
	ОбщиеПеременные.Вставить("ОтборыПоСвойствамОбъекта", Новый Соответствие); 
	ОбщиеПеременные.Вставить("СтруктураРегистрации", ИнициализацияРегистрации());
	ОбщиеПеременные.Вставить("ЭлементыСправочникаОбъекты", Новый Соответствие);
	ОбщиеПеременные.Вставить("СовместнаяРабота", Константы.СовместнаяРабота.Получить());
	ОбщиеПеременные.Вставить("ЗахваченныеПравила", Новый Массив);
	Если ОбщиеПеременные.СовместнаяРабота И НЕ ОбщиеПеременные.СоздатьНовуюРегистрацию Тогда
		// Получим ПРО которые захвачены другими пользователями и не могут загружаться.
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ДанныеЗахвата.Объект КАК СсылкаПравило,
		|	Правило.Ссылка КАК ИсходноеПравило
		|ИЗ Справочник.ПравилаРегистрацииОбъектов КАК Правило
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	РегистрСведений.СовместнаяРаботаСОбъектами.СрезПоследних(, Объект ССЫЛКА Справочник.ПравилаРегистрацииОбъектов
		|				И Действие = ЗНАЧЕНИЕ(Перечисление.ДействияПриСовместнойРаботе.Захват)) КАК ДанныеЗахвата
		|ПО ДанныеЗахвата.РабочаяКопия = Правило.Ссылка
		|	И ДанныеЗахвата.Пользователь <> &ТекущийПользователь
		|ГДЕ Правило.Владелец = &Регистрация";
		Запрос.УстановитьПараметр("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь); 
		Запрос.УстановитьПараметр("Регистрация", ОбщиеПеременные.Регистрация);
		ОбщиеПеременные.ЗахваченныеПравила = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СсылкаПравило");
	КонецЕсли;

	Если ОбщиеПеременные.ИсточникЗагрузки = 1 Тогда
		// Загрузка из текстового файла
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.Прочитать(ОбщиеПеременные.ПомещенныеФайлы[0].Хранение, КодировкаТекста.UTF8);
		СтрокаКомментария = СокрЛП(СтрПолучитьСтроку(ТекстДок, 1));
		Если Лев(СтрокаКомментария,3) <> "// " Тогда
			СтрокаКомментария = СокрЛП(СтрПолучитьСтроку(ТекстДок, 2));
		КонецЕсли;

	ИначеЕсли ОбщиеПеременные.ИсточникЗагрузки = 0 Тогда
		// Загрузка из макета XML  
		Попытка
			Правила = Новый ЧтениеXML();
			Правила.ОткрытьФайл(ОбщиеПеременные.ПомещенныеФайлы[0].Хранение);
			Правила.Прочитать();
		Исключение
			СообщитьОбОшибкеОбработки(ОбщиеПеременные, 3, ОписаниеОшибки());
			ВозвращаемоеЗначение = Новый Структура("Успешно, Ошибки", НЕ ОбщиеПеременные.Отказ, ОбщиеПеременные.Ошибки); 
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресВременногоХранилища);
			Возврат;
		КонецПопытки;
		Если Не (Правила.ЛокальноеИмя = "ПравилаРегистрации"
				И Правила.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
			
			// Ошибка формата правил
			СообщитьОбОшибкеОбработки(ОбщиеПеременные, 4);
			ВозвращаемоеЗначение = Новый Структура("Успешно, Ошибки", НЕ ОбщиеПеременные.Отказ, ОбщиеПеременные.Ошибки); 
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресВременногоХранилища);
			Возврат;
		КонецЕсли;
		ОбщиеПеременные.ДанныеДляЗагрузки = Правила;
		ЗагрузитьПравилаРегистрацииОбъектовXML(ОбщиеПеременные); 
		Попытка
			УдалитьФайлы(ОбщиеПеременные.ПомещенныеФайлы[0].Хранение);
		Исключение
		КонецПопытки;

		ВозвращаемоеЗначение = Новый Структура("Успешно, Ошибки, Регистрация", НЕ ОбщиеПеременные.Отказ, ОбщиеПеременные.Ошибки, ОбщиеПеременные.Регистрация); 
		ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресВременногоХранилища);
		Возврат;
	Иначе
		ИмяМодуля = ОбщиеПеременные.ИмяМенеджераРегистрации; 
		СтрокаПоиска = "\CommonModules\" + ИмяМодуля + "\" + ?(ОбщиеПеременные.ИсточникЗагрузки = 3, "Ext\" , "") + "Module.bsl";
		Для Каждого ПомещенныйФайл Из ОбщиеПеременные.ПомещенныеФайлы Цикл
			Если СтрНайти(ПомещенныйФайл.ПолноеИмя, СтрокаПоиска) > 0 Тогда
				ТекстДок = Новый ТекстовыйДокумент;
				ТекстДок.Прочитать(ПомещенныйФайл.Хранение, КодировкаТекста.UTF8);
				ТекстМодуля = ТекстДок.ПолучитьТекст();
				СтрокаКомментария = СокрЛП(СтрПолучитьСтроку(ТекстМодуля, 1));
				Если Лев(СтрокаКомментария,3) <> "// " Тогда
					СтрокаКомментария = СокрЛП(СтрПолучитьСтроку(ТекстМодуля, 2));
				КонецЕсли;
		        ОбщиеПеременные.ДанныеДляЗагрузки = ТекстМодуля;
			КонецЕсли;
		КонецЦикла;
		Если ОбщиеПеременные.ДанныеДляЗагрузки = Неопределено Тогда
			ВозвращаемоеЗначение = Новый Структура("Успешно, Ошибки", Ложь, НСтр("ru='Не удалось найти общий модуль '") + ИмяМодуля);
			ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресВременногоХранилища);
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ОбщиеПеременные.СоздатьНовуюРегистрацию Тогда
		Если НЕ ЗначениеЗаполнено(ОбщиеПеременные.ИмяНовойРегистрации) И ЗначениеЗаполнено(СтрокаКомментария) Тогда
			// Прочитаем имя из текста модуля.
			Если Лев(СтрокаКомментария,15) = "// Регистрация " Тогда
				ПозицияКонецИмени = Найти(СтрокаКомментария, " от ");
				Если ПозицияКонецИмени > 0 Тогда
					ОбщиеПеременные.ИмяНовойРегистрации = Сред(СтрокаКомментария,16, ПозицияКонецИмени - 16);
				Иначе
					ОбщиеПеременные.ИмяНовойРегистрации = Прав(СтрокаКомментария,СтрДлина(СтрокаКомментария) - 15);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Создание новой регистрации будет после чтения ключевых параметров.
	КонецЕсли;
	ОбщиеПеременные.Вставить("ТаблицаРезультатов", ПодготовитьСтруктуруТаблицыРезультат());
	ЗагрузитьПроцедурыИФункцииВТаблицы(ОбщиеПеременные);
	СтрокиРезультат = ОбщиеПеременные.ТаблицаРезультатов.НайтиСтроки(Новый Структура("ИмяПроцедурыФункции", "ПараметрыРегистрации"));
	Если СтрокиРезультат.Количество() > 0 Тогда
		ПрочитатьПараметрыРегистрации(ОбщиеПеременные, СтрокиРезультат[0]);
	КонецЕсли;
	Если ОбщиеПеременные.СоздатьНовуюРегистрацию Тогда
		СоздатьНовуюРегистрацию(ОбщиеПеременные);
	КонецЕсли;
	ЗагрузитьПроцедурыИФункцииВОбъектыМетаданных(ОбщиеПеременные);
	
	// Удаление временных файлов.
	УдалитьВременныеФайлы(ОбщиеПеременные);

	Если АдресВременногоХранилища <> Неопределено Тогда
		ВозвращаемоеЗначение = Новый Структура("Регистрация, Успешно, Ошибки", ОбщиеПеременные.Регистрация, НЕ ОбщиеПеременные.Отказ, ОбщиеПеременные.Ошибки); 
		Если ЗначениеЗаполнено(ОбщиеПеременные.СообщениеОРезультате) Тогда 
			ВозвращаемоеЗначение.Вставить("СообщениеОРезультате", ОбщиеПеременные.СообщениеОРезультате);
		КонецЕсли;
		ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресВременногоХранилища);
	КонецЕсли; 
КонецПроцедуры

// Заполняет список общих модулей, которые являются модулем с правилами регистрации
Процедура ЗаполнитьСписокМодулейРегистрации(ОбщиеПеременные, АдресВременногоХранилища) Экспорт 
	ОбщиеПеременные.Вставить("Отказ", Ложь); 
	ОбщиеПеременные.Вставить("СписокМодулейРегистрации", Новый Массив);
	Для Каждого ПомещенныйФайл Из ОбщиеПеременные.ПомещенныеФайлы Цикл
		ТекстДок = Новый ТекстовыйДокумент;
		ТекстДок.Прочитать(ПомещенныйФайл.Хранение, КодировкаТекста.UTF8);
		ТекстМодуля = ТекстДок.ПолучитьТекст();
		НайтиИмяМодуляРегистрации(ТекстМодуля, ОбщиеПеременные);
	КонецЦикла;
	// Удаление временных файлов.
	УдалитьВременныеФайлы(ОбщиеПеременные);
	Если АдресВременногоХранилища <> Неопределено Тогда
		ВозвращаемоеЗначение = Новый Структура("Успешно, СписокМодулейРегистрации", НЕ ОбщиеПеременные.Отказ, ОбщиеПеременные.СписокМодулейРегистрации); 
		ПоместитьВоВременноеХранилище(ВозвращаемоеЗначение, АдресВременногоХранилища);
	КонецЕсли; 

КонецПроцедуры
#КонецОбласти
#Область СлужебныеПроцедурыИФункции
#Область ЧтениеФайлаПравилРегистрации
// Процедура выполняет последовательное чтение XML файла с правилами регистрации
// Параметры:
//  ОбщиеПеременные - Структура - различные параметры и переменные обработки.
// Возвращаемое значение - Структура - результат загрузки.
Процедура ЗагрузитьПравилаРегистрацииОбъектовXML(ОбщиеПеременные)  
	Правила = ОбщиеПеременные.ДанныеДляЗагрузки;
	
	// Выполняем инициализацию коллекций для правил
	ОбщиеПеременные.Вставить("ПравилаРегистрацииОбъектов", ИнициализацияТаблицыПРО());
	// Состав плана обмена.
	СоставПланаОбмена = Новый ТаблицаЗначений;
	СоставПланаОбмена.Колонки.Добавить("Наименование",    Новый ОписаниеТипов("Строка"));
	СоставПланаОбмена.Колонки.Добавить("Тип",             Новый ОписаниеТипов("Строка"));
	СоставПланаОбмена.Колонки.Добавить("Авторегистрация", Новый ОписаниеТипов("Булево"));

	ОбщиеПеременные.Вставить("СоставПланаОбмена", СоставПланаОбмена);
	
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		ТипУзла = Правила.ТипУзла;
		
		// Реквизиты регистрации
		Если ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если ИмяУзла = "ВерсияФормата"
				Или ИмяУзла = "Ид" 
				Или ИмяУзла = "Наименование"
				Или ИмяУзла = "Комментарий" Тогда
				
				ОбщиеПеременные.СтруктураРегистрации[ИмяУзла] = одЗначениеЭлемента(Правила);
				
			ИначеЕсли ИмяУзла = "ДатаВремяСоздания" Тогда
				
				ОбщиеПеременные.СтруктураРегистрации.ДатаВремяСоздания = одЗначениеЭлемента(Правила, Тип("Дата"));
				
			ИначеЕсли ИмяУзла = "ПланОбмена" Тогда
				
				// Атрибуты для плана обмена
				ИмяПланаОбмена = одЗначениеЭлемента(Правила);
				ОбщиеПеременные.СтруктураРегистрации.ИмяПланаОбмена = СтрЗаменить(ИмяПланаОбмена, "ПланОбменаСсылка.", "");
				
			ИначеЕсли ИмяУзла = "Конфигурация" Тогда
				
				// Атрибуты конфигурации
				ОбщиеПеременные.СтруктураРегистрации.ВерсияПлатформы     = одАтрибут(Правила, "ВерсияПлатформы");
				ОбщиеПеременные.СтруктураРегистрации.ВерсияКонфигурации  = одАтрибут(Правила, "ВерсияКонфигурации");
				ОбщиеПеременные.СтруктураРегистрации.СинонимКонфигурации = одАтрибут(Правила, "СинонимКонфигурации");
				
				// Наименование конфигурации
				ОбщиеПеременные.СтруктураРегистрации.Конфигурация = одЗначениеЭлемента(Правила);
				
				
			ИначеЕсли ИмяУзла = "СоставПланаОбмена" Тогда
				
				ЗагрузитьСоставПланаОбмена(Правила, ОбщиеПеременные.СоставПланаОбмена);
				
			ИначеЕсли ИмяУзла = "ПравилаРегистрацииОбъектов" Тогда
				
				ЗагрузитьПравилаРегистрации(Правила, ОбщиеПеременные, ОбщиеПеременные.ПравилаРегистрацииОбъектов)
			Иначе
				одПропустить(Правила);
			КонецЕсли;
		ИначеЕсли (ИмяУзла = "ПравилаРегистрации") И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		КонецЕсли;
		
	КонецЦикла;
	Правила.Закрыть();
	Если ОбщиеПеременные.Отказ Тогда
		Возврат;
	КонецЕсли; 
	Если ОбщиеПеременные.СоздатьНовуюРегистрацию Тогда
		СоздатьНовуюРегистрацию(ОбщиеПеременные);
	КонецЕсли;
	ЗагрузитьЭлементыПравилРегистрацииОбъектов(ОбщиеПеременные, ОбщиеПеременные.ПравилаРегистрацииОбъектов);
	
	Если НЕ ОбщиеПеременные.Свойство("ТаблицаСвойствПланаОбмена") Тогда
		ТаблицаСвойствПланаОбмена = ОбщиеПеременные.ШаблонДереваСвойствОбъекта.Скопировать();
		ОбщиеПеременные.Вставить("ТаблицаСвойствПланаОбмена", ТаблицаСвойствПланаОбмена);
	КонецЕсли;

	СоздатьОбъектыИСвойстваПоТаблицеВложенныхСвойств(ОбщиеПеременные, ОбщиеПеременные.Регистрация.ИмяПланаОбмена, ОбщиеПеременные.ТаблицаСвойствПланаОбмена);

КонецПроцедуры

// Загрузка из XML состава плана обмена.
Процедура ЗагрузитьСоставПланаОбмена(Правила, СоставПланаОбмена)
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		
		Если ИмяУзла = "Элемент" Тогда
			
			ЗагрузитьЭлементСоставаПланаОбмена(Правила, СоставПланаОбмена);
			
		ИначеЕсли (ИмяУзла = "СоставПланаОбмена") И (Правила.ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьЭлементСоставаПланаОбмена(Правила, СоставПланаОбмена)
	
	НоваяСтрока = СоставПланаОбмена.Добавить();
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		
		Если ИмяУзла = "Тип" Тогда
			
			НоваяСтрока.Тип = одЗначениеЭлемента(Правила);
			
			НоваяСтрока.Наименование = ПолучитьИмяОбъектаПоНаименованию(НоваяСтрока.Тип);
			
		ИначеЕсли ИмяУзла = "Авторегистрация" Тогда
			
			НоваяСтрока.Авторегистрация = одЗначениеЭлемента(Правила, Тип("Булево"));
			
		ИначеЕсли (ИмяУзла = "Элемент") И (Правила.ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Осуществляет загрузку правил регистрации в соответствии с форматом правил обмена
//
// Параметры:
//  ПравилаОбмена  - Объект типа XMLЧтение
// 
Процедура ЗагрузитьПравилаРегистрации(Правила, ОбщиеПеременные, ПравилаРегистрацииОбъектов)
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		
		Если ИмяУзла = "Правило" Тогда
			
			ЗагрузитьПравилоРегистрации(Правила, ОбщиеПеременные, ПравилаРегистрацииОбъектов);
			
		ИначеЕсли ИмяУзла = "Группа" Тогда
			
			ЗагрузитьГруппуПравилРегистрации(Правила, ОбщиеПеременные, ПравилаРегистрацииОбъектов);
			
		ИначеЕсли (ИмяУзла = "ПравилаРегистрацииОбъектов") И (Правила.ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьПравилаРегистрации()

Процедура ЗагрузитьГруппуПравилРегистрации(Правила, ОбщиеПеременные, ДеревоЗначений)
	
	НоваяСтрока = ДеревоЗначений.Строки.Добавить();
	
	НоваяСтрока.ЭтоГруппа = Истина;
	НоваяСтрока.Отключить = одАтрибут(Правила, "Отключить", Тип("Булево"));
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		
		Если ИмяУзла = "Правило" Тогда
			
			ЗагрузитьПравилоРегистрации(Правила, ОбщиеПеременные, НоваяСтрока);
			
		ИначеЕсли ИмяУзла = "Группа" И Правила.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ЗагрузитьГруппуПравилРегистрации(Правила, ОбщиеПеременные, НоваяСтрока);
			
		ИначеЕсли ИмяУзла = "Код"
			Или ИмяУзла = "Описание" 
			Или ИмяУзла = "Комментарий" 
			Или ИмяУзла = "Наименование"
			Или ИмяУзла = "ТипГруппы" Тогда
			
			НоваяСтрока[ИмяУзла] = одЗначениеЭлемента(Правила);
			
		ИначеЕсли ИмяУзла = "Группа" И Правила.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		
			Прервать; 
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьГруппуПравилРегистрации()

Процедура ЗагрузитьПравилоРегистрации(Правила, ОбщиеПеременные, ДеревоЗначений)
	НоваяСтрока = ДеревоЗначений.Строки.Добавить();
	
	НоваяСтрока.ЭтоГруппа = Ложь;
	НоваяСтрока.Отключить = одАтрибут(Правила, "Отключить", Тип("Булево"));
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		
		Если ИмяУзла = "Код"
			Или ИмяУзла = "Описание"
			Или ИмяУзла = "Комментарий"
			Или ИмяУзла = "Наименование"
			Или ИмяУзла = "ОбъектНастройки"
			Или ИмяУзла = "РеквизитРежимаВыгрузки"
			Или ИмяУзла = "ТегВырезки"
			// Обработчики событий.
			Или ИмяУзла = "ПередОбработкой"
			Или ИмяУзла = "ПриОбработке" 
			Или ИмяУзла = "ПакетнаяОбработка"
			Или ИмяУзла = "ПриОбработкеДополнительный"
			Или ИмяУзла = "ПослеОбработки" Тогда
			
			НоваяСтрока[ИмяУзла] = одЗначениеЭлемента(Правила);
		ИначеЕсли ИмяУзла = "ОтборПоСвойствамПланаОбмена" Тогда
			
			// Инициализируем коллекцию свойств для текущего ПРО.
			НоваяСтрока.ОтборПоСвойствамПланаОбмена = ОбщиеПеременные.ШаблонДереваОтборПоСвойствамПланаОбмена.Скопировать();
			
			ЗагрузитьДеревоОтбораПоСвойствамПланаОбмена(Правила, ОбщиеПеременные, НоваяСтрока.ОтборПоСвойствамПланаОбмена);
			
		ИначеЕсли ИмяУзла = "ОтборПоСвойствамОбъекта" Тогда
			
			// Инициализируем коллекцию свойств для текущего ПРО.
			НоваяСтрока.ОтборПоСвойствамОбъекта = ОбщиеПеременные.ШаблонДереваОтборПоСвойствамОбъекта.Скопировать();
			
			ЗагрузитьДеревоОтбораПоСвойствамОбъекта(Правила, ОбщиеПеременные, НоваяСтрока.ОтборПоСвойствамОбъекта);
			
		ИначеЕсли (ИмяУзла = "Правило") И (Правила.ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать;
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьПравилоРегистрации()

Процедура ЗагрузитьДеревоОтбораПоСвойствамПланаОбмена(Правила, ОбщиеПеременные, ДеревоЗначений)
	
	СтрокиДЗ = ДеревоЗначений.Строки;
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		ТипУзла = Правила.ТипУзла;
		
		Если ИмяУзла = "ЭлементОтбора" Тогда
			
			ЗагрузитьЭлементОтбораПланаОбмена(Правила, ОбщиеПеременные, СтрокиДЗ.Добавить());
			
		ИначеЕсли ИмяУзла = "Группа" Тогда
			
			ЗагрузитьГруппуЭлементовОтбораПланаОбмена(Правила, ОбщиеПеременные, СтрокиДЗ.Добавить());
			
		ИначеЕсли (ИмяУзла = "ОтборПоСвойствамПланаОбмена") И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьДеревоОтбораПоСвойствамОбъекта(Правила, ОбщиеПеременные, ДеревоЗначений)
	
	СтрокиДЗ = ДеревоЗначений.Строки;
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		ТипУзла = Правила.ТипУзла;
		
		Если ИмяУзла = "ЭлементОтбора" Тогда
			
			ЗагрузитьЭлементОтбораОбъекта(Правила, ОбщиеПеременные, СтрокиДЗ.Добавить());
			
		ИначеЕсли ИмяУзла = "Группа" Тогда
			
			ЗагрузитьГруппуЭлементовОтбораОбъекта(Правила, ОбщиеПеременные, СтрокиДЗ.Добавить());
			
		ИначеЕсли (ИмяУзла = "ОтборПоСвойствамОбъекта") И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьЭлементОтбораПланаОбмена(Правила, ОбщиеПеременные, НоваяСтрока)
	
	НоваяСтрока.ЭтоГруппа = Ложь;
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		ТипУзла = Правила.ТипУзла;
		
		Если ИмяУзла = "СвойствоОбъекта" Тогда
			
			Если НоваяСтрока.ЭтоСтрокаКонстанты Тогда
				
				НоваяСтрока.СвойствоОбъекта = одЗначениеЭлемента(Правила, Тип(НоваяСтрока.ТипСвойстваОбъекта));
				
			Иначе
				
				НоваяСтрока.СвойствоОбъекта = одЗначениеЭлемента(Правила);
				
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "СвойствоПланаОбмена"
			Или ИмяУзла = "ВидСравнения"
			Или ИмяУзла = "ТипСвойстваОбъекта" Тогда
			
			НоваяСтрока[ИмяУзла] = одЗначениеЭлемента(Правила);
			
		ИначеЕсли ИмяУзла = "ЭтоСтрокаКонстанты" Тогда
			
			НоваяСтрока.ЭтоСтрокаКонстанты = одЗначениеЭлемента(Правила, Тип("Булево"));
			
		ИначеЕсли ИмяУзла = "ТаблицаСвойствОбъекта" Тогда
			НоваяСтрока.ТаблицаСвойствОбъекта = ОбщиеПеременные.ШаблонДереваСвойствОбъекта.Скопировать();
			ЗагрузитьТаблицуСвойств(Правила, НоваяСтрока.ТаблицаСвойствОбъекта);
		ИначеЕсли ИмяУзла = "ТаблицаСвойствПланаОбмена" Тогда
			Если НЕ ОбщиеПеременные.Свойство("ТаблицаСвойствПланаОбмена") Тогда
				ТаблицаСвойствПланаОбмена = ОбщиеПеременные.ШаблонДереваСвойствОбъекта.Скопировать();
			Иначе
				ТаблицаСвойствПланаОбмена = ОбщиеПеременные.ТаблицаСвойствПланаОбмена
			КонецЕсли;
			
			ЗагрузитьТаблицуСвойств(Правила, ТаблицаСвойствПланаОбмена, Истина);
			ОбщиеПеременные.Вставить("ТаблицаСвойствПланаОбмена", ТаблицаСвойствПланаОбмена);

		ИначеЕсли (ИмяУзла = "ЭлементОтбора") И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьЭлементОтбораОбъекта(Правила, ОбщиеПеременные, НоваяСтрока)
	
	НоваяСтрока.ЭтоГруппа = Ложь;
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		ТипУзла = Правила.ТипУзла;
		
		Если ИмяУзла = "СвойствоОбъекта"
			Или ИмяУзла = "ВидСравнения"
			Или ИмяУзла = "ТипСвойстваОбъекта" Тогда
			
			НоваяСтрока[ИмяУзла] = одЗначениеЭлемента(Правила);
			
		ИначеЕсли ИмяУзла = "ЗначениеКонстанты" Тогда
			
			Если ПустаяСтрока(НоваяСтрока.ВидЭлементаОтбора) Тогда
				
				НоваяСтрока.ВидЭлементаОтбора = "ЗначениеКонстанты";
				
			КонецЕсли;
			
			Если НоваяСтрока.ВидЭлементаОтбора = "ЗначениеКонстанты" Тогда
				
				НоваяСтрока.ЗначениеКонстанты = одЗначениеЭлемента(Правила, Тип(НоваяСтрока.ТипСвойстваОбъекта)); // только примитивные типы
				
			Иначе
				
				НоваяСтрока.ЗначениеКонстанты = одЗначениеЭлемента(Правила); // строка
				
			КонецЕсли;
			
		ИначеЕсли ИмяУзла = "Вид" Тогда
			
			НоваяСтрока.ВидЭлементаОтбора = одЗначениеЭлемента(Правила);
			
		ИначеЕсли ИмяУзла = "ТаблицаСвойствОбъекта" Тогда
			НоваяСтрока.ТаблицаСвойствОбъекта = ОбщиеПеременные.ШаблонДереваСвойствОбъекта.Скопировать();
			ЗагрузитьТаблицуСвойств(Правила, НоваяСтрока.ТаблицаСвойствОбъекта, Ложь);
		ИначеЕсли (ИмяУзла = "ЭлементОтбора") И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьГруппуЭлементовОтбораПланаОбмена(Правила, ОбщиеПеременные, НоваяСтрока)
	
	НоваяСтрока.ЭтоГруппа = Истина;
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		ТипУзла = Правила.ТипУзла;
		
		Если ИмяУзла = "ЭлементОтбора" Тогда
			
			ЗагрузитьЭлементОтбораПланаОбмена(Правила, ОбщиеПеременные, НоваяСтрока.Строки.Добавить());
		
		ИначеЕсли (ИмяУзла = "Группа") И (ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
			
			ЗагрузитьГруппуЭлементовОтбораПланаОбмена(Правила, ОбщиеПеременные, НоваяСтрока.Строки.Добавить());
			
		ИначеЕсли ИмяУзла = "БулевоЗначениеГруппы" Тогда
			
			НоваяСтрока.БулевоЗначениеГруппы = одЗначениеЭлемента(Правила);
			
		ИначеЕсли (ИмяУзла = "Группа") И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьГруппуЭлементовОтбораОбъекта(Правила, ОбщиеПеременные, НоваяСтрока)
	
	НоваяСтрока.ЭтоГруппа = Истина;
	
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		ТипУзла = Правила.ТипУзла;
		
		Если ИмяУзла = "ЭлементОтбора" Тогда
			
			ЗагрузитьЭлементОтбораОбъекта(Правила, ОбщиеПеременные, НоваяСтрока.Строки.Добавить());
		
		ИначеЕсли (ИмяУзла = "Группа") И (ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
			
			ЗагрузитьГруппуЭлементовОтбораОбъекта(Правила, ОбщиеПеременные, НоваяСтрока.Строки.Добавить());
			
		ИначеЕсли ИмяУзла = "БулевоЗначениеГруппы" Тогда
			
			НоваяСтрока.БулевоЗначениеГруппы = одЗначениеЭлемента(Правила);
			
		ИначеЕсли (ИмяУзла = "Группа") И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьТаблицуСвойств(Правила, ДеревоЗначений, ПроверятьСуществование = Ложь)
	
	Правила.Прочитать();
	
	Если Правила.ЛокальноеИмя = "Свойство" Тогда
		
		ЗагрузитьСвойствоОбъекта(Правила, ДеревоЗначений, ПроверятьСуществование);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьСвойствоОбъекта(Правила, ДеревоЗначений, ПроверятьСуществование)
	
	СтруктураПоиска = Новый Структура;
	Пока Правила.Прочитать() Цикл
		
		ИмяУзла = Правила.ЛокальноеИмя;
		ТипУзла = Правила.ТипУзла;
		
		Если ИмяУзла = "Наименование"
			Или ИмяУзла = "Тип"
			Или ИмяУзла = "Вид" Тогда
			СтруктураПоиска.Вставить(ИмяУзла, одЗначениеЭлемента(Правила));
			
		ИначеЕсли (ИмяУзла = "Свойство") И (ТипУзла = ТипУзлаXML.КонецЭлемента) Тогда
			
			Прервать; 
			
		Иначе
			
			одПропустить(Правила);
			
		КонецЕсли;
		
	КонецЦикла;
	СоздатьСтроку = Истина;
	Если ПроверятьСуществование Тогда
		РезультатПоиска = ДеревоЗначений.Строки.Найти(СтруктураПоиска);
		Если РезультатПоиска <> Неопределено И РезультатПоиска.Количество() > 0 Тогда
			СоздатьСтроку = Ложь;
			СтрокаДерева = РезультатПоиска[0];
		КонецЕсли;
	КонецЕсли;
	Если СоздатьСтроку Тогда
		СтрокаДерева = ДеревоЗначений.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, СтруктураПоиска);
	КонецЕсли;
	ЗагрузитьТаблицуСвойств(Правила, СтрокаДерева, ПроверятьСуществование); // вызов сложной рекурсии
	
КонецПроцедуры

Процедура НайтиИмяМодуляРегистрации(ТекстМодуля, ОбщиеПеременные)
	НайденаПроцедураПриПолученииНастроек = Ложь;
	Для НомерСтроки = 1 По СтрЧислоСтрок(ТекстМодуля) Цикл
		Стр = СтрПолучитьСтроку(ТекстМодуля, НомерСтроки);
		Если СтрНайти(Стр, "//") > 0 Или СокрЛП(Стр) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Стр, "Процедура ПриПолученииНастроек(") > 0 Тогда
			НайденаПроцедураПриПолученииНастроек = Истина;
		ИначеЕсли НайденаПроцедураПриПолученииНастроек И СтрНайти(Стр, "КонецПроцедуры") > 0 Тогда
			Прервать;
		ИначеЕсли НайденаПроцедураПриПолученииНастроек И СтрНайти(Стр, ".ИмяМенеджераРегистрации") > 0 Тогда
			ОбщиеПеременные.СписокМодулейРегистрации.Добавить(СокрЛП(ТекстВнутриКавычек(Стр)));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
#КонецОбласти

#Область ПроцедурыИнициализации
// Инициализирует колонки таблицы правил регистрации объектов
