КонецФункции

Процедура ПроверитьТекущийТег(Стр, ОбщиеПеременные, ЭтоПКЗ = Ложь)
	Если Лев(Стр, 2) <> "//" Тогда
		Возврат;
	КонецЕсли;
	СтрБезПробелов = СокрЛП(Стр);
	Если Найти(СтрБезПробелов, "//++") > 0 Тогда
		ТегСтрокой = СокрЛП(СтрЗаменить(СтрБезПробелов, "//++", ""));
		Если ЭтоПКЗ Тогда 
			Если ОбщиеПеременные.ТекущийТегПКЗ.Найти(ТегСтрокой) = Неопределено Тогда
				ОбщиеПеременные.ТекущийТегПКЗ.Добавить(ТегСтрокой);
			КонецЕсли
		ИначеЕсли ОбщиеПеременные.ТекущийТег.Найти(ТегСтрокой) = Неопределено Тогда
			ОбщиеПеременные.ТекущийТег.Добавить(ТегСтрокой);
		КонецЕсли;
	ИначеЕсли Найти(СтрБезПробелов, "//--") > 0 Тогда
		ТегСтрокой = СокрЛП(СтрЗаменить(СтрБезПробелов, "//--", ""));
		ИндексЗначения = ОбщиеПеременные.ТекущийТегПКЗ.Найти(ТегСтрокой);
		Если ИндексЗначения <> Неопределено Тогда
			ОбщиеПеременные.ТекущийТегПКЗ.Удалить(ИндексЗначения);
		Иначе
			ИндексЗначения = ОбщиеПеременные.ТекущийТег.Найти(ТегСтрокой);
			Если ИндексЗначения <> Неопределено Тогда
				ОбщиеПеременные.ТекущийТег.Удалить(ИндексЗначения);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ТекстПослеРавно(Стр)
	Позиция1 = СтрНайти(Стр, "=");
	Если Позиция1 = 0 Тогда
		Возврат "";
	КонецЕсли;
	Результат = СокрЛП(Сред(Стр, Позиция1 + 1));
	
	Результат = СтрЗаменить(Результат, ";", "");
	Если СтрНайти(Результат, """") > 0 Тогда
		Результат = ТекстВнутриКавычек(Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ТекстВнутриКавычек(Стр)
	Позиция1 = СтрНайти(Стр, """",,,1);
	Позиция2 = СтрНайти(Стр, """",,,2);
	Если Позиция1 = 0 Или Позиция2 = 0 Тогда
		Возврат Стр;
	КонецЕсли;
	Возврат СокрЛП(Сред(Стр,Позиция1+1,Позиция2-Позиция1-1)); 
КонецФункции

Функция ТекстВнутриСкобок(Стр)
	Позиция1 = СтрНайти(Стр, "(",,,1);
	Позиция2 = СтрНайти(Стр, ")",,,2);
	Если Позиция1 = 0 Или Позиция2 = 0 Тогда
		Возврат Стр;
	КонецЕсли;
	Возврат СокрЛП(Сред(Стр,Позиция1+1,Позиция2-Позиция1-1)); 
КонецФункции

Функция ОбъектКонфигурацииПоСтроке(Стр, Конфигурация, Разделитель = ".")
	// Пример строки Метаданные.Документы.ВводОстатков
	// Либо Документы_АвансовыйОтчет
	ПолеПоиска = СтрЗаменить(Стр, "Метаданные.", "");
	ПозицияТочки = СтрНайти(ПолеПоиска, Разделитель);
	ГруппаОбъектов = Лев(ПолеПоиска, ПозицияТочки - 1);
	ИмяОбъекта = Сред(ПолеПоиска, ПозицияТочки + 1);
	ЗапросОбъект = Новый Запрос;
	ЗапросОбъект.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
	|ИЗ Справочник.Объекты
	|ГДЕ Владелец = &Конфигурация И Имя = &Имя И Родитель.Наименование = &Группа
	|УПОРЯДОЧИТЬ ПО ПометкаУдаления ВОЗР";
	ЗапросОбъект.УстановитьПараметр("Конфигурация", Конфигурация);
	ЗапросОбъект.УстановитьПараметр("Группа", ГруппаОбъектов);
	ЗапросОбъект.УстановитьПараметр("Имя", ИмяОбъекта);
	Выборка = ЗапросОбъект.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Объекты.ПустаяСсылка();
КонецФункции

Функция СвойствоКонфигурацииПоСтроке(Наименование, Объект, ЭтоГруппа = Ложь, Родитель = "")
	ЗапросСвойство = Новый Запрос;
	ЗапросСвойство.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
	|ИЗ Справочник.Свойства
	|ГДЕ Владелец = &Объект И Наименование = &Наименование И 
	|	(Родитель.Наименование = &Родитель ИЛИ (&ПустойРодитель И Родитель = ЗНАЧЕНИЕ(Справочник.Свойства.ПустаяСсылка)))
	|	И ЭтоГруппа = &ЭтоГруппа
	|УПОРЯДОЧИТЬ ПО ПометкаУдаления ВОЗР";
	ЗапросСвойство.УстановитьПараметр("Объект", Объект);
	ЗапросСвойство.УстановитьПараметр("ЭтоГруппа", ЭтоГруппа);
	ЗапросСвойство.УстановитьПараметр("Наименование", Наименование);
	ЗапросСвойство.УстановитьПараметр("Родитель", Родитель);
	ЗапросСвойство.УстановитьПараметр("ПустойРодитель", НЕ ЗначениеЗаполнено(Родитель));

	Выборка = ЗапросСвойство.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.Свойства.ПустаяСсылка();
	
КонецФункции

Процедура УдалитьЛишниеПравила(ОбщиеПеременные, СуществующиеПравила, ИмяСправочника)
	Если СуществующиеПравила.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ 
	|	ПОД.Ссылка КАК Правило,
	|	СоставСвой.Ссылка КАК Состав,
	|	ВЫБОР КОГДА СоставЧужой.Ссылка Есть NULL ТОГДА
	|		ИСТИНА
	|	ИНАЧЕ ЛОЖЬ КОНЕЦ КАК МожноУдалить
	|ИЗ Справочник." + ИмяСправочника + " КАК ПОД
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.СоставыКонвертаций КАК СоставЧужой
	|ПО СоставЧужой.ЭлементКонвертации = ПОД.Ссылка
	|	И СоставЧужой.Владелец <> &Конвертация
	|	И СоставЧужой.Отключить = ЛОЖЬ
	|ЛЕВОЕ СОЕДИНЕНИЕ
	|	Справочник.СоставыКонвертаций КАК СоставСвой
	|ПО СоставСвой.ЭлементКонвертации = ПОД.Ссылка
	|	И СоставСвой.Владелец = &Конвертация
	|	И СоставСвой.Отключить = ЛОЖЬ
	|ГДЕ ПОД.Ссылка В (&КУдалению)";
	Запрос.УстановитьПараметр("КУдалению", СуществующиеПравила);
	Запрос.УстановитьПараметр("Конвертация", ОбщиеПеременные.Конвертация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.МожноУдалить Тогда
			ПравилоОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ПравилоОбъект.УстановитьПометкуУдаления(Истина);
		Иначе
			СоставОбъект = Выборка.Состав.ПолучитьОбъект();
			СоставОбъект.Отключить = Истина;
			СоставОбъект.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДополнитьРодственныеКонвертации(ПравилоСсылка, ИсходныйОбъектКонфигурации, РодственныеКонвертации, РодственныеКонфигурации)
	РодственныеКонвертации = Новый Соответствие;
	Если РодственныеКонвертации.Количество() = 0 Или Не ЗначениеЗаполнено(ИсходныйОбъектКонфигурации) Тогда
		Возврат;
	КонецЕсли;
	ИмяОбъектаКонфигурации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсходныйОбъектКонфигурации, "Наименование");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Владелец
	|ИЗ Справочник.Объекты КАК Объекты
	|ГДЕ Объект.Владелец В &МассивКонфигураций
	|	И Объект.Наименование = &Наименование";
	Запрос.УстановитьПараметр("МассивКонфигураций", РодственныеКонфигурации);
	ИскомыеКонфигурации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Владелец");
	Если ИскомыеКонфигурации.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Родственник Из РодственныеКонвертации Цикл
		Если ИскомыеКонфигурации.Найти(Родственник.Значение) Тогда
			Справочники.СоставыКонвертаций.ДополнитьСоставКонвертации(Родственник.Ключ, ПравилоСсылка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДополнитьРодственныеКонвертации_ПОДЗагрузки(ОбщиеПеременные, ПОДЗагрузки, РодственныеКонвертации)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПравилоКонвертацииОбъекта КАК ПКО,
	|	Ссылка КАК ПОД
	|ПОМЕСТИТЬ ИменаПКО
	|ИЗ Справочник.ПравилаОбработкиДанных.ПравилаКонвертацииОбъектов
	|ГДЕ Ссылка В (&ПОД)
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ
	|  ПравилоКонвертацииОбъекта,
	|	Ссылка
	|ИЗ Справочник.ПравилаОбработкиДанных
	|ГДЕ Ссылка В (&ПОД) И ПравилоКонвертацииОбъекта <> &ПустаяСтрока
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИменаПКО.ПОД КАК ПОД,
	|	СоставЧужой.Владелец КАК Конвертация
	|ИЗ ИменаПКО КАК ИменаПКО
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПравилаКонвертацииОбъектов КАК ПравилаКонвертацииОбъектов
	|ПО ИменаПКО.ПКО = ПравилаКонвертацииОбъектов.Код
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоставыКонвертаций КАК Состав
	|ПО Состав.ЭлементКонвертации = ПравилаКонвертацииОбъектов.Ссылка
	|	И Состав.Владелец = &Конвертация
	|	И Состав.Отключить = ЛОЖЬ
	|ЛЕВОЕ СОЕДИНЕНИЕ  Справочник.СоставыКонвертаций КАК СоставЧужой
	|ПО Состав.ЭлементКонвертации = ПравилаКонвертацииОбъектов.Ссылка
	|	И Состав.Владелец <> &Конвертация
	|	И Состав.Отключить = ЛОЖЬ
	|ГДЕ СоставЧужой.Владелец IS NOT NULL
	|";
	Запрос.УстановитьПараметр("ПОД", ПОДЗагрузки);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	Запрос.УстановитьПараметр("Конвертация", ОбщиеПеременные.Конвертация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если РодственныеКонвертации.Получить(Выборка.Конвертация) Тогда
			Справочники.СоставыКонвертаций.ДополнитьСоставКонвертации(Выборка.Конвертация, Выборка.ПОД);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СписокВВидеСтроки(СписокЗначенийИсходный) 
	СтрокаПредставление = " ";
	Для Каждого ЭлементСписка Из СписокЗначенийИсходный Цикл
		СтрокаПредставление = СтрокаПредставление + СокрЛП(ЭлементСписка.Значение) + ",";
	КонецЦикла; 
	СтрокаПредставление = Лев(СтрокаПредставление, СтрДлина(СтрокаПредставление)-1);
	Возврат СтрокаПредставление;
КонецФункции

Процедура НайтиРасхожденияВПравилах(ОбщиеПеременные, ИмяСправочника, ИмяРеквизитаИдентификации, СписокРеквизитов, Уровень1, СписокРеквизитовОтправка = "", СписокРеквизитовПолучение = "")
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	Правила." + ИмяРеквизитаИдентификации + " КАК КлючПоиска
	|ПОМЕСТИТЬ ПравилаИсходные
	|ИЗ Справочник." + ИмяСправочника + " КАК Правила
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоставыКонвертаций КАК СоставВнутр
	|ПО Правила.Ссылка = СоставВнутр.ЭлементКОнвертации
	|	И СоставВнутр.Владелец = &Конвертация И СоставВнутр.Отключить = ЛОЖЬ И СоставВнутр.ПометкаУдаления = ЛОЖЬ
	|	И Правила.ВременнаяКопия = ЛОЖЬ И Правила.Копия = ЛОЖЬ
	|;
	|ВЫБРАТЬ
	|	Правила.Ссылка КАК Ссылка,
	|	Правила." + ИмяРеквизитаИдентификации + " КАК КлючПоиска
	|ПОМЕСТИТЬ ПравилаНовые
	|ИЗ Справочник." + ИмяСправочника + " КАК Правила
	|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СоставыКонвертаций КАК СоставВнутр
	|ПО Правила.Ссылка = СоставВнутр.ЭлементКОнвертации
	|	И СоставВнутр.Владелец = &Конвертация И СоставВнутр.Отключить = ЛОЖЬ И СоставВнутр.ПометкаУдаления = ЛОЖЬ
	|	И Правила.ВременнаяКопия = ИСТИНА
	|;
	|ВЫБРАТЬ
	|	ПравилаИсходные.Ссылка КАК Правило1,
	|	ПравилаНовые.Ссылка КАК Правило2
	|ИЗ ПравилаИсходные КАК ПравилаИсходные
	|ПОЛНОЕ СОЕДИНЕНИЕ ПравилаНовые КАК ПравилаНовые
	|ПО ПравилаИсходные.КлючПоиска = ПравилаНовые.КлючПоиска
	|";
	Запрос.УстановитьПараметр("Конвертация", ОбщиеПеременные.Конвертация); 
	Запрос.УстановитьПараметр("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);


	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Правило1) Или НЕ ЗначениеЗаполнено(Выборка.Правило2) Тогда
			Уровень1_строка = Уровень1.Добавить();
			Если ЗначениеЗаполнено(Выборка.Правило1) Тогда
				Уровень1_строка.Правило1 = Выборка.Правило1;
				Уровень1_строка.Правило2 = Справочники[ИмяСправочника].ПустаяСсылка();
				ДобавитьИнформациюОВхожденияхПравила(Уровень1_строка);
				ДобавитьИнформациюОЗахватеПравила(ОбщиеПеременные, Уровень1_строка, ИмяСправочника, ИмяРеквизитаИдентификации);
			Иначе
				Уровень1_строка.Правило1 = Справочники[ИмяСправочника].ПустаяСсылка();
				Уровень1_строка.Правило2 = Выборка.Правило2;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		РеквизитыПравила1 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выборка.Правило1, СписокРеквизитов);
		РеквизитыПравила2 = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выборка.Правило2, СписокРеквизитов); 
		ЕстьРасхождения = Ложь;
		МассивРеквизитов = СтрРазделить(СписокРеквизитов, ",", Ложь);
		Для Каждого Рекв Из МассивРеквизитов Цикл
			Если РеквизитыПравила1[СокрЛП(Рекв)] <> РеквизитыПравила2[СокрЛП(Рекв)] Тогда
				ИмяРеквИсключение = "#" + СокрЛП(Рекв) + "#";
				Если СписокРеквизитовОтправка <> "" И НЕ РеквизитыПравила1.ИспользоватьДляОтправки
					И СтрНайти(СписокРеквизитовОтправка, ИмяРеквИсключение) > 0 Тогда
					Продолжить;
				КонецЕсли; 
				Если СписокРеквизитовПолучение <> "" И НЕ РеквизитыПравила1.ИспользоватьДляПолучения
					И СтрНайти(СписокРеквизитовПолучение, ИмяРеквИсключение) > 0 Тогда
					Продолжить;
				КонецЕсли;
				ЕстьРасхождения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЕстьРасхождения = Ложь Тогда
			// Сравнение ТЧ.
			Если ИмяСправочника = "ПравилаОбработкиДанных" Тогда
				СравнитьТабличныеЧастиПОД(Выборка.Правило1, Выборка.Правило2, ЕстьРасхождения);
			ИначеЕсли ИмяСправочника = "ПравилаКонвертацииОбъектов" Тогда
				СравнитьТабличныеЧастиИПКС(Выборка.Правило1, Выборка.Правило2, ЕстьРасхождения); 
			ИначеЕсли ИмяСправочника = "ПравилаКонвертацииПредопределенныхДанных" Тогда
				СравнитьТабличныеЧастиПКПД(Выборка.Правило1, Выборка.Правило2, ЕстьРасхождения);
			КонецЕсли;
		КонецЕсли;
		Если ЕстьРасхождения = Ложь Тогда
			Продолжить;
		КонецЕсли;
		// Есть расхождения.
		Уровень1_строка = Уровень1.Добавить();
		Уровень1_строка.Правило1 = Выборка.Правило1;
		Уровень1_строка.Правило2 = Выборка.Правило2;  
		ДобавитьИнформациюОВхожденияхПравила(Уровень1_строка);
		ДобавитьИнформациюОЗахватеПравила(ОбщиеПеременные, Уровень1_строка, ИмяСправочника, ИмяРеквизитаИдентификации);
	КонецЦикла;

КонецПроцедуры

Процедура НайтиРасхожденияВПараметрахКонвертации(ОбщиеПеременные, Уровень1)
	Запрос = Новый Запрос; 
	Запрос.Текст = "ВЫБРАТЬ
	|	Правила.Параметр КАК КлючПоиска
	|ПОМЕСТИТЬ ПравилаИсходные
	|ИЗ Справочник.Конвертации.Параметры КАК Правила 
	|ГДЕ Правила.ВременнаяКопия = ЛОЖЬ И Правила.Ссылка = &Конвертация
	|;
	|ВЫБРАТЬ
	|	Правила.Параметр КАК КлючПоиска
	|ПОМЕСТИТЬ ПравилаНовые
	|ИЗ Справочник.Конвертации.Параметры КАК Правила 
	|ГДЕ Правила.ВременнаяКопия = ИСТИНА И Правила.Ссылка = &Конвертация
	|;
	|ВЫБРАТЬ
	|	ПравилаИсходные.КлючПоиска КАК Правило1,
	|	ПравилаНовые.КлючПоиска КАК Правило2
	|ИЗ ПравилаИсходные КАК ПравилаИсходные
	|ПОЛНОЕ СОЕДИНЕНИЕ ПравилаНовые КАК ПравилаНовые
	|ПО ПравилаИсходные.КлючПоиска = ПравилаНовые.КлючПоиска
	|";
	Запрос.УстановитьПараметр("Конвертация", ОбщиеПеременные.Конвертация); 
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если НЕ ЗначениеЗаполнено(Выборка.Правило1) Или НЕ ЗначениеЗаполнено(Выборка.Правило2) Тогда
			Уровень1_строка = Уровень1.Добавить();
			Если ЗначениеЗаполнено(Выборка.Правило1) Тогда
				Уровень1_строка.Правило1 = Выборка.Правило1;
				Уровень1_строка.Правило2 = "";
				Уровень1_строка.ПравилоРазделенное = Ложь;
				Уровень1_строка.ИнформацияЗагрузки = НСтр("ru='Правило обособленное'");
			Иначе
				Уровень1_строка.Правило1 = "";
				Уровень1_строка.Правило2 = Выборка.Правило2;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура СравнитьТабличныеЧастиПОД(Правило1, Правило2, ЕстьРасхождения)
	ТЧ1 = Правило1.ПравилаКонвертацииОбъектов.Выгрузить();
	ТЧ2 = Правило2.ПравилаКонвертацииОбъектов.Выгрузить();
	Если ТЧ1.Количество() <> ТЧ2.Количество() Тогда
		ЕстьРасхождения = Истина; 
		Возврат;
	ИначеЕсли ТЧ1.Количество() <> 0 Тогда
		Для Каждого СтрокаТЧ Из ТЧ1 Цикл
			Если ТЧ2.Найти(СтрокаТЧ.ПравилоКонвертацииОбъекта, "ПравилоКонвертацииОбъекта") = Неопределено Тогда
				ЕстьРасхождения = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаТЧ Из ТЧ2 Цикл
			Если ТЧ1.Найти(СтрокаТЧ.ПравилоКонвертацииОбъекта, "ПравилоКонвертацииОбъекта") = Неопределено Тогда
				ЕстьРасхождения = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура СравнитьТабличныеЧастиПКПД(Правило1, Правило2, ЕстьРасхождения)
	ТЧ1 = Правило1.СопоставлениеЗначений.Выгрузить();
	ТЧ2 = Правило2.СопоставлениеЗначений.Выгрузить();
	Если ТЧ1.Количество() <> ТЧ2.Количество() Тогда
		ЕстьРасхождения = Истина;
	ИначеЕсли ТЧ1.Количество() <> 0 Тогда
		Для Каждого СтрокаТЧ Из ТЧ1 Цикл
			СтрПоиска = Новый Структура("ЗначениеКонфигурации, ЗначениеФормата", СтрокаТЧ.ЗначениеКонфигурации, СтрокаТЧ.ЗначениеФормата);
			МасСтрТЧ2 = ТЧ2.НайтиСтроки(СтрПоиска);
			Если МасСтрТЧ2.Количество() = 0 Тогда
				ЕстьРасхождения = Истина;
				Возврат; 
			КонецЕсли;
		КонецЦикла; 
		Для Каждого СтрокаТЧ Из ТЧ2 Цикл
			СтрПоиска = Новый Структура("ЗначениеКонфигурации, ЗначениеФормата", СтрокаТЧ.ЗначениеКонфигурации, СтрокаТЧ.ЗначениеФормата);
			МасСтрТЧ1 = ТЧ1.НайтиСтроки(СтрПоиска);
			Если МасСтрТЧ1.Количество() = 0 Тогда
				ЕстьРасхождения = Истина;
				Возврат; 
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
КонецПроцедуры

Процедура СравнитьТабличныеЧастиИПКС(Правило1, Правило2, ЕстьРасхождения)
	ТЧ1 = Правило1.ИдентификацияПоПолямПоиска.Выгрузить();
	ТЧ2 = Правило2.ИдентификацияПоПолямПоиска.Выгрузить();
	Если ТЧ1.Количество() <> ТЧ2.Количество() Тогда
		ЕстьРасхождения = Истина;
		Возврат;
	ИначеЕсли ТЧ1.Количество() <> 0 Тогда
		Для НомСтр = 0 По ТЧ1.Количество()-1 Цикл 
			Если ТЧ1[НомСтр].РеквизитыПоиска <> ТЧ2[НомСтр].РеквизитыПоиска Тогда
				ЕстьРасхождения = Истина;
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли; 
	// Сравнение ПКС. 
	ИменаРеквизитовСтрокой = "
	|	ИспользуетсяАлгоритмКонвертации, 
	|	ПолноеИмяСвойстваКонфигурации, 
	|	ПолноеИмяСвойстваФормата,
	|	СвойствоКонфигурации,
	|	СвойствоКонфигурацииСтрокой,
	|	СвойствоФормата,
	|	ПравилоКонвертацииСвойства, 
	|	Поиск,";
	ИменаРеквизитовУникальные = "ИспользуетсяАлгоритмКонвертации,ПолноеИмяСвойстваКонфигурации,ПолноеИмяСвойстваФормата,ПравилоКонвертацииСвойства,Поиск,СвойствоКонфигурации,СвойствоКонфигурацииСтрокой,СвойствоФормата";
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ" + ИменаРеквизитовСтрокой + "
	|1 КАК КоличествоИсх,
	|0 КАК КоличествоНов
	|ИЗ Справочник.ПравилаКонвертацииСвойств КАК ПКСИсходные
	|ГДЕ Владелец = &Правило1 И НЕ ПометкаУдаления И ЭтоГруппа = ЛОЖЬ И Отключить = ЛОЖЬ
	|ОБЪЕДИНИТЬ ВСЕ
	|ВЫБРАТЬ " + ИменаРеквизитовСтрокой + "
	|0 КАК КоличествоИсх,
	|1 КАК КоличествоНов
	|ИЗ Справочник.ПравилаКонвертацииСвойств КАК ПКСНовые
	|ГДЕ Владелец = &Правило2 И НЕ ПометкаУдаления И ЭтоГруппа = ЛОЖЬ И Отключить = ЛОЖЬ
	|";  
	Запрос.УстановитьПараметр("Правило1", Правило1); 
	Запрос.УстановитьПараметр("Правило2", Правило2);

	ТабРезультат = Запрос.Выполнить().Выгрузить();
	
	Если ТабРезультат.Количество() > 0 Тогда
		Для Каждого СтрТаб Из ТабРезультат Цикл
			Если СтрТаб.ИспользуетсяАлгоритмКонвертации И ЗначениеЗаполнено(СтрТаб.СвойствоКонфигурации) Тогда
				СтрТаб.СвойствоКонфигурации = Справочники.Свойства.ПустаяСсылка();
			КонецЕсли; 
			Если СтрТаб.ИспользуетсяАлгоритмКонвертации И ЗначениеЗаполнено(СтрТаб.СвойствоКонфигурацииСтрокой) Тогда
				СтрТаб.СвойствоКонфигурацииСтрокой = "";
			КонецЕсли;
		КонецЦикла;
		ТабРезультат.Свернуть(ИменаРеквизитовУникальные, "КоличествоИсх, КоличествоНов");
		Для Каждого СтрТаб Из ТабРезультат Цикл
			Если СтрТаб.КоличествоИсх <> СтрТаб.КоличествоНов Тогда
				ЕстьРасхождения = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры


Процедура ДобавитьИнформациюОВхожденияхПравила(Уровень1_строка)
	СписокКонвертаций = Новый СписокЗначений;
	КонвертацияДанныхXDTOВызовСервера.ПолучитьВхожденияВКонвертацииДляЭлементаКонвертации(Уровень1_строка.Правило1, СписокКонвертаций);
	Если СписокКонвертаций.Количество() > 1 Тогда
		Уровень1_строка.ПравилоРазделенное = Истина;
		Уровень1_строка.ИнформацияЗагрузки = НСтр("ru='Правило общее:'") + СписокВВидеСтроки(СписокКонвертаций);
	Иначе 
		Уровень1_строка.ПравилоРазделенное = Ложь;
		Уровень1_строка.ИнформацияЗагрузки = НСтр("ru='Правило обособленное'");
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьИнформациюОЗахватеПравила(ОбщиеПеременные, Уровень1_строка, ИмяСправочника, ИмяРеквизитаИдентификации)
	Уровень1_строка.ПравилоЗахвачено = Ложь;
	Если НЕ ОбщиеПеременные.СовместнаяРабота Тогда
		Возврат;
	КонецЕсли; 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
		|	Правило.Ссылка КАК СсылкаПравило
		|ИЗ Справочник." + ИмяСправочника + " КАК Правило
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	Справочник.СоставыКонвертаций КАК Состав
		|ПО Состав.ЭлементКонвертации = Правило.Ссылка
		|	И Состав.Владелец = &Конвертация
		|	И Состав.Отключить = ЛОЖЬ
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|	РегистрСведений.СовместнаяРаботаСОбъектами.СрезПоследних(, Объект ССЫЛКА Справочник." + ИмяСправочника + "
		|				И Действие = ЗНАЧЕНИЕ(Перечисление.ДействияПриСовместнойРаботе.Захват)) КАК ДанныеЗахвата
		|ПО ДанныеЗахвата.РабочаяКопия = Правило.Ссылка
		|	И ДанныеЗахвата.Пользователь <> &ТекущийПользователь
		|ГДЕ Правило.ВременнаяКопия = ЛОЖЬ И Правило." + ИмяРеквизитаИдентификации + " = &Имя";
	Запрос.УстановитьПараметр("Конвертация", ОбщиеПеременные.Конвертация);
	Запрос.УстановитьПараметр("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("Имя", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Уровень1_строка.Правило1,ИмяРеквизитаИдентификации));
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		Уровень1_строка.ПравилоЗахвачено = Истина;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработатьСтроку_Удаление(СтрокаТЧ, ОбщиеПеременные)
	Если СтрокаТЧ.ПравилоРазделенное И СтрокаТЧ.РежимЗагрузки = 1 Тогда
		// Необходимо исключить из состава конвертации
		ИсключитьПравилоИзСоставаКонвертации(СтрокаТЧ.Правило1, ОбщиеПеременные);
		Возврат;
	КонецЕсли;
	Если ТипЗнч(СтрокаТЧ.Правило1) = Тип("Строка") Тогда
		// Это параметр.
		КонвертацияОбъект = ОбщиеПеременные.Конвертация.ПолучитьОбъект();
		СтрТЧ = КонвертацияОбъект.Параметры.Найти(СтрокаТЧ.Правило1, "Параметр");
		Если СтрТЧ = Неопределено Тогда
			Возврат;
		КонецЕсли;
		КонвертацияОбъект.Параметры.Удалить(СтрТЧ);
		КонвертацияОбъект.Записать();
		Возврат;
	КонецЕсли;
	ПравилоОбъект = СтрокаТЧ.Правило1.ПолучитьОбъект();
	ПравилоОбъект.ОбменДанными.Загрузка = Истина;
	ПравилоОбъект.УстановитьПометкуУдаления(Истина);
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставыКонвертаций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|ГДЕ
	|	СоставыКонвертаций.ЭлементКонвертации = &ЭлементКонвертации
	|	И СоставыКонвертаций.Владелец = &Конвертация
	|	И НЕ СоставыКонвертаций.ПометкаУдаления
	|	И НЕ СоставыКонвертаций.Отключить";
	Запрос.УстановитьПараметр("ЭлементКонвертации", СтрокаТЧ.Правило1);
	Запрос.УстановитьПараметр("Конвертация", ОбщиеПеременные.Конвертация);
    Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоставОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СоставОбъект.УстановитьПометкуУдаления(Истина);
	КонецЦикла;
КонецПроцедуры

Процедура ОбработатьСтроку_Изменение(Строка, ОбщиеПеременные)
	Если ТипЗнч(Строка.Правило2) = Тип("Строка") Тогда
		// Это параметр.
		КонвертацияОбъект = ОбщиеПеременные.Конвертация.ПолучитьОбъект();
		СтрТЧ = КонвертацияОбъект.Параметры.Найти(Строка.Правило2, "Параметр");
		Если СтрТЧ = Неопределено Тогда
			Возврат;
		КонецЕсли;
		СтрТЧ.ВременнаяКопия = Ложь;
		КонвертацияОбъект.Записать();
		Возврат;
	КонецЕсли;

	ПравилоНовое = Ложь;
	Если ЗначениеЗаполнено(Строка.Правило1) Тогда
		Если Строка.ПравилоРазделенное И Строка.РежимЗагрузки = 1 Тогда
			ИсключитьПравилоИзСоставаКонвертации(Строка.Правило1, ОбщиеПеременные);
			ПравилоНовое = Истина;
			ПравилоОбъект = Строка.Правило2.Скопировать();
		Иначе
			ПравилоОбъект = Строка.Правило1.ПолучитьОбъект();
		КонецЕсли;
	Иначе
		ПравилоНовое = Истина;
		ПравилоОбъект = Строка.Правило2.Скопировать(); 
		ПравилоОбъект.ВременнаяКопия = Ложь;
	КонецЕсли;
	ПравилоОбъект.ОбменДанными.Загрузка = Истина;
	Если ПравилоНовое Тогда
		ПравилоОбъект.Записать();
		Справочники.СоставыКонвертаций.ДополнитьСоставКонвертации(ОбщиеПеременные.Конвертация, ПравилоОбъект.Ссылка, Истина);
		Если ТипЗнч(Строка.Правило2) = Тип("СправочникСсылка.ПравилаКонвертацииОбъектов") Тогда
			СкопироватьПКС(ПравилоОбъект.Ссылка, Строка.Правило2);
		КонецЕсли;
	Иначе
		ИмяТЧ = "";
		Если ТипЗнч(Строка.Правило2) = Тип("СправочникСсылка.Алгоритмы") Тогда
			СписокКопируемыхСвойств = "Алгоритм, ИспользуетсяПриЗагрузке, Параметры, Экспортный, ЭтоФункция, Комментарий";
		ИначеЕсли ТипЗнч(Строка.Правило2) = Тип("СправочникСсылка.ПравилаОбработкиДанных") Тогда 
			СписокКопируемыхСвойств = "АлгоритмПриОбработке, АлгоритмВыборкаДанных, ИспользоватьДляОтправки, ИспользоватьДляПолучения, ОбъектВыборки, ОчисткаДанных, СпособВыборки, ПравилоКонвертацииОбъекта";
			ИмяТЧ = "ПравилаКонвертацииОбъектов";
		ИначеЕсли ТипЗнч(Строка.Правило2) = Тип("СправочникСсылка.ПравилаКонвертацииОбъектов") Тогда
			СписокКопируемыхСвойств = "АлгоритмПриОтправкеДанных, АлгоритмПередПолучениемДанных, АлгоритмПриПолученииДанных, АлгоритмПослеЗагрузкиВсехДанных," +
			"ВариантИдентификации, ИспользоватьДляОтправки, ИспользоватьДляПолучения, ОбъектКонфигурации, ОбъектСДвижениями, ОбъектФормата," +
			"ПравилоДляГруппыСправочника";
			СкопироватьПКС(Строка.Правило1, Строка.Правило2, Истина);
			ИмяТЧ = "ИдентификацияПоПолямПоиска";
		ИначеЕсли ТипЗнч(Строка.Правило2) = Тип("СправочникСсылка.ПравилаКонвертацииПредопределенныхДанных") Тогда
			СписокКопируемыхСвойств = "ОбъектКонфигурации, ОбъектФормата,ИспользоватьДляОтправки, ИспользоватьДляПолучения";
			ИмяТЧ = "СопоставлениеЗначений";
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ПравилоОбъект, Строка.Правило2, СписокКопируемыхСвойств);
		Если ИмяТЧ <> "" Тогда
			ПравилоОбъект[ИмяТЧ].Загрузить(Строка.Правило2[ИмяТЧ].Выгрузить());
		КонецЕсли;
		ПравилоОбъект.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура ИсключитьПравилоИзСоставаКонвертации(Правило, ОбщиеПеременные)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставыКонвертаций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СоставыКонвертаций КАК СоставыКонвертаций
	|ГДЕ
	|	СоставыКонвертаций.ЭлементКонвертации = &ЭлементКонвертации
	|	И СоставыКонвертаций.Владелец = &Конвертация
	|	И НЕ СоставыКонвертаций.ПометкаУдаления
	|	И НЕ СоставыКонвертаций.Отключить";
	Запрос.УстановитьПараметр("ЭлементКонвертации", Правило); 
	Запрос.УстановитьПараметр("Конвертация", ОбщиеПеременные.Конвертация);
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СоставОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СоставОбъект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
КонецПроцедуры

Процедура СкопироватьПКС(НовоеПравило, ИсходноеПравило, УдалятьСуществующие = Ложь)
	Если УдалятьСуществующие Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	Ссылка
		|ИЗ Справочник.ПравилаКонвертацииСвойств
		|ГДЕ Владелец = &Владелец"; 
		Запрос.УстановитьПараметр("Владелец", НовоеПравило); 
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПКСОбъект = Выборка.Ссылка.ПолучитьОбъект();
			ПКСОбъект.ОбменДанными.Загрузка = Истина;
			ПКСОбъект.Удалить();
		КонецЦикла;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Ссылка,
	|	Родитель,
	|	ЭтоГруппа
	|ИЗ Справочник.ПравилаКонвертацииСвойств
	|ГДЕ Владелец = &Владелец И НЕ ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", ИсходноеПравило);
	ТабПКС = Запрос.Выполнить().Выгрузить(); 
	СоответствиеГрупп = Новый Соответствие;
	Для НомерПрохода = 1 По 2 Цикл
		// В первый проход обрабатываются группы, во второй элементы.	
		Для Каждого СтрокаПКС Из ТабПКС Цикл
			Если НомерПрохода = 1 Тогда
				Если НЕ СтрокаПКС.ЭтоГруппа Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли НомерПрохода = 2 Тогда
				Если СтрокаПКС.ЭтоГруппа Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;

			// Для ПКО подчиненные ПКС копируются.
			ДубльПКС = СтрокаПКС.Ссылка.Скопировать();
			ДубльПКС.Владелец = НовоеПравило;
			Если ЗначениеЗаполнено(СтрокаПКС.Родитель) Тогда
				ДубльПКС.Родитель = СоответствиеГрупп.Получить(СтрокаПКС.Родитель);
			КонецЕсли;
			ДубльПКС.ОбменДанными.Загрузка = Истина;
			ДубльПКС.Записать();
			Если СтрокаПКС.ЭтоГруппа Тогда
				СоответствиеГрупп.Вставить(СтрокаПКС.Ссылка, ДубльПКС.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Функция НайтиСоздатьТег(ОбщиеПеременные, ТегСтрокой)
	Если ТегСтрокой = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТекТегСсылка = Справочники.Теги.НайтиПоНаименованию(ТегСтрокой,,,ОбщиеПеременные.КонфигурацияВладелец);
	Если ЗначениеЗаполнено(ТекТегСсылка) Тогда 
		Возврат ТекТегСсылка;
	КонецЕсли;
	ТекТегОбъект = Справочники.Теги.СоздатьЭлемент();
	ТекТегОбъект.Наименование = ТегСтрокой;
	ТекТегОбъект.Владелец = ОбщиеПеременные.КонфигурацияВладелец;
	ТекТегОбъект.ОбменДанными.загрузка = Истина; 
	ТекТегОбъект.Записать();
	Возврат ТекТегОбъект.Ссылка;
КонецФункции

Процедура ЗагрузитьТегиВПравиле(ТегиСтрокой, ПравилоОбъект, ОбщиеПеременные)
	Если ПустаяСтрока(СокрЛП(ТегиСтрокой)) Тогда
		Если ПравилоОбъект.Теги.Количество() > 0 Тогда
			ПравилоОбъект.Теги.Очистить();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	МассивТеговДляЗагрузки = Новый Массив;
	ТекущийТегМассив = СтрРазделить(ТегиСтрокой, ",");
	Для Каждого ТекТег Из ТекущийТегМассив Цикл
		ТекТегСсылка = НайтиСоздатьТег(ОбщиеПеременные, ТекТег);
		МассивТеговДляЗагрузки.Добавить(ТекТегСсылка);
	КонецЦикла;
	ПравилоОбъект.Теги.Очистить();
	Для Каждого ТекТегСсылка Из МассивТеговДляЗагрузки Цикл
		СтрокаТег = ПравилоОбъект.Теги.Добавить();
		СтрокаТег.Тег = ТекТегСсылка; 
	КонецЦикла;
КонецПроцедуры

Функция ПроверкаЗахвата(ОбщиеПеременные, ИмяПравила, ТекстЗапросаПроверкаЗахвата)
	Если НЕ ОбщиеПеременные.СовместнаяРабота Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ОбщиеПеременные.ИтерацияЗагрузки = 2 Тогда
		// при сравнении захваченные объекты не учитываются.
		Возврат Ложь;
	КонецЕсли;
	Если ОбщиеПеременные.СоздатьНовуюКонвертацию Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПроверкаЗахвата;
	Запрос.УстановитьПараметр("Имя", ИмяПравила);
	Запрос.УстановитьПараметр("Конвертация", ОбщиеПеременные.Конвертация);
	Запрос.УстановитьПараметр("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	Результат = Запрос.Выполнить();
	Возврат НЕ Результат.Пустой();
КонецФункции

Процедура УведомитьОЗахвате(ОбъектМД, ПредставлениеОбъекта)
	КомментВЖурнал = НСтр("ru='Невозможно загрузить %1%: захвачено другим пользователем'");
	КомментВЖурнал = СтрЗаменить(КомментВЖурнал, "%1%", ПредставлениеОбъекта);
	ЗаписьЖурналаРегистрации(НСтр("ru='Загрузка правил конвертации'"), УровеньЖурналаРегистрации.Информация, ОбъектМД, , КомментВЖурнал);
КонецПроцедуры

