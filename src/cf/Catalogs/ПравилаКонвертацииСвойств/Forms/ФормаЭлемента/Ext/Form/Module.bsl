&НаКлиенте
Процедура АлгоритмПриИзменении(Элемент)
	ОбновитьИндикациюОбработчиков();
КонецПроцедуры

#КонецОбласти
#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицыСвойств()
	ДанныеПКО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Владелец, "ОбъектКонфигурации, ОбъектФормата, ОбъектКонфигурацииКорреспондент");
	КонвертацияДанныхXDTOВызовСервера.ЗаполнитьСписокСвойствКонфигурации(ТаблицаСвойствКонфигурации,
			Объект.Владелец, 
			ДанныеПКО.ОбъектКонфигурации,
			Новый Структура("ЭтоГруппа, Родитель", Ложь, ГруппаСвойствКонфигурации));
	Если ЭтоКонвертацияXDTO Тогда
		ФильтрСвойствФормата = Новый Структура("ОбъектФормата, ЭтоГруппа, Родитель",  ДанныеПКО.ОбъектФормата, Ложь, ГруппаСвойствФормата);
		КонвертацияДанныхXDTOВызовСервера.ЗаполнитьСписокСвойствФормата(ТаблицаСвойствФормата,
				Объект.Владелец,
				ФильтрСвойствФормата);
	Иначе
		КонвертацияДанныхXDTOВызовСервера.ЗаполнитьСписокСвойствКонфигурации(ТаблицаСвойствКонфигурацииКорреспондент,
			Объект.Владелец, 
			ДанныеПКО.ОбъектКонфигурацииКорреспондент,
			Новый Структура("ЭтоГруппа, Родитель, Корреспондент", Ложь, ГруппаСвойствКонфигурацииКорреспондент, Истина));

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастроитьСпискиВыбораСвойств()
	// Для реквизитов ТЧ в списке выбора отсекается имя ТЧ
	ОтсекатьИмяТЧ = ЗначениеЗаполнено(Объект.Родитель);
	КонвертацияДанныхXDTOКлиент.ЗаполнитьСписокВыбораЭлементаФормы(Элементы.СвойствоКонфигурации, ТаблицаСвойствКонфигурации, Истина, ОтсекатьИмяТЧ);
	Если ЭтоКонвертацияXDTO Тогда
		КонвертацияДанныхXDTOКлиент.ЗаполнитьСписокВыбораЭлементаФормы(Элементы.СвойствоФормата, ТаблицаСвойствФормата, Истина, ОтсекатьИмяТЧ);
	Иначе
		КонвертацияДанныхXDTOКлиент.ЗаполнитьСписокВыбораЭлементаФормы(Элементы.СвойствоКонфигурацииКорреспондента, ТаблицаСвойствКонфигурацииКорреспондент, Истина, ОтсекатьИмяТЧ);
	КонецЕсли;
	ОбновитьОтображениеДанных();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПолноеИмяСвойстваФормата()
	Объект.ПолноеИмяСвойстваФормата = "";
	Если ЗначениеЗаполнено(ГруппаСвойствФормата)
		// Реквизиты общих табличных частей СвойствоФормата пишется полное имя с ТЧ.
		И СтрНайти(Объект.СвойствоФормата, ".") = 0 Тогда
		Объект.ПолноеИмяСвойстваФормата = СокрЛП(ГруппаСвойствФормата) + ".";
	КонецЕсли;
	Объект.ПолноеИмяСвойстваФормата = Объект.ПолноеИмяСвойстваФормата + СокрЛП(Объект.СвойствоФормата);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПолноеИмяСвойстваКонфигурации()
	Объект.ПолноеИмяСвойстваКонфигурации = "";
	Если ЗначениеЗаполнено(ГруппаСвойствКонфигурации) Тогда
		Объект.ПолноеИмяСвойстваКонфигурации = СокрЛП(ГруппаСвойствКонфигурации) + ".";
	КонецЕсли;
	Объект.ПолноеИмяСвойстваКонфигурации = Объект.ПолноеИмяСвойстваКонфигурации + СокрЛП(Объект.СвойствоКонфигурации);
КонецПроцедуры

&НаКлиенте
Процедура ВыбраноСвойствоФормата(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	Если НЕ ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		Возврат;
	КонецЕсли;
	СвойствоФорматаОбработкаВыбора(Элементы.СвойствоФормата, РезультатЗакрытия, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВыбраноСвойствоКонфигурации(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	Если НЕ ЗначениеЗаполнено(РезультатЗакрытия) Тогда
		Возврат;
	КонецЕсли;
	СвойствоКонфигурацииОбработкаВыбора(Элементы[ДополнительныеПараметры], РезультатЗакрытия, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТипСвойства(ТекСвойство, ТекГруппаСвойств, ТаблицаСвойств, ТипСвойства)
	ТипСвойства = "";
	Если НЕ ЗначениеЗаполнено(ТекСвойство) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ТекСвойство) = Тип("СправочникСсылка.Свойства") Тогда
		СтрРез = ТаблицаСвойств.НайтиСтроки(Новый Структура("Ссылка", ТекСвойство));
	Иначе
		Если НЕ ЗначениеЗаполнено(ТекГруппаСвойств)
			// Свойства общих ТЧ пишутся полностью через "."
			Или СтрНайти(ТекСвойство, ".") > 0 Тогда
			НаименованиеДляПоиска = ТекСвойство;
		Иначе
			// Свойства локальных ТЧ пишутся без имени ТЧ.
			НаименованиеДляПоиска = "" + ТекГруппаСвойств + "." + ТекСвойство;
		КонецЕсли;
		СтрРез = ТаблицаСвойств.НайтиСтроки(Новый Структура("Имя", НаименованиеДляПоиска));
	КонецЕсли;
	Если СтрРез.Количество() > 0 Тогда
		ТипСвойства = СтрРез[0].Тип;
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	Элементы.УказыватьПравилоКонвертацииСвойстваСтрокой.Видимость = ЭтоКонвертацияXDTO;
	Элементы.СвойствоФормата.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ТипСвойстваФормата.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ОбновитьТипСвойстваФормата.Видимость = ЭтоКонвертацияXDTO;
	Элементы.УказыватьСвойстваСтрокой.Видимость = ЭтоКонвертацияXDTO;

	
	Элементы.ПередаватьВПараметр.Видимость = НЕ ЭтоКонвертацияXDTO;
	Элементы.СвойствоКонфигурацииКорреспондента.Видимость = НЕ ЭтоКонвертацияXDTO И НЕ ПередаватьВПараметр;
	Элементы.ТипСвойстваКонфигурацииКорреспондента.Видимость = НЕ ЭтоКонвертацияXDTO И НЕ ПередаватьВПараметр;
	Элементы.ОбновитьТипСвойстваКонфигурацииКорреспондент.Видимость = НЕ ЭтоКонвертацияXDTO И НЕ ПередаватьВПараметр;
	Элементы.ИмяПараметраДляПередачи.Видимость = НЕ ЭтоКонвертацияXDTO И ПередаватьВПараметр; 
	
	Элементы.УказыватьПравилоКонвертацииСвойстваСтрокой.Видимость = ЭтоКонвертацияXDTO;
	Элементы.ИспользуетсяАлгоритмКонвертации.Видимость = ЭтоКонвертацияXDTO;
	
	Элементы.ГруппаXML.Видимость = НЕ ЭтоКонвертацияXDTO;
	Элементы.ПолучитьИзВходящихДанных.Видимость = НЕ ЭтоКонвертацияXDTO;
	Элементы.Поиск.Видимость = НЕ ЭтоКонвертацияXDTO;
	Элементы.ПоискПоДатеНаРавенство.Видимость = НЕ ЭтоКонвертацияXDTO;
	
	Если НЕ ЭтоКонвертацияXDTO Тогда
		Элементы.СвойствоКонфигурации.Заголовок = НСтр("ru='Источник'");
		Элементы.ТипСвойстваКонфигурации.Заголовок = НСтр("ru='Тип источника'");
		Если ПередаватьВПараметр И НЕ ЗначениеЗаполнено(Объект.СвойствоКонфигурации) Тогда
			Элементы.ПравилоКонвертацииСвойства.РежимВыбораИзСписка = Ложь;
		Иначе
			Элементы.ПравилоКонвертацииСвойства.РежимВыбораИзСписка = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Захват объекта.
	Если НЕ СовместнаяРабота Тогда
		Элементы.ДекорацияНуженЗахват.Видимость = Ложь;
		Элементы.ДекорацияЗахвачен.Видимость = Ложь; 
	Иначе
		Если НЕ Захвачен Тогда
			ТолькоПросмотр = Истина;
		КонецЕсли;
		Элементы.ДекорацияЗахвачен.Видимость = Захвачен;
		Элементы.ДекорацияНуженЗахват.Видимость = НЕ Захвачен;
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступность()
	Элементы.СвойствоКонфигурации.Доступность = НЕ Объект.ПолучитьИзВходящихДанных;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИндикациюОбработчиков()
	Если ЭтоКонвертацияXDTO Тогда
		Возврат;
	КонецЕсли;
	КонвертацияДанныхXDTOКлиент.ОбновитьИндикациюСтраницОбработчиков(Элементы.СтраницыОбработчики, Объект);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИменаОбработчиков()
	Если ЗначениеЗаполнено(Объект.СвойствоКонфигурации) Тогда
		ИмяСвойства = Объект.СвойствоКонфигурации;
	ИначеЕсли ЗначениеЗаполнено(Объект.СвойствоКонфигурацииКорреспондента)  Тогда
		ИмяСвойства = Объект.СвойствоКонфигурацииКорреспондента;
	Иначе
		ИмяСвойства = Объект.ИмяПараметраДляПередачи;
	КонецЕсли;
	Если ЗначениеЗаполнено(ГруппаСвойствКонфигурации) 
		Или ЗначениеЗаполнено(ГруппаСвойствКонфигурацииКорреспондент) Тогда
		ИмяРодителя = "_" + ?(ЗначениеЗаполнено(ГруппаСвойствКонфигурации), ГруппаСвойствКонфигурации, ГруппаСвойствКонфигурацииКорреспондент);
	Иначе
		ИмяРодителя = "";
	КонецЕсли;
	НачалоИмени = "ПКС_" + КодПКО + ИмяРодителя + "_" + ИмяСвойства + "_";
	ДлинаКода = СтрДлина(КодПКО);
	КодПКС = СокрЛП(Формат(Объект.Код, "ЧГ=0"));
	КонецИмени = "_" + КодПКС + "_" + ДлинаКода;
	ИмяОбработчикаПередВыгрузкой = НачалоИмени + "ПередВыгрузкойСвойства" + КонецИмени;
	ИмяОбработчикаПриВыгрузке = НачалоИмени + "ПриВыгрузкеСвойства" + КонецИмени;
	ИмяОбработчикаПослеВыгрузки = НачалоИмени + "ПослеВыгрузкиСвойства" + КонецИмени;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаименование()
	Если ЭтоКонвертацияXDTO Тогда
		// Заполнится при записи.
		Возврат;
	КонецЕсли;
	Если Объект.ЭтоГруппа Тогда
		Объект.Наименование = "" + СокрЛП(Объект.СвойствоКонфигурации) + " --> " + СокрЛП(Объект.СвойствоКонфигурацииКорреспондента);
	Иначе
		Объект.Наименование = "" + СокрЛП(Объект.СвойствоКонфигурации) + " --> " + ?(ПустаяСтрока(Объект.ИмяПараметраДляПередачи), СокрЛП(Объект.СвойствоКонфигурацииКорреспондента), Объект.ИмяПараметраДляПередачи);
	КонецЕсли; 
КонецПроцедуры

&НаСервере
Функция ПроверитьНеобходимостьЗаполненияПКО()
	ДанныеПКО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Владелец, "ИспользоватьДляОтправки, ИспользоватьДляПолучения, АлгоритмПриОтправкеДанных, АлгоритмПередПолучениемДанных"); 
	Если ЗначениеЗаполнено(Объект.СвойствоКонфигурации) И НЕ ЗначениеЗаполнено(Объект.ТипСвойстваКонфигурации) Тогда
		Если ТипЗнч(Объект.СвойствоКонфигурации) = Тип("СправочникСсылка.Свойства") Тогда
			Объект.ТипСвойстваКонфигурации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.СвойствоКонфигурации, "ТипыСтрокой");
		КонецЕсли;
	КонецЕсли;
	
	Если СтрНайти(Объект.ТипСвойстваКонфигурации, "Ссылка") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ДанныеПКО.ИспользоватьДляОтправки Тогда
		Если ЗначениеЗаполнено(ДанныеПКО.АлгоритмПриОтправкеДанных) И СтрНайти(ДанныеПКО.АлгоритмПриОтправкеДанных, Объект.СвойствоФормата) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	Если ДанныеПКО.ИспользоватьДляПолучения Тогда
		Если ЗначениеЗаполнено(ДанныеПКО.АлгоритмПередПолучениемДанных) И СтрНайти(ДанныеПКО.АлгоритмПередПолучениемДанных, Объект.СвойствоКонфигурации) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;	
КонецФункции

#КонецОбласти

