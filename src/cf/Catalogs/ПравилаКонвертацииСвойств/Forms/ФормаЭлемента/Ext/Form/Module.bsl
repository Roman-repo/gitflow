#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДанныеВладельца = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Владелец, "ТипКонвертации, Код, ВариантИдентификации, Захвачен, Ссылка, ОбъектКонфигурации, ОбъектКонфигурацииКорреспондент");
	Если НЕ ЗначениеЗаполнено(ДанныеВладельца.Ссылка) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Сначала следует записать правило конвертации объекта.'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	ОбъектКонфигурации = ДанныеВладельца.ОбъектКонфигурации;
	ОбъектКонфигурацииКорреспондент = ДанныеВладельца.ОбъектКонфигурацииКорреспондент;
	ГруппаСвойствКонфигурации = Справочники.Свойства.ПустаяСсылка();
	ГруппаСвойствКонфигурацииКорреспондент = Справочники.Свойства.ПустаяСсылка();
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда
		СведенияГруппыСвойств = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Родитель, "СвойствоКонфигурации, СвойствоФормата, СвойствоКонфигурацииКорреспондента");
		ГруппаСвойствКонфигурации 		= СведенияГруппыСвойств.СвойствоКонфигурации;
		ГруппаСвойствФормата 			= СведенияГруппыСвойств.СвойствоФормата;
		ГруппаСвойствКонфигурацииКорреспондент = СведенияГруппыСвойств.СвойствоКонфигурацииКорреспондента;
	КонецЕсли;
	ЭтоКонвертацияXDTO = (ДанныеВладельца.ТипКонвертации = Перечисления.ТипыКонвертаций.XDTO);
	КодПКО = ДанныеВладельца.Код;
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		СсылкаПоиск = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "Поиск");
	КонецЕсли;
	ИдентификацияПоУИД = (ДанныеВладельца.ВариантИдентификации = Перечисления.ВариантыИдентификацииОбъектов.ПоУникальномуИдентификатору);
	ПередаватьВПараметр = ЗначениеЗаполнено(Объект.ИмяПараметраДляПередачи);
	

	ЗаполнитьТаблицыСвойств();
	Захвачен = ДанныеВладельца.Захвачен;
	СовместнаяРабота = Константы.СовместнаяРабота.Получить();
	Если СовместнаяРабота Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			// Для нового объекта ставим захват по умолчанию.
			Захвачен = Истина;
		ИначеЕсли Захвачен И ЗначениеЗаполнено(Объект.Владелец) Тогда
			КонвертацияДанныхXDTOСервер.ПрочитатьСведенияОЗахватеОбъекта(Объект, ЭтотОбъект, Объект.Владелец);
		КонецЕсли;
	КонецЕсли;
	Если НЕ ТолькоПросмотр Тогда
		ОграничиватьДоступНаУровнеЗаписей = Константы.ОграничиватьДоступНаУровнеЗаписей.Получить();
		Если ОграничиватьДоступНаУровнеЗаписей Тогда
			СписокКонвертаций = Новый СписокЗначений;
			КонвертацияДанныхXDTOВызовСервера.ПолучитьВхожденияВКонвертацииДляЭлементаКонвертации(Объект.Владелец, СписокКонвертаций);
			КонвертацияДанныхXDTOСервер.ПроверитьДоступКОбъектуНаУровнеЗаписей(ЭтотОбъект, СписокКонвертаций);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимость();
	УстановитьДоступность();
	НастроитьСпискиВыбораСвойств();
	КонвертацияДанныхXDTOКлиент.ДобавитьТекущееЗначениеВСписокВыбораЭлементаФормы(Элементы.ПравилоКонвертацииСвойства, Объект.ПравилоКонвертацииСвойства);
	Если ЗначениеЗаполнено(Объект.СвойствоКонфигурацииСтрокой) Тогда
		УказыватьСвойстваСтрокой = Истина;
		УказыватьСвойстваСтрокойПриИзменении(Элементы.УказыватьСвойстваСтрокой);
	КонецЕсли;
	УказыватьПравилоКонвертацииСвойстваСтрокойПриИзменении(Элементы.УказыватьПравилоКонвертацииСвойстваСтрокой);
	ОбновитьИндикациюОбработчиков();
	ЗаполнитьИменаОбработчиков();
	ОбновитьОтображениеДанных();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ЗначениеЗаполнено(Объект.Ссылка) И СсылкаПоиск <> Объект.Поиск
		И НЕ ИдентификацияПоУИД Тогда
		Оповестить("ПКС_ИзмененПоиск", Объект.Владелец);
	КонецЕсли; 
	Если Объект.ПометкаУдаления Или НЕ ЭтоКонвертацияXDTO Или Объект.Проверено = Истина Или ЗначениеЗаполнено(Объект.ПравилоКонвертацииСвойства) Тогда
		Возврат;
	КонецЕсли;
	РезультатПроверки = ПроверитьНеобходимостьЗаполненияПКО();
	Если РезультатПроверки = Ложь Тогда
		Возврат;
	КонецЕсли; 
	Отказ = Истина;
	ОписОповещения = Новый ОписаниеОповещения("ПредупреждениеОПКОДляПКС", ЭтотОбъект);
	ТекстОповещения = НСтр("ru='Не заполнено правило конвертации свойства для данного ПКС. 
					|Заполните правило, либо убедитесь что правило определено алгоритмом конвертации'"); 
	КнопкиДиалога = Новый СписокЗначений;
	КнопкиДиалога.Добавить(КодВозвратаДиалога.ОК, НСтр("ru='Вернуться к редактированию'")); 
	КнопкиДиалога.Добавить(КодВозвратаДиалога.Пропустить, НСтр("ru='Записать правило и больше не показывать'"));
	
	ПоказатьВопрос(ОписОповещения, ТекстОповещения,КнопкиДиалога,,КодВозвратаДиалога.ОК);
КонецПроцедуры

&НаКлиенте
Процедура ПредупреждениеОПКОДляПКС(РезультатВопроса, ДопПараметры) Экспорт
	Если РезультатВопроса = КодВозвратаДиалога.Пропустить Тогда
		// записать значение Истина в реквизит Проверено.
		Объект.Проверено = Истина;  
		Записать();
	КонецЕсли;
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ПравилоКонвертацииСвойстваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Объект.СвойствоКонфигурации) И НЕ ЗначениеЗаполнено(Объект.ТипСвойстваКонфигурации) Тогда
		ОбновитьТипСвойстваКонфигурации("");
	КонецЕсли;
	Если ЭтоКонвертацияXDTO Тогда
		Если ЗначениеЗаполнено(Объект.СвойствоФормата) И НЕ ЗначениеЗаполнено(Объект.ТипСвойстваФормата) Тогда
			ОбновитьТипСвойстваФормата("");
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Объект.СвойствоКонфигурацииКорреспондента) 
		И НЕ ЗначениеЗаполнено(Объект.ТипСвойстваКонфигурацииКорреспондента) Тогда
		ОбновитьТипСвойстваКонфигурацииКорреспондент("");
	КонецЕсли;

	ПравилоКонвертацииСвойстваНачалоВыбораСервер(СтандартнаяОбработка);
КонецПроцедуры

&НаСервере
Процедура ПравилоКонвертацииСвойстваНачалоВыбораСервер(СтандартнаяОбработка)
	Элементы.ПравилоКонвертацииСвойства.СписокВыбора.Очистить();
	
	ТипСвойстваКонфигурации =  ОпределитьТипСвойства(Объект.ТипСвойстваКонфигурации, "СвойствоКонфигурации");
	ТипСвойстваКонфигурацииКорреспондент =  ОпределитьТипСвойства(Объект.ТипСвойстваКонфигурацииКорреспондента, "СвойствоКонфигурацииКорреспондента");
	ТипСвойстваФормата =  СокрЛП(Объект.ТипСвойстваФормата);
	
	СписокКонвертаций = Новый Массив;
	КонвертацияДанныхXDTOВызовСервера.ПолучитьВхожденияВКонвертацииДляЭлементаКонвертации(Объект.Владелец, СписокКонвертаций);
	
	ПКПД = Ложь;
	ПКО = Ложь;
	УчитыватьОбъектКонфигурации = Ложь;
	УчитыватьОбъектКонфигурацииКорреспондент = Ложь;
	УчитыватьОбъектФормата = Ложь;
	ТипСвойстваФорматаДляЗапроса = ТипСвойстваФормата;
	Если ЗначениеЗаполнено(ТипСвойстваКонфигурации) Тогда
		Для Каждого текТип Из ТипСвойстваКонфигурации Цикл
			Если Найти(НРег(текТип), НРег("ПеречислениеСсылка")) > 0 Тогда
				ПКПД = Истина;
			Иначе
				ПКО = Истина;
			КонецЕсли;
		КонецЦикла;
		УчитыватьОбъектКонфигурации = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТипСвойстваКонфигурацииКорреспондент) Тогда
		Для Каждого текТип Из ТипСвойстваКонфигурацииКорреспондент Цикл
			Если Найти(НРег(текТип), НРег("ПеречислениеСсылка")) > 0 Тогда
				ПКПД = Истина;
			Иначе
				ПКО = Истина;
			КонецЕсли;
		КонецЦикла;
		УчитыватьОбъектКонфигурацииКорреспондент = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(ТипСвойстваФормата) Тогда
		УчитыватьОбъектФормата = Истина;
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка
		|ИЗ Справочник.ЗначенияФормата
		|ГДЕ Владелец.Наименование = &ТипСвойстваФормата";
		Запрос.УстановитьПараметр("ТипСвойстваФормата", ТипСвойстваФормата);
		Результат = Запрос.Выполнить();
		УчитыватьОбъектФормата = Истина;
		Если Результат.Пустой() Тогда
			ПКО = Истина;
			Если Найти(ТипСвойстваФормата, "КлючевыеСвойства") > 0 Тогда
				Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				|Владелец.Наименование КАК ТипСвойстваФормата
				|ИЗ Справочник.СвойстваФормата
				|ГДЕ ВЫРАЗИТЬ(Тип КАК Строка(1000)) = &ТипСвойстваФормата И Наименование = ""КлючевыеСвойства""";
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					ТипСвойстваФорматаДляЗапроса = СокрЛП(Выборка.ТипСвойстваФормата);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ПКПД = Истина;
		КонецЕсли;
	КонецЕсли;
	Если НЕ УчитыватьОбъектКонфигурации И НЕ УчитыватьОбъектФормата И НЕ УчитыватьОбъектКонфигурацииКорреспондент Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ПустоеПКС = "";
	Если ПКПД Тогда
		// Ищем ПКПД
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПКПД.Код КАК Имя
		|ИЗ Справочник.ПравилаКонвертацииПредопределенныхДанных КАК ПКПД
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|		Справочник.СоставыКонвертаций КАК СоставКонвертации
		|	ПО ПКПД.Ссылка = СоставКонвертации.ЭлементКонвертации
		|		И СоставКонвертации.Владелец В (&МассивКонвертаций)
		|		И СоставКонвертации.Отключить = ЛОЖЬ
		|ГДЕ 
		|	(НЕ &УчитыватьОбъектКонфигурации ИЛИ ПКПД.ОбъектКонфигурации.Наименование В (&ОбъектКонфигурации))
		|	И (НЕ &УчитыватьОбъектКонфигурацииКорреспондент ИЛИ ПКПД.ОбъектКонфигурацииКорреспондент.Наименование В (&ОбъектКонфигурацииКорреспондент))
		|	И (ПКПД.ОбъектФормата = &ОбъектФормата ИЛИ НЕ &УчитыватьОбъектФормата)
		|	И (ПКПД.ИспользоватьДляОтправки = &ИспользоватьДляОтправки ИЛИ ПКПД.ИспользоватьДляПолучения = &ИспользоватьДляПолучения ИЛИ НЕ &УчитыватьНаправление)
		|	И НЕ ПКПД.ПометкаУдаления";
	КонецЕсли;
	Если ПКО Тогда
		Если ПКПД Тогда
			// несколько типов, объединяем запросы
			Запрос.Текст = Запрос.Текст + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ " + Символы.ПС;
		Иначе
			Запрос.Текст = "";
		КонецЕсли;
		// Ищем ПКО
		Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|ПКО.Код КАК Имя
		|ИЗ Справочник.ПравилаКонвертацииОбъектов КАК ПКО
		|ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|		Справочник.СоставыКонвертаций КАК СоставКонвертации
		|	ПО ПКО.Ссылка = СоставКонвертации.ЭлементКонвертации
		|		И СоставКонвертации.Владелец В (&МассивКонвертаций)
		|		И СоставКонвертации.Отключить = ЛОЖЬ
		|ГДЕ  
		|	(НЕ &УчитыватьОбъектКонфигурации ИЛИ ПКО.ОбъектКонфигурации.Наименование В (&ОбъектКонфигурации))
		|	И (НЕ &УчитыватьОбъектКонфигурацииКорреспондент ИЛИ ПКО.ОбъектКонфигурацииКорреспондент.Наименование В (&ОбъектКонфигурацииКорреспондент))
		|	И (ПКО.ОбъектФормата = &ОбъектФормата ИЛИ НЕ &УчитыватьОбъектФормата)
		|	И (ПКО.ИспользоватьДляОтправки = &ИспользоватьДляОтправки ИЛИ ПКО.ИспользоватьДляПолучения = &ИспользоватьДляПолучения ИЛИ НЕ &УчитыватьНаправление)";
	КонецЕсли;
	Запрос.УстановитьПараметр("МассивКонвертаций", СписокКонвертаций);
	Запрос.УстановитьПараметр("ИспользоватьДляОтправки", Объект.Владелец.ИспользоватьДляОтправки);
	Запрос.УстановитьПараметр("ИспользоватьДляПолучения", Объект.Владелец.ИспользоватьДляПолучения);
	Запрос.УстановитьПараметр("ОбъектКонфигурации", ТипСвойстваКонфигурации);
	Запрос.УстановитьПараметр("ОбъектКонфигурацииКорреспондент", ТипСвойстваКонфигурацииКорреспондент);
	Запрос.УстановитьПараметр("ОбъектФормата", ТипСвойстваФорматаДляЗапроса);
	Запрос.УстановитьПараметр("УчитыватьОбъектКонфигурации", УчитыватьОбъектКонфигурации);
	Запрос.УстановитьПараметр("УчитыватьОбъектКонфигурацииКорреспондент", УчитыватьОбъектКонфигурацииКорреспондент);
	Запрос.УстановитьПараметр("УчитыватьОбъектФормата", УчитыватьОбъектФормата);
	Запрос.УстановитьПараметр("УчитыватьНаправление", ЭтоКонвертацияXDTO);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		Пока Выборка.Следующий() Цикл
			Элементы.ПравилоКонвертацииСвойства.СписокВыбора.Добавить(Выборка.Имя);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОпределитьТипСвойства(ИмяТипа, ИмяСвойства)
	Типы = Новый Массив;
	Если СокрЛП(ИмяТипа) = "" Тогда
		Возврат Типы;
	ИначеЕсли СтрНайти(ИмяТипа, ",") = 0 Тогда
		Типы.Добавить(СокрЛП(ИмяТипа));
		Возврат Типы;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Тип.Наименование КАК Наименование
	|ИЗ Справочник.Свойства.Типы
	|ГДЕ Ссылка = &Свойство";
	Запрос.УстановитьПараметр("Свойство", Объект[ИмяСвойства]);
	Типы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование");
	Возврат Типы;
КонецФункции

&НаКлиенте
Процедура СвойствоФорматаОчистка(Элемент, СтандартнаяОбработка)
	Объект.СвойствоФормата = "";
	Объект.ТипСвойстваФормата = "";
КонецПроцедуры

&НаКлиенте
Процедура СвойствоКонфигурацииОчистка(Элемент, СтандартнаяОбработка)
	Объект[Элемент.Имя] = "";
	Если Элемент.Имя = "СвойствоКонфигурации" Тогда
		Объект.ТипСвойстваКонфигурации = "";
	Иначе
		Объект.ТипСвойстваКонфигурацииКорреспондента = "";
	КонецЕсли;
	ЗаполнитьНаименование();
	ЗаполнитьИменаОбработчиков();
КонецПроцедуры

&НаКлиенте
Процедура СвойствоФорматаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Если Текст = "" Тогда
		Объект.СвойствоФормата = "";
		Объект.ТипСвойстваФормата = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СвойствоКонфигурацииОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Объект[Элемент.Имя] = ВыбранноеЗначение.Ссылка;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Свойства") Тогда
		Объект[Элемент.Имя] = ВыбранноеЗначение;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("Строка") Тогда
		СтандартнаяОбработка = Ложь;
		Если Элемент.Имя = "СвойствоКонфигурации" Тогда
			Если НЕ ЗначениеЗаполнено(ГруппаСвойствКонфигурации)
				// Свойства общих ТЧ пишутся полностью через "."
				Или СтрНайти(ВыбранноеЗначение, ".") > 0 Тогда
				НаименованиеДляПоиска = ВыбранноеЗначение;
			Иначе
				// Свойства локальных ТЧ пишутся без имени ТЧ.
				НаименованиеДляПоиска = "" + ГруппаСвойствКонфигурации + "." + ВыбранноеЗначение;
			КонецЕсли;
			СтрПоискСсылки = ТаблицаСвойствКонфигурации.НайтиСтроки(Новый Структура("Имя", НаименованиеДляПоиска));
		Иначе
			Если НЕ ЗначениеЗаполнено(ГруппаСвойствКонфигурацииКорреспондент)
				// Свойства общих ТЧ пишутся полностью через "."
				Или СтрНайти(ВыбранноеЗначение, ".") > 0 Тогда
				НаименованиеДляПоиска = ВыбранноеЗначение;
			Иначе
				// Свойства локальных ТЧ пишутся без имени ТЧ.
				НаименованиеДляПоиска = "" + ГруппаСвойствКонфигурацииКорреспондент + "." + ВыбранноеЗначение;
			КонецЕсли;
			СтрПоискСсылки = ТаблицаСвойствКонфигурацииКорреспондент.НайтиСтроки(Новый Структура("Имя", НаименованиеДляПоиска));
		КонецЕсли;
		Если СтрПоискСсылки.Количество() > 0 Тогда
			Объект[Элемент.Имя] = СтрПоискСсылки[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьПолноеИмяСвойстваКонфигурации();
	Если Элемент.Имя = "СвойствоКонфигурации" Тогда
		ОбновитьТипСвойства(Объект.СвойствоКонфигурации, ГруппаСвойствКонфигурации, 
						ТаблицаСвойствКонфигурации, Объект.ТипСвойстваКонфигурации);
	Иначе
		ОбновитьТипСвойства(Объект.СвойствоКонфигурацииКорреспондента, ГруппаСвойствКонфигурацииКорреспондент, 
						ТаблицаСвойствКонфигурацииКорреспондент, Объект.ТипСвойстваКонфигурацииКорреспондента);

	КонецЕсли;
	ЗаполнитьНаименование();
	ЗаполнитьИменаОбработчиков();
КонецПроцедуры

&НаКлиенте
Процедура СвойствоФорматаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ПозТочки = Найти(ВыбранноеЗначение, ".");
	Если ПозТочки = 0 Тогда
		Объект.СвойствоФормата = ВыбранноеЗначение;
	Иначе
		Объект.СвойствоФормата = Сред(ВыбранноеЗначение, ПозТочки + 1);
	КонецЕсли;

	ЗаполнитьПолноеИмяСвойстваФормата();
	ОбновитьТипСвойства(Объект.СвойствоФормата, ГруппаСвойствФормата, 
						ТаблицаСвойствФормата, Объект.ТипСвойстваФормата);
КонецПроцедуры

&НаКлиенте
Процедура УказыватьПравилоКонвертацииСвойстваСтрокойПриИзменении(Элемент)
	Если УказыватьПравилоКонвертацииСвойстваСтрокой Тогда
		ТекСтраница = Элементы.СтраницаПКССтрокой;
	Иначе
		ТекСтраница = Элементы.СтраницаПКСВыбор;
	КонецЕсли;
	
	Элементы.ГруппаПравилаКонвертацииСвойств.ТекущаяСтраница = ТекСтраница;
КонецПроцедуры

&НаКлиенте
Процедура УказыватьСвойстваСтрокойПриИзменении(Элемент)
	Если УказыватьСвойстваСтрокой Тогда
		ТекСтраница = Элементы.СтраницаСопоставлениеСвойствВручную;
	Иначе
		ТекСтраница = Элементы.СтраницаСопоставлениеСвойствВыбор;
	КонецЕсли;
	
	Элементы.СтраницыСопоставлениеСвойств.ТекущаяСтраница = ТекСтраница;
КонецПроцедуры

&НаКлиенте
Процедура СвойствоКонфигурацииСтрокойПриИзменении(Элемент)
	ЗаполнитьПолноеИмяСвойстваКонфигурации();
КонецПроцедуры

&НаКлиенте
Процедура СвойствоФорматаСтрокойПриИзменении(Элемент)
	ЗаполнитьПолноеИмяСвойстваФормата();
КонецПроцедуры

&НаКлиенте
Процедура СвойствоФорматаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормыВыбора = Новый Структура("ТаблицаСвойствФормата, ТекущаяСтрока, РежимРаботы", 
					ТаблицаСвойствФормата, Объект.ПолноеИмяСвойстваФормата, "СвойствоФормата");
	ОткрытьФорму("ОбщаяФорма.ВыборОбъектаИлиСвойства",ПараметрыФормыВыбора,Элемент,,,,
			Новый ОписаниеОповещения("ВыбраноСвойствоФормата", ЭтотОбъект),РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры
		
&НаКлиенте
Процедура СвойствоКонфигурацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОповещениеОВыборе = Новый ОписаниеОповещения("ВыбраноСвойствоКонфигурации", ЭтотОбъект, Элемент.Имя);
	ПараметрыФормыВыбора = Новый Структура("РежимРаботы", "СвойствоКонфигурации");
	Если Элемент.Имя = "СвойствоКонфигурации" Тогда
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ?(ЗначениеЗаполнено(ГруппаСвойствКонфигурации),
					 "" + ГруппаСвойствКонфигурации + "." + Объект.СвойствоКонфигурации
					,Объект.СвойствоКонфигурации));
		ПараметрыФормыВыбора.Вставить("ТаблицаСвойствКонфигурации", ТаблицаСвойствКонфигурации);
	Иначе
		ПараметрыФормыВыбора.Вставить("ТекущаяСтрока", ?(ЗначениеЗаполнено(ГруппаСвойствКонфигурацииКорреспондент),
					 "" + ГруппаСвойствКонфигурацииКорреспондент + "." + Объект.СвойствоКонфигурацииКорреспондента
					,Объект.СвойствоКонфигурацииКорреспондента));
		ПараметрыФормыВыбора.Вставить("ТаблицаСвойствКонфигурации", ТаблицаСвойствКонфигурацииКорреспондент);
	КонецЕсли;
	ОткрытьФорму("ОбщаяФорма.ВыборОбъектаИлиСвойства",ПараметрыФормыВыбора,Элемент,,,,
			ОповещениеОВыборе,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры
		
&НаКлиенте
Процедура ПолучитьИзВходящихДанныхПриИзменении(Элемент)
	УстановитьДоступность();
КонецПроцедуры

&НаКлиенте
Процедура ПередаватьВПараметрПриИзменении(Элемент)
	Если ПередаватьВПараметр Тогда
		СвойствоКонфигурацииОчистка(Элементы.СвойствоКонфигурацииКорреспондента, Истина);
	Иначе
		Объект.ИмяПараметраДляПередачи = "";
	КонецЕсли;
	УстановитьВидимость();
КонецПроцедуры

&НаКлиенте
Процедура ИмяПараметраДляПередачиПриИзменении(Элемент)
	ЗаполнитьИменаОбработчиков();
КонецПроцедуры

#КонецОбласти

